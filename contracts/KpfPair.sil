pragma silverscript ^0.1.0;

// KpfPair: one perpetual position of size s between a long and a short, held in one UTXO with both margins
// (docs/DESIGN.md 3.1, 3.4, 4.2, 4.3).
//
// The pair is the price range [bl, bs] (bankruptcy prices, sompi per whole token of `scale` base units). With
// c(p) = min(max(p, bl), bs) the long is owed q(s, c(p) - bl) and the short q(s, bs - c(p)), q = quoteOf rounding
// down. Every pair output holds at least q(s, bs - bl) + carrier.
//
// Entries (M1, evidence-free):
//   amend(s, side, ask, minPart, tipRate)   P1  owner of `side` rewrites its own listing window
//   addMargin(s, side, delta)               P2  long lowers bl, short raises bs, by delta > 0
//   transfer(side, n, x, nb, ek, et, k)     P3  anyone fills the listing of `side` for n at x: an entrant (key ek,
//                                               tag et, new bound nb) replaces the leaver in a part of size n
//   closeHost(n, x, e3, k, bl3, lk3, la3, lm3, lt3, tl3)
//                                           P4  close-versus-close, the pair whose long listing is filled: its long
//                                               leaves, its short stays in P3 = (n, bl3, bs, entry e3) with the
//                                               donor's long
//   closeDonor(n, x, e3, c, bs3, sk3, sa3, sm3, st3)
//                                           P4  close-versus-close, the pair whose short listing is filled: its short
//                                               leaves, its long moves into the host's P3 = (n, bl, bs3, entry e3) at
//                                               output c
//   mutualClose(n, x)                       P4  both listings of this pair cross at x: n closes for both
//   idleSettle()                            P8  anyone, age >= idleDaa: settle all at entryPrice clamped to [bl, bs]
//   coopClose(sl, ss)                       P9  both owners sign; any split, the pair ends
// Entry on price evidence (DESIGN 3.3, 3.6, 4.4 evidence block, 4.5 T4, T6, T7), one entry for three paths:
//   onEvidence(nb, qb, path, s, side, ev, tk, x, nbd, ek, et, k), n = int(nb)
//     path 5  P5  the owner of `side` (signature s) closes n at the adverse bound: a long at a resting bid, a short
//                 at a resting ask (its custody at tk)
//     path 6  P6  anyone: the loser `side` is liquidatable at the evidence quote (a long at an ask, a short at a
//                 bid); n closes, the loser gets 0 and the winner the part less the keeper fee (DESIGN 4.5b)
//     path 7  P7  anyone: as P6, but the loser's n is sold at x to an entrant of its side (key ek, tag et, new
//                 bound nbd, part ordinal k; as P3 without a listing, x >= ask / x <= bid); the entrant's payment
//                 less the fee goes to the winner, the loser gets 0
//
// Evidence (DESIGN 3.3). Input ev is a plain resting KobAsk or KobBid of this market, authenticated as KobCondAsk
// authenticates its trigger evidence: template hash and P2SH of its redeem script, its signature script starting
// with the fixed 8-byte push of its fill n_ev > 0, its token covenant id and scale equal to this market's, not
// decaying (slope 0), interval >= 0, and exposed at its quote for minRestDaa DAA before this transaction:
// tx.daa >= max(UTXO DAA + interval, activeFrom, for an ask its custody's UTXO DAA, this pair's clock start S)
// + minRestDaa, tx.daa proven by CLTV, and fillable by conforming matchers for that whole window: expiryDaa, the
// IOC/FOK kill and the 90-day idle limit all at or after its end (DESIGN 4.5b, 4.5c; reviews 2 F2, 3 F1). An ask's
// custody tk is a holder UTXO of this market's token program (template hash tokenTplHash) owned by
// the ask's covenant id (scheme 0x04) with this market's extension commitment; a bid carries the commitment in
// its own state. The KobAsk and KobBid templates (hash, prefix and suffix length) are build constants.
//
// Evidence block (DESIGN 4.4). Every evidence entry starts its signature script with the two 8-byte pushes
// (n, q): this pair's part n and the first input q of the block of inputs [q, ev) that act on ev. Each pair of the
// block reads the first two pushes of every input of the block (at most 8, unrolled), requires each to name the
// same q and an n_j >= 0, and requires n_ev >= ceil(kBps * sum(n_j) / 10^4). A pair outside a block it names would
// read a member naming another q and fail, so one print never acts on more than n_ev * 10^4 / kBps in total.
//
// Every entry is the only input of its covenant id (OpCovInputCount(selfId) == 1) and reads only its own input,
// except that an evidence entry also reads its evidence (and an ask's custody) and the first two pushes of every
// input of its evidence block.
// A continuation is found by OpCovOutputIdx(selfId, k) and must equal this redeem script outside the bytes the
// entry may change (contSpk, pairSpk, restSpk). Party payouts use the injective slots of DESIGN 4.4: the first
// leaving party at output i (this input's index), a second at output M - 1 - i, which must be at least the input
// count.
//
// Splits (DESIGN 3.4 d, 4.6). A path that moves or closes a part n < s continues the pair into exactly two outputs
// of its id: the remainder (s - n, bl, bs, every other field as before) and one new part. Both parts are at least
// minSize. The departing part takes exactly q(n, bs - bl) (rounded down) out of this UTXO; the remainder keeps
// everything else: the old carrier, any value above the range floor, and the rounding slack. The carrier of the
// new part is therefore never paid from this pair: the taker funds it (the KpfOpen's per-fill carrier, or the
// executor's own input for a direct taker or a close-versus-close). When n = s the moved part inherits the old
// carrier and the excess instead, and a part that ends pays them to its leaving party (closeDonor) or to the
// short (mutualClose, as P8).
// DESIGN: 4.3 requires only "value >= q(s, BS - BL) + C on every pair output", which would let an executor fund
// the new part's carrier (and keep any excess) out of an over-funded pair; the remainder therefore keeps
// value - q(n, BS - BL). A payout below dust (4.6) "stays in the remainder"; with no remainder (n = s) it stays
// in the moved part.
//
// Tags live for one transaction (DESIGN 4.4). A tag names the input that handed its party over in the
// transaction that created the output; a claimer (a KpfOpen, or the donor of P4) accepts an output whose tag on
// its side is its own covenant id. No entry copies a tag: every pair output an entry creates carries tag 0 on both
// sides, except the side handed over in this transaction, which carries the tag the hand-over writes (the
// entrant's et in P3 and P7, the donor's id tl3 in the host's P3 of P4). So an output created by an entry that
// hands over no side, or the stayer's side of one that does, can never satisfy a claimer's check, and a tag that
// names an id still alive in a later transaction (the stale-tag alias of slice 1b) cannot exist. No entry reads
// its own tags, so a tag of any value (this pair's id, the token's id) blocks nothing (review 1, F1, F2).
//
// Entry price (DESIGN 4.5a). E changes only with the consent of both parties: P3 and P7 keep it in the part and
// in the remainder, P4 writes e3 with E(donor) <= e3 <= E(host) into P3 (each pair checks its own half), and
// every other continuation keeps it. P8 therefore settles an absent party at a price it consented to, or better.
//
// Evidence clock (DESIGN 4.5c, review 3 F1). The clock start S is `since` when it is non-zero, otherwise the DAA
// score of this pair's own UTXO. Evidence counts only from S: with exposed' = max(exposed, S) the order must have
// been fillable through exposed' + minRestDaa and the lock time must prove tx.daa >= exposed' + minRestDaa. The
// part that changes hands (the part of P3 and P7, P4's re-paired output) carries since = 0, so its clock starts
// at its own UTXO; every other pair output (P1, P2, every remainder) carries since = S. P3 and P4 require
// tx.daa >= S + 4 * minRestDaa (hand-overs are rate-limited); P7 is exempt.
// Health at entry (4.5c, F3, F4): the entrant of P3 must not be liquidatable at its entry price x, the entrant
// of P7 not at the evidence quote. Range (4.5c, F2): P6 and P7 require bl * (10^4 + mmrBps) < bs * (10^4 - mmrBps).
contract KpfPair(
    byte[32] ASK_TPL,
    int ASK_PRE,
    int ASK_SUF,
    byte[32] BID_TPL,
    int BID_PRE,
    int BID_SUF,
    byte[32] init_tokenCovId,
    byte[32] init_tokenTplHash,
    byte[32] init_extensionCommitment,
    int init_tplPrefixLen,
    int init_tplSuffixLen,
    int init_scale,
    int init_mmrBps,
    int init_kBps,
    int init_minRestDaa,
    int init_liqFeeBps,
    int init_keeperFeeMin,
    int init_minSize,
    int init_carrier,
    int init_idleDaa,
    int init_priceMax,
    int init_size,
    int init_bl,
    int init_bs,
    int init_entryPrice,
    pubkey init_longKey,
    pubkey init_shortKey,
    int init_longAsk,
    int init_longMin,
    int init_longTip,
    int init_shortBid,
    int init_shortMin,
    int init_shortTip,
    byte[32] init_tagL,
    byte[32] init_tagS,
    int init_since
) {
    // Market block (state [0..207)): identical in every pair and open order of one market.
    byte[32] tokenCovId = init_tokenCovId;
    byte[32] tokenTplHash = init_tokenTplHash;
    byte[32] extensionCommitment = init_extensionCommitment;
    int tplPrefixLen = init_tplPrefixLen;
    int tplSuffixLen = init_tplSuffixLen;
    int scale = init_scale;              // base units per whole token, 0 < scale <= 10^9
    int mmrBps = init_mmrBps;            // maintenance margin, 0 <= mmrBps < 5000 (P6, P7)
    int kBps = init_kBps;                // evidence multiple k = kBps / 10^4, 0 < kBps <= 10^5
    int minRestDaa = init_minRestDaa;    // evidence rest R, DAA
    int liqFeeBps = init_liqFeeBps;      // liquidation fee rate, 0 <= liqFeeBps <= 10^4
    int keeperFeeMin = init_keeperFeeMin; // liquidation fee floor, sompi
    int minSize = init_minSize;          // smallest part, base units
    int carrier = init_carrier;          // C, sompi on every pair output above its range
    int idleDaa = init_idleDaa;          // idle timeout of P8, DAA (CSV)
    int priceMax = init_priceMax;        // upper price bound, <= 10^14
    // Position (state [207..438)). Mutable fields are marked *.
    int size = init_size;                // * s, base units
    int bl = init_bl;                    // * long bankruptcy price
    int bs = init_bs;                    // * short bankruptcy price
    int entryPrice = init_entryPrice;    // * E, last consented price (P8 and display only)
    pubkey longKey = init_longKey;       // * long owner (x-only)
    pubkey shortKey = init_shortKey;     // * short owner (x-only)
    int longAsk = init_longAsk;          // * long listing: sell at >= longAsk (0 = unlisted)
    int longMin = init_longMin;          // * smallest part of the long listing
    int longTip = init_longTip;          // * tip per whole token the long gives a filler
    int shortBid = init_shortBid;        // * short listing: buy back at <= shortBid (0 = unlisted)
    int shortMin = init_shortMin;        // *
    int shortTip = init_shortTip;        // *
    byte[32] tagL = init_tagL;           // * covenant id of the input that handed the long over in the transaction
                                         //   that created this UTXO (0 if none); read only by that claimer
    byte[32] tagS = init_tagS;           // * as tagL for the short
    int since = init_since;              // * evidence clock start (0: this UTXO's DAA score), DESIGN 4.5c

    byte constant SIGHASH_ALL = 0x01;
    int constant SIDE_LONG = 1;
    int constant SIDE_SHORT = 2;
    // DESIGN 5 bounds. scale <= 10^9 keeps (n mod scale) * (r mod scale) < 10^18; priceMax <= 10^14 keeps the
    // later trigger products a * 10^4 within 10^18.
    int constant SCALE_MAX = 1000000000;
    int constant PRICE_CAP = 100000000000000;
    int constant INT_MAX = 9223372036854775807;
    // A plain payout below 0.02 KAS is not created (DESIGN 4.6); its value goes to the other party.
    int constant PLAIN_DUST = 2000000;
    // Redeem-script offsets. The state starts at byte 1 (one prefix byte, checked by the tests against the
    // compiled artifact). Payload windows: bl [218..226), bs [227..235); the two listing windows with their push
    // opcodes [310..364), the long's [310..337) and the short's [337..364).
    int constant BL_AT = 218;
    int constant BS_AT = 227;
    int constant LISTS_AT = 310;
    int constant LISTS_END = 364;
    int constant LIST_LEN = 27;
    // size payload [209..217); the tag window ends at 430, the since push is [430..439) and the whole position
    // state ends at 439.
    int constant SIZE_AT = 209;
    int constant STATE_END = 439;
    // An empty listing window (ask, minPart, tip all zero) with its push opcodes.
    byte[27] constant NO_LIST = byte[27](0x080000000000000000080000000000000000080000000000000000);
    // Evidence (KobCondAsk.touch): state lengths of KobAsk and KobBid, the largest evidence block, basis points.
    int constant ASK_STATE_LEN = 276;
    int constant BID_STATE_LEN = 285;
    int constant BPS = 10000;
    int constant K_MAX = 100000;
    int constant MMR_CAP = 5000;
    // KobAsk and KobBid soft expiry (review 2, F2): the IOC/FOK kill and the 90-day idle limit, as in their source.
    int constant IOC_LIFE = 600;
    int constant MAX_IDLE = 77760000;

    // Quote value of n base units at rate r (sompi per whole token). c = 0 rounds down, c = scale - 1 rounds up.
    // As KobCondAsk.quoteOf: the product n * r is never formed.
    function quoteOf(int n, int r, int c) : int {
        int m = n % scale;
        int q = n / scale;
        return q * r + m * (r / scale) + (m * (r % scale) + c) / scale;
    }

    // DESIGN 5, checked at every entry: the market bounds and 0 <= bl < bs <= priceMax, size > 0.
    //
    // The size bound. With W = floor(size / scale) and any r <= priceMax, q(n, r) <= (W + 1) * r for every
    // n <= size (the two low terms add up to at most floor(((scale - 1) * r + scale - 1) / scale) <= r), so
    // W <= (INT_MAX - carrier) / priceMax - 1 keeps q(n, r) + carrier inside 63 bits on every path, and the low
    // products stay below scale^2 <= 10^18. A size above the bound is refused here instead of overflowing later.
    // DESIGN: 4.2 has no maxSize field and 5 states the bound only as "<= 9.2 * 10^4 whole tokens at r = 10^14";
    // the bound is derived from the pair's own priceMax and carrier instead (92,232 whole tokens at 10^14, 0.2 KAS).
    function checkPair() {
        require(scale > 0);
        require(scale <= SCALE_MAX);
        require(priceMax > 0);
        require(priceMax <= PRICE_CAP);
        require(carrier >= 0);
        require(size > 0);
        require(size / scale <= (INT_MAX - carrier) / priceMax - 1);
        require(bl >= 0);
        require(bl < bs);
        require(bs <= priceMax);
    }

    // The value every pair output with range [b0, b1] must hold.
    function floorOf(int b0, int b1) : int {
        return quoteOf(size, b1 - b0, 0) + carrier;
    }

    // A 65-byte Schnorr signature with SIGHASH_ALL by k, so the signer commits to every output.
    function signedBy(sig s, pubkey k) {
        byte[] sb = byte[](s);
        require(sb.length == 65);
        require(sb[64] == SIGHASH_ALL);
        require(checkSig(s, k));
    }

    // This input's redeem script (the last push of its signature script).
    function ownRs() : byte[] {
        int self = this.activeInputIndex;
        int len = OpTxInputScriptSigLen(self);
        return OpTxInputScriptSigSubstr(self, len - this.bytecodeSize, len);
    }

    // Both tags zero with their push opcodes: the tag window [364..430) of a continuation that hands over no side.
    // Built from an 8-byte zero (OP_NUM2BIN) rather than a 66-byte constant, which would be inlined at every use.
    function noTags() : byte[] {
        byte[] z = byte[](zero32());
        return byte[](0x20) + z + byte[](0x20) + z;
    }

    // A 32-byte zero (a cleared tag), built the same way.
    function zero32() : byte[32] {
        byte[] z8 = byte[](0 as byte[8]);
        return byte[32](z8 + z8 + z8 + z8);
    }

    // The since window [430..439) with its push opcode.
    function sinceWin(int c) : byte[] {
        return byte[](0x08) + byte[](c as byte[8]);
    }

    // The evidence clock start S (DESIGN 4.5c): since when non-zero, else the DAA score of this UTXO.
    // DESIGN: 4.5c does not bound S. A negative value (a hand-built since, or a UTXO whose DAA score the engine does not
    // know yet: a mempool spend of an unaccepted parent reads u64::MAX, i.e. -1) is refused, so no output is ever written
    // with a clock that consensus and a mempool would read differently.
    function clockStart() : int {
        int c = since;
        if (c == 0) { c = OpTxInputDaaScore(this.activeInputIndex); }
        require(c >= 0);
        return c;
    }

    // The hand-over rate limit of P3 and P4 (DESIGN 4.5c): tx.daa >= S + 4 * minRestDaa, proven by CLTV.
    function handOverLimit(int c) {
        require(tx.daa >= c + 4 * minRestDaa);
    }

    // P2SH of this script with bl, bs and the two listing windows (54 bytes with their push opcodes) replaced,
    // both tags zero and since = c. Every other byte, the market block, size, entryPrice and both keys included,
    // is copied.
    function contSpk(byte[] rs, int newBl, int newBs, byte[] lists, int c) : byte[] {
        return byte[](new ScriptPubKeyP2SHFromRedeemScript(
            rs.slice(0, BL_AT) + byte[](newBl as byte[8]) + rs.slice(BL_AT + 8, BS_AT) + byte[](newBs as byte[8])
                + rs.slice(BS_AT + 8, LISTS_AT) + lists + noTags() + sinceWin(c) + rs.slice(STATE_END, this.bytecodeSize)
        ));
    }

    // P2SH of a KpfPair with this script's template and market block and the given position: size, range, entry,
    // keys, both listing windows (54 bytes with their push opcodes) and tags, and since = 0. Used only for an
    // output whose side changes hands (P3 and P7 parts, P4's re-paired output), whose clock restarts.
    function pairSpk(byte[] rs, int sz, int b0, int b1, int e, byte[32] lk, byte[32] sk, byte[] lists, byte[32] tl, byte[32] ts) : byte[] {
        return byte[](new ScriptPubKeyP2SHFromRedeemScript(
            rs.slice(0, SIZE_AT) + byte[](sz as byte[8]) + byte[](0x08) + byte[](b0 as byte[8]) + byte[](0x08)
                + byte[](b1 as byte[8]) + byte[](0x08) + byte[](e as byte[8]) + byte[](0x20) + byte[](lk) + byte[](0x20)
                + byte[](sk) + lists + byte[](0x20) + byte[](tl) + byte[](0x20) + byte[](ts) + sinceWin(0)
                + rs.slice(STATE_END, this.bytecodeSize)
        ));
    }

    // P2SH of the remainder: this script with the size replaced, both tags zero and since = c (the entry price,
    // keys and listings are kept).
    function restSpk(byte[] rs, int sz, int c) : byte[] {
        return byte[](new ScriptPubKeyP2SHFromRedeemScript(
            rs.slice(0, SIZE_AT) + byte[](sz as byte[8]) + rs.slice(SIZE_AT + 8, LISTS_END) + noTags() + sinceWin(c)
                + rs.slice(STATE_END, this.bytecodeSize)
        ));
    }

    // A listing window (ask, minPart, tip) with its push opcodes.
    function win(int a, int m, int t) : byte[] {
        return byte[](0x08) + byte[](a as byte[8]) + byte[](0x08) + byte[](m as byte[8]) + byte[](0x08) + byte[](t as byte[8]);
    }

    // A part n of this pair (DESIGN 4.6): 0 < n <= s, n >= minSize, and s - n is 0 or at least minSize.
    function checkPart(int n) {
        require(n > 0);
        require(n <= size);
        require(n >= minSize);
        int rest = size - n;
        require(rest == 0 || rest >= minSize);
    }

    // What a leaver of n is owed at a price distance r (x - bl for a long, bs - x for a short) less its tip rate t:
    // q(n, r) - q(n, t), each rounded down, never below 0. A price beyond the leaver's bankruptcy price owes 0 and a
    // tip above r is capped at r, so no product is formed with a rate outside [0, priceMax].
    // DESIGN: 4.5 writes the requirement as q(n, X - BL) - q(n, tip), which is negative (and its product unbounded
    // for a hand-set tip) when X < BL or tip > X - BL; it is read as max(0, ...).
    function owed(int n, int r, int t) : int {
        int rr = r;
        if (rr < 0) { rr = 0; }
        int tt = t;
        if (tt > rr) { tt = rr; }
        if (tt < 0) { tt = 0; }
        return quoteOf(n, rr, 0) - quoteOf(n, tt, 0);
    }

    // A plain payout of at least v to k at output j; nothing when v is 0.
    function payTo(int j, pubkey k, int v) {
        if (v > 0) {
            require(tx.outputs[j].scriptPubKey == byte[](new ScriptPubKeyP2PK(k)));
            require(tx.outputs[j].value >= v);
        }
    }

    // The continuations of a part n moved into a new position (P3, and the host of P4). With n = s the part is the
    // only output of this id and inherits keep (the old carrier and the excess); with n < s the part is ordinal k
    // of two, it carries a new carrier, and the remainder (ordinal 1 - k) keeps keep and the range floor.
    function partAndRest(byte[32] selfId, byte[] rs, int n, int k, byte[] partSpk, int partRange, int keep, int clk) {
        if (n == size) {
            require(OpCovOutputCount(selfId) == 1);
            int c = OpCovOutputIdx(selfId, 0);
            require(tx.outputs[c].scriptPubKey == partSpk);
            require(tx.outputs[c].value >= partRange + carrier);
            require(tx.outputs[c].value >= partRange + keep);
        } else {
            require(OpCovOutputCount(selfId) == 2);
            require(k == 0 || k == 1);
            int c0 = OpCovOutputIdx(selfId, k);
            require(tx.outputs[c0].scriptPubKey == partSpk);
            require(tx.outputs[c0].value >= partRange + carrier);
            int c1 = OpCovOutputIdx(selfId, 1 - k);
            int rest = size - n;
            require(tx.outputs[c1].scriptPubKey == restSpk(rs, rest, clk));
            require(tx.outputs[c1].value >= quoteOf(rest, bs - bl, 0) + carrier);
            require(tx.outputs[c1].value >= keep);
        }
    }

    // P1 amend. The owner of `side` sets its own listing window (ask or bid, smallest part, tip). The other
    // window and every other field stay, except that both tags are cleared. The continuation keeps at least this UTXO's value (an amend moves no
    // value) and its range floor. A new UTXO resets the age that P8 measures.
    // DESIGN: "value >= old value" is not in 4.3; without it one owner's amend could move any value above the
    // range floor (which P8 would give to the short) to the signer's own outputs.
    entry amend(sig s, int side, int ask, int minPart, int tipRate) {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        require(OpCovInputCount(selfId) == 1);
        checkPair();
        require(ask >= 0);
        require(ask <= priceMax);
        require(minPart >= 0);
        require(tipRate >= 0);
        byte[] rs = ownRs();
        byte[] win = byte[](0x08) + byte[](ask as byte[8]) + byte[](0x08) + byte[](minPart as byte[8]) + byte[](0x08)
            + byte[](tipRate as byte[8]);
        byte[] lists = rs.slice(LISTS_AT, LISTS_AT + LIST_LEN) + win;
        if (side == SIDE_LONG) {
            signedBy(s, longKey);
            lists = win + rs.slice(LISTS_AT + LIST_LEN, LISTS_END);
        } else {
            require(side == SIDE_SHORT);
            signedBy(s, shortKey);
        }
        require(OpCovOutputCount(selfId) == 1);
        int c = OpCovOutputIdx(selfId, 0);
        require(tx.outputs[c].scriptPubKey == contSpk(rs, bl, bs, lists, clockStart()));
        require(tx.outputs[c].value >= tx.inputs[self].value);
        require(tx.outputs[c].value >= floorOf(bl, bs));
    }

    // P2 add margin. The long lowers bl, the short raises bs, by delta > 0. The continuation's value grows by at
    // least ceil(q(s, delta)) and covers the new range. Written as a difference, so it cannot overflow.
    entry addMargin(sig s, int side, int delta) {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        require(OpCovInputCount(selfId) == 1);
        checkPair();
        require(delta > 0);
        int nbl = bl;
        int nbs = bs;
        if (side == SIDE_LONG) {
            signedBy(s, longKey);
            nbl = bl - delta;
        } else {
            require(side == SIDE_SHORT);
            signedBy(s, shortKey);
            nbs = bs + delta;
        }
        require(nbl >= 0);
        require(nbl < nbs);
        require(nbs <= priceMax);
        byte[] rs = ownRs();
        require(OpCovOutputCount(selfId) == 1);
        int c = OpCovOutputIdx(selfId, 0);
        require(tx.outputs[c].scriptPubKey == contSpk(rs, nbl, nbs, rs.slice(LISTS_AT, LISTS_END), clockStart()));
        require(tx.outputs[c].value - tx.inputs[self].value >= quoteOf(size, delta, scale - 1));
        require(tx.outputs[c].value >= floorOf(nbl, nbs));
    }

    // P3 transfer (DESIGN 3.4 b, 4.5 T2). Anyone fills the listing of `side` for n base units at price x. The long
    // leaver is paid q(n, x - bl) - q(n, longTip) at output i (the short: q(n, bs - x) - q(n, shortTip)); a payout
    // below dust is not created and stays in the pair. An entrant with key ek, tag et and new bound nb takes the
    // leaver's place in a part of size n with the pair's entry price kept and its side unlisted, so the leaver's
    // listing is never replayed on the entrant. The stayer's key, bound and listing are copied, its tag cleared,
    // and no-downgrade holds: nb <= bl for a staying short, nb >= bs for a staying long, so the stayer's payoff does
    // not fall at any price.
    // The entrant is a KpfOpen of the same side (et = its covenant id; it checks its own rate, limit and claim) or a
    // direct taker (any et; 0 by convention) who funds the part from its own signed input. This pair checks
    // neither: only the entrant's own funds depend on them. The remainder keeps the leaver, its listing and the
    // entry, with both tags cleared.
    entry transfer(int side, int n, int x, int nb, byte[32] ek, byte[32] et, int k) {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        require(OpCovInputCount(selfId) == 1);
        checkPair();
        checkPart(n);
        require(x >= 0);
        require(x <= priceMax);
        int pay = 0;
        if (side == SIDE_LONG) {
            require(longAsk > 0);
            require(x >= longAsk);
            require(n >= longMin || n == size);
            pay = owed(n, x - bl, longTip);
        } else {
            require(side == SIDE_SHORT);
            require(shortBid > 0);
            require(x <= shortBid);
            require(n >= shortMin || n == size);
            pay = owed(n, bs - x, shortTip);
        }
        int clk = clockStart();
        handOverLimit(clk);
        handOver(side, n, nb, ek, et, k, pay, side, x, clk);
    }

    // The hand-over of P3 and P7: the party `payee` (the leaver `side` in P3, the stayer in P7) is paid `pay` at
    // output i (a payout below dust stays in the pair), and an entrant with key ek, tag et and new bound nb takes
    // the leaver's place in a part of size n with the entry price kept, its side unlisted and since = 0; the
    // stayer's tag is cleared and the remainder keeps the clock clk. No-downgrade: nb <= bl for a staying short,
    // nb >= bs for a staying long. Health at entry (DESIGN 4.5c): the entrant is not liquidatable at the price hp,
    // a long hp * (10^4 - mmrBps) >= nb * 10^4, a short nb * 10^4 >= hp * (10^4 + mmrBps).
    function handOver(int side, int n, int nb, byte[32] ek, byte[32] et, int k, int pay, int payee, int hp, int clk) {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        byte[] rs = ownRs();
        byte[32] lk = byte[32](longKey);
        byte[32] sk = byte[32](shortKey);
        byte[] lw = rs.slice(LISTS_AT, LISTS_AT + LIST_LEN);
        byte[] sw = rs.slice(LISTS_AT + LIST_LEN, LISTS_END);
        byte[32] tl = zero32();
        byte[32] ts = tl;
        int b0 = bl;
        int b1 = bs;
        pubkey payKey = longKey;
        if (side == SIDE_LONG) {
            require(nb >= 0);
            require(nb <= bl);
            require(hp * (BPS - mmrBps) >= nb * BPS);
            b0 = nb;
            lk = ek;
            lw = byte[](NO_LIST);
            tl = et;
        } else {
            require(side == SIDE_SHORT);
            require(nb >= bs);
            require(nb <= priceMax);
            require(nb * BPS >= hp * (BPS + mmrBps));
            b1 = nb;
            sk = ek;
            sw = byte[](NO_LIST);
            ts = et;
            payKey = shortKey;
        }
        if (payee != side) {
            payKey = longKey;
            if (side == SIDE_LONG) { payKey = shortKey; }
        }
        int p = pay;
        int keep = tx.inputs[self].value - quoteOf(n, bs - bl, 0);
        if (p < PLAIN_DUST) {
            keep = keep + p;
            p = 0;
        }
        payTo(self, payKey, p);
        partAndRest(selfId, rs, n, k, pairSpk(rs, n, b0, b1, entryPrice, lk, sk, lw + sw, tl, ts), quoteOf(n, b1 - b0, 0), keep, clk);
    }

    // P4 close-versus-close, host side (DESIGN 3.4 c, 4.5 T3). This pair's long listing is filled for n at x: the
    // long leaves with q(n, x - bl) - q(n, longTip) at output i, and the short stays in P3, a continuation of this
    // id with (n, bl3, bs, entry e3) whose long is the donor pair's staying long: key lk3, listing (la3, lm3, lt3)
    // and tag tl3 (the donor's covenant id); the short's tag is cleared. For the staying short: no-downgrade
    // bl3 <= bl, and e3 <= this pair's entry, so its idle payoff does not fall (DESIGN 4.5a). The donor checks its
    // own long's side of P3 (bl3, lk3, its listing, the tag, bs >= its bs, e3 >= its entry); this pair reads none
    // of its state. With E(donor) > E(host) no e3 satisfies both, and the two pairs cannot be re-paired.
    entry closeHost(int n, int x, int e3, int k, int bl3, byte[32] lk3, int la3, int lm3, int lt3, byte[32] tl3) {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        require(OpCovInputCount(selfId) == 1);
        checkPair();
        checkPart(n);
        require(x >= 0);
        require(x <= priceMax);
        require(longAsk > 0);
        require(x >= longAsk);
        require(n >= longMin || n == size);
        require(bl3 >= 0);
        require(bl3 <= bl);
        require(e3 <= entryPrice);
        int clk = clockStart();
        handOverLimit(clk);
        byte[] rs = ownRs();
        int pay = owed(n, x - bl, longTip);
        int keep = tx.inputs[self].value - quoteOf(n, bs - bl, 0);
        if (pay < PLAIN_DUST) {
            keep = keep + pay;
            pay = 0;
        }
        payTo(self, longKey, pay);
        byte[] lists = win(la3, lm3, lt3) + rs.slice(LISTS_AT + LIST_LEN, LISTS_END);
        partAndRest(selfId, rs, n, k, pairSpk(rs, n, bl3, bs, e3, lk3, byte[32](shortKey), lists, tl3, zero32()), quoteOf(n, bs - bl3, 0), keep, clk);
    }

    // P4 close-versus-close, donor side. This pair's short listing is filled for n at x: the short leaves with
    // q(n, bs - x) - q(n, shortTip) at output i, and the long moves into the host's P3 at output c: a KpfPair of
    // this market under another, non-zero covenant id with (n, bl, bs3, entry e3), this long's key and listing, and
    // tagL = this pair's id, which claims P3 once (OpCovInputCount(selfId) == 1). Its short (key sk3, listing
    // (sa3, sm3, st3)) is the host's, with tag 0 (the host's short is not handed over). For the moving long:
    // no-downgrade bs3 >= bs, and e3 >= this pair's entry, so its idle payoff does not fall (DESIGN 4.5a). A
    // remainder continues this id with both tags cleared; when n = s the pair ends and its carrier and excess go
    // to the leaving short.
    // DESIGN: 4.5 T3 does not say where the donor's carrier goes when its whole size moves; P3 already has the
    // host's carrier, so the freed one is paid to the leaver rather than left to the executor.
    entry closeDonor(int n, int x, int e3, int c, int bs3, byte[32] sk3, int sa3, int sm3, int st3) {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        require(OpCovInputCount(selfId) == 1);
        checkPair();
        checkPart(n);
        require(x >= 0);
        require(x <= priceMax);
        require(shortBid > 0);
        require(x <= shortBid);
        require(n >= shortMin || n == size);
        require(bs3 >= bs);
        require(bs3 <= priceMax);
        require(e3 >= entryPrice);
        int clk = clockStart();
        handOverLimit(clk);
        byte[] rs = ownRs();
        byte[32] pid = OpOutputCovenantId(c);
        require(pid != zero32());
        require(pid != selfId);
        byte[] lists = rs.slice(LISTS_AT, LISTS_AT + LIST_LEN) + win(sa3, sm3, st3);
        require(tx.outputs[c].scriptPubKey == pairSpk(rs, n, bl, bs3, e3, byte[32](longKey), sk3, lists, selfId, zero32()));
        require(tx.outputs[c].value >= quoteOf(n, bs3 - bl, 0) + carrier);
        int pay = owed(n, bs - x, shortTip);
        int keep = tx.inputs[self].value - quoteOf(n, bs - bl, 0);
        if (n == size) {
            require(OpCovOutputCount(selfId) == 0);
            pay = pay + keep;
            if (pay < PLAIN_DUST) { pay = 0; }
        } else {
            if (pay < PLAIN_DUST) {
                keep = keep + pay;
                pay = 0;
            }
            require(OpCovOutputCount(selfId) == 1);
            int c1 = OpCovOutputIdx(selfId, 0);
            int rest = size - n;
            require(tx.outputs[c1].scriptPubKey == restSpk(rs, rest, clk));
            require(tx.outputs[c1].value >= quoteOf(rest, bs - bl, 0) + carrier);
            require(tx.outputs[c1].value >= keep);
        }
        payTo(self, shortKey, pay);
    }

    // P4 mutual close (DESIGN 4.5 T3'). Both listings of this pair cross at x (longAsk <= x <= shortBid): n closes,
    // the long gets q(n, x - bl) - q(n, longTip) at output i and the short q(n, bs - x) - q(n, shortTip) at output
    // M - 1 - i. A remainder keeps both listings. When n = s the pair ends and its carrier and excess go to the
    // short, as in P8.
    // DESIGN: T3' lists the payouts without tips; each leaver's listed tip is deducted as on every other listing
    // fill, and 4.6 names no remainder side when both parties acted, so P8's choice (the short) is reused.
    entry mutualClose(int n, int x) {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        require(OpCovInputCount(selfId) == 1);
        checkPair();
        checkPart(n);
        require(longAsk > 0);
        require(shortBid > 0);
        require(x >= longAsk);
        require(x <= shortBid);
        require(x <= priceMax);
        require(n >= longMin || n == size);
        require(n >= shortMin || n == size);
        int lp = owed(n, x - bl, longTip);
        int sp = owed(n, bs - x, shortTip);
        int keep = tx.inputs[self].value - quoteOf(n, bs - bl, 0);
        if (n == size) {
            require(OpCovOutputCount(selfId) == 0);
            sp = sp + keep;
            if (lp < PLAIN_DUST) {
                sp = sp + lp;
                lp = 0;
            }
            if (sp < PLAIN_DUST) {
                lp = lp + sp;
                sp = 0;
            }
            if (lp < PLAIN_DUST) { lp = 0; }
        } else {
            if (lp < PLAIN_DUST) {
                keep = keep + lp;
                lp = 0;
            }
            if (sp < PLAIN_DUST) {
                keep = keep + sp;
                sp = 0;
            }
            require(OpCovOutputCount(selfId) == 1);
            int c1 = OpCovOutputIdx(selfId, 0);
            int rest = size - n;
            byte[] rs = ownRs();
            require(tx.outputs[c1].scriptPubKey == restSpk(rs, rest, clockStart()));
            require(tx.outputs[c1].value >= quoteOf(rest, bs - bl, 0) + carrier);
            require(tx.outputs[c1].value >= keep);
        }
        payTo(self, longKey, lp);
        if (sp > 0) {
            int j = tx.outputs.length - 1 - self;
            require(j >= tx.inputs.length);
            payTo(j, shortKey, sp);
        }
    }

    // P8 idle settle. Anyone, once this UTXO is idleDaa old (CSV; the compiler refuses a value outside
    // [0, 2^32), so a hand-built idleDaa cannot reach the sequence mask). The pair ends at the stored entry
    // price clamped to [bl, bs]: the long gets q(s, c(E) - bl) at output i, the short the rest of this UTXO's
    // value at output M - 1 - i.
    entry idleSettle() {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        require(OpCovInputCount(selfId) == 1);
        checkPair();
        require(this.ageDaa >= idleDaa);
        require(OpCovOutputCount(selfId) == 0);
        int e = entryPrice;
        if (e < bl) { e = bl; }
        if (e > bs) { e = bs; }
        int v = tx.inputs[self].value;
        // DESIGN: T8 says "short >= the rest" without defining it. Read as the whole input value less the long's
        // payout, so the carrier and any excess go to the short (the remainder side) and none to the executor.
        int lp = quoteOf(size, e - bl, 0);
        int sp = v - lp;
        if (lp < PLAIN_DUST) {
            lp = 0;
            sp = v;
        } else {
            if (sp < PLAIN_DUST) {
                lp = v;
                sp = 0;
            }
        }
        if (lp > 0) {
            require(tx.outputs[self].scriptPubKey == byte[](new ScriptPubKeyP2PK(longKey)));
            require(tx.outputs[self].value >= lp);
        }
        if (sp > 0) {
            int j = tx.outputs.length - 1 - self;
            require(j >= tx.inputs.length);
            require(tx.outputs[j].scriptPubKey == byte[](new ScriptPubKeyP2PK(shortKey)));
            require(tx.outputs[j].value >= sp);
        }
    }

    // P9 cooperative close. Both owners sign with SIGHASH_ALL, so both commit to every output: any split. The
    // pair ends, and no output stays bound to its covenant id.
    // No bounds check here: two signatures are the last way out of a pair whose state is malformed (no honest
    // KpfOpen creates one), and releasing it harms nobody else.
    entry coopClose(sig sl, sig ss) {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        require(OpCovInputCount(selfId) == 1);
        signedBy(sl, longKey);
        signedBy(ss, shortKey);
        require(OpCovOutputCount(selfId) == 0);
    }

    // ------------------------------------------------------------------ price evidence

    // Input idx is an instance of template (pre, stLen, suf, tpl), checked by P2SH of its redeem script (the last
    // push of its signature script) and the template hash, as KobCondAsk.tplState. Returns its state span.
    function tplState(int idx, int pre, int stLen, int suf, byte[32] tpl) : byte[] {
        int sz = pre + stLen + suf;
        int base = OpTxInputScriptSigLen(idx) - sz;
        byte[] rs = OpTxInputScriptSigSubstr(idx, base, base + sz);
        require(tx.inputs[idx].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        require(blake3(byte[](pre as byte[8]) + rs.slice(0, pre) + byte[](suf as byte[8]) + rs.slice(pre + stLen, sz)) == tpl);
        return rs.slice(pre, pre + stLen);
    }

    // The first two pushes of input j's signature script: 8-byte n_j >= 0, then the 8-byte block start, which must
    // be exactly qb. Returns n_j.
    function blockN(int j, byte[8] qb) : int {
        require(OpTxInputScriptSigSubstr(j, 0, 1) == byte[](0x08));
        int nj = int(byte[8](OpTxInputScriptSigSubstr(j, 1, 9)));
        require(nj >= 0);
        require(OpTxInputScriptSigSubstr(j, 9, 10) == byte[](0x08));
        require(byte[8](OpTxInputScriptSigSubstr(j, 10, 18)) == qb);
        return nj;
    }

    // Evidence block (DESIGN 4.4): this input lies in [q, ev), the block has at most 8 inputs, every input of it
    // names q, and the evidence fill covers k times their sum: n_ev >= ceil(kBps * sum / 10^4), computed as
    // floor(sum / 10^4) * kBps + ceil((sum mod 10^4) * kBps / 10^4) (DESIGN 5), exact and without overflow for
    // sum <= 8 sizes and kBps <= 10^5. An input of the block that is not a pair can only raise the sum.
    // DESIGN: 4.2 bounds neither kBps nor minRestDaa; k = 0 would let any fill act on any size, so 0 < kBps <= 10^5
    // (the bound of DESIGN 5) and minRestDaa >= 0 are required here.
    function evBlock(int ev, int nev, byte[8] qb) {
        require(kBps > 0);
        require(kBps <= K_MAX);
        int self = this.activeInputIndex;
        int q = int(qb);
        require(q >= 0);
        require(q <= self);
        require(self < ev);
        int len = ev - q;
        require(len <= 8);
        int sum = blockN(q, qb);
        if (len > 1) { sum = sum + blockN(q + 1, qb); }
        if (len > 2) { sum = sum + blockN(q + 2, qb); }
        if (len > 3) { sum = sum + blockN(q + 3, qb); }
        if (len > 4) { sum = sum + blockN(q + 4, qb); }
        if (len > 5) { sum = sum + blockN(q + 5, qb); }
        if (len > 6) { sum = sum + blockN(q + 6, qb); }
        if (len > 7) { sum = sum + blockN(q + 7, qb); }
        require(nev >= (sum / BPS) * kBps + ((sum % BPS) * kBps + BPS - 1) / BPS);
    }

    // The quote of the evidence at input ev: a resting KobAsk (ask = 1, its custody at tk) or KobBid (ask = 0), as
    // KobCondAsk.touch reads it, and the evidence block of this input. KobAsk state offsets: tokenCovId [34..66)
    // scale [118..126) price [136..144) tif [154..162) activeFrom [163..171) expiryDaa [172..180) interval
    // [190..198) slope [208..216); KobBid's scale, price, tif, activeFrom and expiryDaa sit 33 bytes later, after
    // its extensionCommitment [118..150), its interval and slope 51 (kpf_layout_tests checks them against the
    // compiled KOB templates).
    // The evidence clock (DESIGN 4.5c): exposed' = max(exposed, clk), clk this pair's clock start, so evidence that
    // rested before the clock started, or that died before it had rested minRestDaa on the clock, is refused.
    function evQuote(int ask, int ev, int tk, byte[8] qb, int clk) : int {
        require(minRestDaa >= 0);
        require(OpTxInputScriptSigSubstr(ev, 0, 1) == byte[](0x08));
        int nev = int(byte[8](OpTxInputScriptSigSubstr(ev, 1, 9)));
        require(nev > 0);
        int pre = BID_PRE;
        int len = BID_STATE_LEN;
        int suf = BID_SUF;
        byte[32] tpl = BID_TPL;
        int d = 33;
        int w = 51;
        if (ask == 1) {
            pre = ASK_PRE;
            len = ASK_STATE_LEN;
            suf = ASK_SUF;
            tpl = ASK_TPL;
            d = 0;
            w = 0;
        }
        byte[] o = tplState(ev, pre, len, suf, tpl);
        require(byte[32](o.slice(34, 66)) == tokenCovId);
        byte[] qs = o.slice(118 + d, 180 + d);
        byte[] r = o.slice(190 + w, 216 + w);
        require(int(byte[8](qs.slice(0, 8))) == scale);
        require(int(byte[8](r.slice(18, 26))) == 0);
        // The interval is the evidence order's own state; one built by hand can carry a negative one, which must
        // not shorten the rest.
        int iv = int(byte[8](r.slice(0, 8)));
        require(iv >= 0);
        int ud = OpTxInputDaaScore(ev);
        int exposed = ud + iv;
        int act = int(byte[8](qs.slice(45, 53)));
        if (act > exposed) { exposed = act; }
        if (ask == 1) {
            // tk: a token UTXO of this market's program whose state [10..44) is the ask's covenant id as owner,
            // then the push 0x01 of owner_scheme 0x04, with this market's extension commitment.
            require(OpInputCovenantId(tk) == tokenCovId);
            byte[] ts = tplState(tk, tplPrefixLen, 112, tplSuffixLen, tokenTplHash);
            require(ts.slice(10, 44) == byte[](OpInputCovenantId(ev)) + byte[](0x0104));
            require(byte[32](ts.slice(80, 112)) == extensionCommitment);
            int td = OpTxInputDaaScore(tk);
            if (td > exposed) { exposed = td; }
        } else {
            require(byte[32](o.slice(118, 150)) == extensionCommitment);
        }
        if (clk > exposed) { exposed = clk; }
        int restEnd = exposed + minRestDaa;
        require(tx.daa >= restEnd);
        // Fillable by conforming matchers for the whole rest window (DESIGN 4.5b, review 2 F2; KOB matcher.md 2.3):
        // not past its soft expiry, not past the IOC/FOK kill (on chain every tif but GTC has it), not past 90 days
        // idle, each read from the order's own state as KobAsk.settle and KobBid.refund compute them.
        require(int(byte[8](qs.slice(54, 62))) >= restEnd);
        if (int(byte[8](qs.slice(36, 44))) != 0) {
            int kill = ud;
            if (act > kill) { kill = act; }
            require(kill + IOC_LIFE >= restEnd);
        }
        require(restEnd <= ud + MAX_IDLE);
        evBlock(ev, nev, qb);
        return int(byte[8](qs.slice(18, 26)));
    }

    // Header of every evidence entry: the single-input guard, the pair bounds, n = int(nb) a part of this pair,
    // and this input's own first two pushes are nb and
    // an 8-byte q (so the n settled here is the n its block counts). Returns n.
    function evEntry(byte[8] nb) : int {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        require(OpCovInputCount(selfId) == 1);
        checkPair();
        int n = int(nb);
        checkPart(n);
        require(OpTxInputScriptSigSubstr(self, 0, 1) == byte[](0x08));
        require(OpTxInputScriptSigSubstr(self, 1, 9) == byte[](nb));
        return n;
    }

    function clampP(int p) : int {
        int c = p;
        if (c < bl) { c = bl; }
        if (c > bs) { c = bs; }
        return c;
    }

    // Closes n of this pair at the price c in [bl, bs] (P5 at the clamped quote; P6 at the loser's bankruptcy
    // price, so the loser `side` is owed 0). The party `side` is owed exactly q(n, its distance to
    // c) (rounded down); the other party takes the rest of what leaves the pair less `fee`: q(n, bs - bl) - owed
    // with a remainder, or this UTXO's whole value - owed when n = s (carrier and excess included), never below 0.
    // The long is paid at output i, the short at
    // M - 1 - i (at least the input count). A payout below dust is not created: with a remainder its value stays
    // there, with n = s it goes to the other party. Whatever no output is required to hold (the fee) is the
    // executor's.
    function closeAt(int n, int c, int side, int fee, int clk) {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        int v = tx.inputs[self].value;
        int part = quoteOf(n, bs - bl, 0);
        int keep = v - part;
        int avail = part;
        if (n == size) {
            avail = v;
            keep = 0;
        }
        int owe = quoteOf(n, c - bl, 0);
        if (side == SIDE_SHORT) { owe = quoteOf(n, bs - c, 0); }
        int other = avail - owe - fee;
        if (other < 0) { other = 0; }
        if (n == size) {
            require(OpCovOutputCount(selfId) == 0);
            if (owe < PLAIN_DUST) {
                other = other + owe;
                owe = 0;
            }
            if (other < PLAIN_DUST) {
                owe = owe + other;
                other = 0;
            }
            if (owe < PLAIN_DUST) { owe = 0; }
        } else {
            if (owe < PLAIN_DUST) {
                keep = keep + owe;
                owe = 0;
            }
            if (other < PLAIN_DUST) {
                keep = keep + other;
                other = 0;
            }
            require(OpCovOutputCount(selfId) == 1);
            int c1 = OpCovOutputIdx(selfId, 0);
            int rest = size - n;
            require(tx.outputs[c1].scriptPubKey == restSpk(ownRs(), rest, clk));
            require(tx.outputs[c1].value >= quoteOf(rest, bs - bl, 0) + carrier);
            require(tx.outputs[c1].value >= keep);
        }
        int lp = owe;
        int sp = other;
        if (side == SIDE_SHORT) {
            lp = other;
            sp = owe;
        }
        payTo(self, longKey, lp);
        if (sp > 0) {
            int j = tx.outputs.length - 1 - self;
            require(j >= tx.inputs.length);
            payTo(j, shortKey, sp);
        }
    }

    // Keeper fee of a liquidation of n at quote p before its cap: max(keeperFeeMin, q(n, floor(p * liqFeeBps /
    // 10^4))). onEvidence caps it at the maintenance slice (DESIGN 4.5b).
    function feeAt(int n, int p) : int {
        int f = quoteOf(n, p * liqFeeBps / BPS, 0);
        if (f < keeperFeeMin) { f = keeperFeeMin; }
        return f;
    }

    // The three evidence paths share one entry, so the evidence reader and the block scan are in the script once.
    // `path` selects the path, as KobCondAsk.settle selects fill or refund by n; s is read by P5 only, and x, nbd,
    // ek, et, k by P7 only.
    //
    // P5 unilateral close (DESIGN 3.5 i, 4.5 T4), path 5. The owner of `side` (signature s) closes n at the bound
    // adverse to it: the long at a resting bid b (the price is at least b), the short at a resting ask a (at most
    // a). The closer is owed exactly q(n, c - bl) (long) or q(n, bs - c) (short) with c the quote clamped to
    // [bl, bs]; the other party, which did not act, takes the rest and the rounding. A remainder (s - n) keeps
    // every field.
    //
    // P6 liquidation, close both (DESIGN 3.6, 4.5b), path 6. Anyone. The loser `side` is liquidatable at the
    // quote: a long at an ask a with a * (10^4 - mmrBps) < bl * 10^4, a short at a bid b with
    // bs * 10^4 < b * (10^4 + mmrBps). The quote decides only that; the loser forfeits its residual (review 2, F1:
    // the loser could print its own quote on the wrong side of the market for free). The loser gets 0, the winner
    // the whole liquidated value less the fee: q(n, bs - bl) - fee with a remainder (which keeps the carrier, any
    // excess and the rounding slack, as on every split), the whole UTXO value - fee when n = s (carrier and excess
    // included). The fee is min(max(keeperFeeMin, q(n, floor(quote * liqFeeBps / 10^4))), slice), slice the
    // maintenance slice q(n, T - bl) with T = floor(bl * 10^4 / (10^4 - mmrBps)) for a long loser, q(n, bs - T)
    // with T = ceil(bs * 10^4 / (10^4 + mmrBps)) for a short, from the pair's state and not the quote. Since q is
    // superadditive, the winner receives at least q(n, bs - T) (its payoff at T) for a long loser, q(n, T - bl) for
    // a short. Partial liquidation in pieces: the remainder keeps every field but the tags.
    //
    // P7 liquidation by transfer (DESIGN 3.6, 4.5b), path 7. Anyone. As P6, but the loser's n is sold at x to an
    // entrant of its side exactly as P3 (key ek, tag et, new bound nbd, no-downgrade for the winner, entry kept),
    // without a listing: a long at x >= a, a short at x <= b. The entrant pays q(n, x - bl) (long) or q(n, bs - x)
    // (short); that payment less the fee (the same fee as P6), never below 0, goes to the winner at output i, and
    // the winner keeps its key, bound and listing in the part. The loser gets 0. A payout below dust stays in the
    // pair as in P3 (with n = s, in the part).
    //
    // Range (DESIGN 4.5c, review 3 F2). P6 and P7 require bl * (10^4 + mmrBps) < bs * (10^4 - mmrBps): the long's
    // trigger lies below the short's, so no quote liquidates both sides and the side that forfeits is never the
    // one owed the pair. With it the trigger price T lies strictly inside (bl, bs), so the review 2 clamp of T is
    // dropped and the fee cap q(n, T - bl) (long) or q(n, bs - T) (short) is always below the part.
    //
    // Health at entry of the P7 entrant (DESIGN 4.5c, review 3 F3). 4.5c asks that the entrant is not liquidatable
    // at its own entry price x. In P7 the executor chooses x anywhere at or beyond the quote (x >= a for a long),
    // so a check at x alone still lets the same transaction's quote prove the entrant liquidatable (review 3 F3
    // with x above the trigger). DESIGN: the check is made at the evidence quote p instead, which implies the check
    // at x (a long's x >= p, a short's x <= p): a long entrant needs p * (10^4 - mmrBps) >= nbd * 10^4, a short
    // nbd * 10^4 >= p * (10^4 + mmrBps).
    //
    // Evidence clock (DESIGN 4.5c). S = clockStart() bounds the evidence from below (evQuote); the remainder of
    // P5, P6 and P7 keeps since = S, the part of P7 carries since = 0. P7 is not rate-limited.
    //
    // DESIGN: 5 bounds the trigger products for a, b <= priceMax only; a liquidation quote outside [0, priceMax] is
    // refused (P5 only clamps, it forms no product with the quote).
    // DESIGN: T6 names a keeper output at an argument index holding >= fee. Anyone builds the transaction and
    // chooses that output's script, and two pairs could name one output, so it protects no party; the fee is
    // instead what no output is required to hold, the executor's like every other excess (4.4).
    // DESIGN: T4 does not say where the carrier and excess go when n = s; in P5 they go to the party that did
    // not act (the remainder side of 4.6), in P6 to the winner (4.5b: "the whole value of the part").
    // DESIGN: 4.5b says the winner receives the entrant's payment less the fee; when the fee exceeds the payment
    // the winner's position is not touched to make up the difference, so the payout is max(0, ...) and the fee is
    // what is left of the payment.
    // DESIGN: 2.5 carries over maintenance < 50 % but 4.2 bounds none of mmrBps, liqFeeBps, keeperFeeMin; P6 and P7
    // require 0 <= mmrBps < 5000, 0 <= liqFeeBps <= 10^4 (the fee-rate bound of DESIGN 5) and keeperFeeMin >= 0.
    //
    // The signature s is a byte[] converted to a 65-byte sig only by P5 (as KCC-20 converts its witness), so P6 and
    // P7 carry an empty push instead of a 65-byte dummy.
    entry onEvidence(byte[8] nb, byte[8] qb, int path, byte[] s, int side, int ev, int tk, int x, int nbd, byte[32] ek, byte[32] et, int k) {
        int n = evEntry(nb);
        int ask = 0;
        if (path == 5) {
            if (side == SIDE_LONG) {
                signedBy(sig(byte[65](s)), longKey);
            } else {
                require(side == SIDE_SHORT);
                signedBy(sig(byte[65](s)), shortKey);
                ask = 1;
            }
        } else {
            require(path == 6 || path == 7);
            require(mmrBps >= 0);
            require(mmrBps < MMR_CAP);
            require(liqFeeBps >= 0);
            require(liqFeeBps <= BPS);
            require(keeperFeeMin >= 0);
            if (side == SIDE_LONG) {
                ask = 1;
            } else {
                require(side == SIDE_SHORT);
            }
        }
        int clk = clockStart();
        int p = evQuote(ask, ev, tk, qb, clk);
        // P5 settles at the quote clamped to [bl, bs]; P6 at the loser's own bankruptcy price, so the loser `side`
        // is owed 0 and the winner takes the rest less the fee (closeAt).
        int c = clampP(p);
        int fee = 0;
        if (path != 5) {
            require(p >= 0);
            require(p <= priceMax);
            // The range is wider than both maintenance bands (see Range above).
            require(bl * (BPS + mmrBps) < bs * (BPS - mmrBps));
            // The trigger price T from this pair's own state and the maintenance slice t = T - bl (long) or
            // bs - T (short) that caps the fee; T lies inside (bl, bs).
            int t = 0;
            if (ask == 1) {
                require(p * (BPS - mmrBps) < bl * BPS);
                t = bl * BPS / (BPS - mmrBps) - bl;
                c = bl;
            } else {
                require(bs * BPS < p * (BPS + mmrBps));
                t = bs - (bs * BPS + BPS + mmrBps - 1) / (BPS + mmrBps);
                c = bs;
            }
            fee = feeAt(n, p);
            int slice = quoteOf(n, t, 0);
            if (fee > slice) { fee = slice; }
        }
        if (path == 7) {
            require(x >= 0);
            require(x <= priceMax);
            int o = 0;
            if (side == SIDE_LONG) {
                require(x >= p);
                o = owed(n, x - bl, 0);
            } else {
                require(x <= p);
                o = owed(n, bs - x, 0);
            }
            int pay = o - fee;
            if (pay < 0) { pay = 0; }
            // The entrant's payment for the loser's part goes to the winner, the stayer (DESIGN 4.5b).
            handOver(side, n, nbd, ek, et, k, pay, SIDE_LONG + SIDE_SHORT - side, p, clk);
        } else {
            closeAt(n, c, side, fee, clk);
        }
    }
}
