pragma silverscript ^0.1.0;

// A covered account (docs/ARCHITECTURE-CLEARING.md 13): its user's coins and its legs, and nothing of the clearing
// side: the other side is its shard's books. A leg's entry stays. Three kinds of statement are stated on it
// (KpfTChange): the user takes coins out (7), legs leave by the user's statement (8), a step of the user's
// liquidation (9). What is stated: the amount (a take's; a step's fee) and the leg that leaves (0 none, -1 every
// leg), 8 bytes each; the chain of the leg that leaves alone (blake2b(32 zero bytes + the leg): what its note names
// it by); then the head (the rate, the tolerance, T and the lines, 8 bytes each: docs 17.8h) and a trace, a row of
// 256 bytes a leg (the price, six sums, a step's price, sixteen numbers more, two chains; the model is crow.rs):
//   a_i    the price stated for leg i
//   G_i    what the legs 1..i gained or lost at the prices stated            (the user's standing is of this net)
//   W_i    what they are worth
//   WS_i   what those of them that stay are worth
//   LS_i   what those that stay have lost, each counted alone                (a gain of a leg that stays is no coin)
//   GL_i   what those that leave gained or lost
//   g_i    the chain of the legs up to i          h_i    the chain of those that stay, their entries as they are
// A dispute names one point (KpfTPoint): 2i - 1 row i (KpfTCRow), 2i the price of row i (KpfTStepPrice), 0 the end
// (KpfTCEnd). A point nobody answers costs the claimer its bond: the prices are the claimer's to show.
//
// KpfTCRow: the answer of a point 2i - 1. Row i is right when, for the leg the trace has there (a futures or a
// token leg), its price is above zero and within the market's limit, a step's second price is within the lower
// rate of it (any other statement's is the same), a leg of the market of the leg before says that row's prices
// and a leg of another closes the group (the leg before is shown, and held to the row before's chain), its sums
// are the sums before with the leg's at those prices (what it gains to the two ends of a move of the rate among
// them: crow.rs), its
// second chain is the one before with the leg (or as it is, where the leg leaves), and, where the leg leaves alone,
// it is the leg the statement names by its chain. A point beyond the trace is of nothing: answered right here.
//   answer(who, ageb, slotLen, position, kind, t0, said, outs, bond, claimer, window, late, held, dkey,
//          point, at, rkey, verdict, prev, leg)                                                                 anyone.
contract KpfTCRow(int init_version) {
    int version = init_version;

    int constant DIR_LONG = 1;
    int constant SIDE_A = 1;
    int constant SIDE_B = 2;
    int constant OPTION_TAG = 13;
    int constant FUTURES_TAG = 14;
    int constant SCALE_MAX = 1000000000;
    int constant MARGIN_MAX = 1152921504606846975;
    // What every operation leaves in the copy it used, for whoever the prices are from (KpfTSweep, KpfTPay).
    int constant ORACLE_FEE = 200000;
    int constant STATE_AT = 2;
    int constant CHANGE_TAG = 10;
    int constant POINT_TAG = 11;
    int constant NOTE_TAG = 12;
    // The least a note holds.
    int constant NOTE_MIN = 20000000;
    // The lateness of a statement that stands again after a point of it was answered right: it was held to its time
    // when it was disputed, and is not held to it again.
    int constant LATE_AGAIN = 499999999999;
    int constant BPS = 10000;

    function p33(byte[32] h) : byte[] {
        return byte[](0x20) + byte[](h);
    }

    function i9(int c) : byte[] {
        return byte[](0x08) + byte[](c as byte[8]);
    }

    function slotOf(int j, int slotLen) : byte[] {
        require(j >= 0);
        require(j < tx.inputs.length);
        require(j != this.activeInputIndex);
        int len = OpTxInputScriptSigLen(j);
        require(slotLen > STATE_AT + 32);
        require(slotLen <= len);
        byte[] rs = OpTxInputScriptSigSubstr(j, len - slotLen, len);
        require(tx.inputs[j].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        return rs;
    }

    function quoteAt(int n, int sc, int r) : int {
        int m = n % sc;
        int q = n / sc;
        return q * r + m * (r / sc) + (m * (r % sc)) / sc;
    }

    // The answer of a point. The point is right (1), by anyone's answer: the statement stands again (its dispute
    // period begins again; another point of it may be disputed until the last time to dispute; it is not held to
    // its time again), and the disputer's bond is lost: a quarter to the claimer (the last output), a quarter to
    // whoever answered (the one before), half to this script's copy (a claimer that answers its own other key's
    // dispute loses half a bond a round: docs 14.1).
    // The point is wrong (0): the position again, the disputer's bond back (the output before the last) and half of
    // the claimer's to whoever answered (the last). The other half of the bond lost stays in this script's copy.
    function ends(int j, byte[] rs, int slotLen, int verdict, byte[32] c0, byte[32] position, int bond, byte[32] claimer, byte[32] dkey, byte[32] rkey) {
        require(verdict == 0 || verdict == 1);
        require(bond > 0);
        int v = tx.inputs[j].value;
        require(v >= bond + bond);
        int half = bond / 2;
        int kept = bond - half;
        byte[32] id = OpInputCovenantId(j);
        require(OpCovInputCount(id) == 1);
        require(OpCovOutputCount(id) == 1);
        int c = OpCovOutputIdx(id, 0);
        int m = tx.outputs.length - 1 - 4 * j;
        if (verdict == 1) {
            require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, STATE_AT) + byte[](c0) + rs.slice(STATE_AT + 32, slotLen))));
            require(tx.outputs[c].value >= v - bond);
            require(m >= tx.inputs.length);
            // (Two outputs of less than this fit in no transaction: where a quarter is no payable amount the
            // claimer has half, in one output, and nobody is paid for the answer. Review 50, F77; 0.1 KAS: docs 17.8h, X1.)
            if (bond / 4 >= 10000000) {
                require(m - 1 >= tx.inputs.length);
                half = bond / 4;
                kept = bond - half - half;
                require(tx.outputs[m - 1].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(rkey))));
                require(tx.outputs[m - 1].value >= half);
            }
            rkey = claimer;
        } else {
            require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, STATE_AT) + byte[](position) + rs.slice(STATE_AT + 32, slotLen))));
            require(tx.outputs[c].value >= v - bond - bond);
            require(m - 1 >= tx.inputs.length);
            require(tx.outputs[m - 1].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(dkey))));
            require(tx.outputs[m - 1].value >= bond);
        }
        if (half > 0) {
            require(tx.outputs[m].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(rkey))));
            require(tx.outputs[m].value >= half);
        }
        int self = this.activeInputIndex;
        byte[32] lib = OpInputCovenantId(self);
        require(tx.outputs[self].scriptPubKey == tx.inputs[self].scriptPubKey);
        require(OpOutputCovenantId(self) == lib);
        require(tx.outputs[self].value >= tx.inputs[self].value + ORACLE_FEE + kept);
        require(OpCovOutputCount(lib) == OpCovInputCount(lib));
    }

    entry answer(byte[24] who, byte[8] ageb, int slotLen, byte[32] position, int kind, int t0, byte[] said, byte[32] outs, int bond, byte[32] claimer, int window, int late, int held, byte[32] dkey, int point, int at, byte[32] rkey, int verdict, byte[32] prev, byte[111] leg, byte[] legb) {
        require(version == 1);
        require(int(ageb) >= 0);
        int j = int(byte[8](who.slice(0, 8)));
        byte[] rs = slotOf(j, slotLen);
        // (A statement says two numbers and a chain, then its head, then its rows. An entry, kind 10, says the coins
        // added, the row and the leg whole, then its head and the place; nothing leaves.)
        int at0 = 80;
        int hd = 48;
        int skip = int(byte[8](said.slice(8, 16)));
        if (kind == 10) {
            at0 = 167;
            hd = 127;
            skip = 0;
        }
        require(said.length >= at0);
        byte[] rows = said.slice(at0, said.length);
        byte[] pre = i9(CHANGE_TAG) + p33(position) + i9(kind) + i9(t0) + p33(blake2b(said)) + p33(outs) + i9(bond) + p33(claimer) + i9(window);
        byte[32] c0 = blake2b(pre + i9(late) + i9(held));
        // (A statement that stands again keeps its lateness, beside the mark that it does: the last time to dispute
        // it is counted from its time by it.)
        int again = late;
        if (late < LATE_AGAIN) { again = LATE_AGAIN + late; }
        byte[32] c1 = blake2b(pre + i9(again) + i9(held));
        require(blake2b(i9(POINT_TAG) + p33(c0) + p33(dkey) + i9(point)) == byte[32](rs.slice(STATE_AT, STATE_AT + 32)));
        // The point answered is the one disputed; or any other, where the answer is that it is wrong.
        require(at == point || verdict == 0);
        int n = rows.length / 256;
        require(rows.length == 256 * n);
        require(kind >= 7);
        // (12, a split: its rows are a leaving's of one leg.)
        // (13, a mark: the leg named stays, at the entry the statement says.)
        // (14, 15: a token leg leaves, or is sold: it is the leg named.)
        require(kind <= 10 || kind == 12 || kind == 13 || kind == 14 || kind == 15);
        require(who.slice(8, 16) == who.slice(0, 8));
        require(who.slice(16, 24) == who.slice(0, 8));
        require(at >= 1);
        int i = (at + 1) / 2;
        int ok = 1;
        if (i <= n) {
            require(at % 2 == 1);
            byte[] z8 = byte[](0 as byte[8]);
            byte[] z32 = z8 + z8 + z8 + z8;
            byte[] row = rows.slice(256 * (i - 1), 256 * i);
            byte[] before = z32 + z32 + z32 + z32 + z32 + z32 + z32 + z32;
            // (The chain two rows before: what the row before's chain is opened from.)
            byte[] g2 = z32;
            if (i > 1) {
                before = rows.slice(256 * (i - 2), 256 * (i - 1));
            }
            if (i > 2) {
                g2 = rows.slice(256 * (i - 3) + 192, 256 * (i - 3) + 224);
            }
            // The row's chain is opened: a chain before it and a leg that hash to it. Where that chain is not the
            // row before's, the row is wrong. (A chain of 32 zero bytes is the seed of every chain and of no leg:
            // a row that carries it is wrong, with no leg shown.)
            byte[] lg = byte[](leg);
            if (row.slice(192, 224) == z32) {
                ok = 0;
            } else {
                require(blake2b(byte[](prev) + lg) == byte[32](row.slice(192, 224)));
            }
            if (byte[](prev) != before.slice(192, 224)) { ok = 0; }
            // The leg before, shown: the row before's chain opened from the chain two rows before (asked, not
            // judged: a false leg shown would make a right row wrong). A leg of its market goes on with its group
            // and says its two prices; a leg of another closes the group (docs 17.4, 17.8h).
            int same = 0;
            if (i > 1) {
                if (ok == 1) {
                    require(legb.length == 111);
                    require(blake2b(g2 + legb) == byte[32](before.slice(192, 224)));
                    if (legb.slice(0, 33) == lg.slice(0, 33)) { same = 1; }
                }
            }
            int a = int(byte[8](row.slice(0, 8)));
            int q = int(byte[8](row.slice(56, 64)));
            int rate = int(byte[8](said.slice(hd, hd + 8)));
            int tol = int(byte[8](said.slice(hd + 8, hd + 16)));
            if (rate < 0 || rate > BPS || tol < 0 || tol > BPS) { ok = 0; }
            if (same == 1) {
                if (a != int(byte[8](before.slice(0, 8)))) { ok = 0; }
                if (q != int(byte[8](before.slice(56, 64)))) { ok = 0; }
            }
            if (a <= 0) { ok = 0; }
            if (a > int(byte[8](lg.slice(76, 84)))) { ok = 0; }
            // A futures leg (1 long, 2 short), an option leg (3 a call held, 4 a call written, 5 a put held, 6 a put
            // written: docs 17.8i), or a token leg (7: docs 16.12): a covered account has no other.
            int dir = int(byte[8](lg.slice(94, 102)));
            if (dir < 1 || dir > 7) { ok = 0; }
            // (The head's lines: a bit a leg, none below nothing.)
            if (int(byte[8](said.slice(hd + 24, hd + 32))) < 0) { ok = 0; }
            int leaves = 0;
            if (skip == 0 - 1) { leaves = 1; }
            if (skip == i) {
                // The leg that leaves alone is the one the statement names: its note is of that chain.
                leaves = 1;
                if (blake2b(z32 + lg) != byte[32](said.slice(16, 48))) { ok = 0; }
            }
            if (kind == 10) {
                if (i == n) {
                    // The last row of an entry is of the leg said, at its entry: it gains nothing as it enters.
                    if (lg != said.slice(16, 127)) { ok = 0; }
                    if (int(byte[8](lg.slice(103, 111))) != a) { ok = 0; }
                }
            }
            if (dir == 7) {
                // A token leg is named by no statement of these kinds (its tokens leave by kinds of their own), and
                // enters by no entry.
                if (leaves == 1) {
                    if (kind != 14 && kind != 15) { ok = 0; }
                }
                if (kind == 10) {
                    if (i == n) { ok = 0; }
                }
            }
            if (kind == 14 || kind == 15) {
                // (Tokens leave, or are sold: one leg is named, and it is a token leg.)
                if (skip == 0 - 1) { ok = 0; }
                if (leaves == 1) {
                    if (dir != 7) { ok = 0; }
                }
            }
            // The two ends of a move of the rate from the row's price; a step's price within the lower rate of it,
            // and of any other statement the row's price.
            int lo = 0;
            int up = 0;
            if (ok == 1) {
                int dd = (a / BPS) * rate + ((a % BPS) * rate + BPS - 1) / BPS;
                lo = a - dd;
                if (lo < 0) { lo = 0; }
                up = a + dd;
                if (kind == 9) {
                    int lw = rate - tol - tol;
                    if (lw < 0) { lw = 0; }
                    int dq = (a / BPS) * lw + ((a % BPS) * lw + BPS - 1) / BPS;
                    if (q < 0 || q - a > dq || a - q > dq) { ok = 0; }
                } else {
                    if (q != a) { ok = 0; }
                }
            }
            if (ok == 1) {
                int scale = int(byte[8](lg.slice(67, 75)));
                int size = int(byte[8](lg.slice(85, 93)));
                // (A token leg adds nothing to what is asked: its worth is counted at its row's price alone, whatever
                // it is at the ends. Review T13, W9.)
                if (dir == 7) {
                    lo = a;
                    up = a;
                    q = a;
                }
                int worth = quoteAt(size, scale, a);
                int d = worth - quoteAt(size, scale, int(byte[8](lg.slice(103, 111))));
                // (What the leg gains from the row's price to each end, and to the step's price.)
                int dl = quoteAt(size, scale, lo) - worth;
                int du = quoteAt(size, scale, up) - worth;
                int mq = quoteAt(size, scale, q) - worth;
                if (dir != DIR_LONG) {
                    d = 0 - d;
                    dl = 0 - dl;
                    du = 0 - du;
                    mq = 0 - mq;
                }
                // (Its band where it leaves alone: twice the tolerance of its worth. Its entry's part: the tolerance
                // of its worth. What it gains to the two ends of a move of the tolerance. Docs 17.8i.)
                int bd = (worth / BPS) * (tol + tol) + ((worth % BPS) * (tol + tol) + BPS - 1) / BPS;
                int be = (worth / BPS) * tol + ((worth % BPS) * tol + BPS - 1) / BPS;
                int dt = (a / BPS) * tol + ((a % BPS) * tol + BPS - 1) / BPS;
                int dlb = a - dt;
                if (dlb < 0) { dlb = 0; }
                if (dir == 7) {
                    dlb = a;
                    dt = 0;
                }
                dlb = quoteAt(size, scale, dlb) - worth;
                int dub = quoteAt(size, scale, a + dt) - worth;
                if (dir != DIR_LONG) {
                    dlb = 0 - dlb;
                    dub = 0 - dub;
                }
                // An option leg (docs 17.2, 17.8i). Its 32 bytes say, after the time it entered, its day, its strike
                // and its premium a unit. What it is worth exercised at a price, to its user: `sg` times the larger
                // of nothing and `cs` times the worth there less the worth at the strike.
                int prem = 0;
                int pod = 0;
                int nsd = 1;
                int wo = worth;
                if (dir >= 3 && dir <= 6) {
                    int strike = int(byte[8](lg.slice(50, 58)));
                    int pu = int(byte[8](lg.slice(58, 66)));
                    int day = int(byte[8](lg.slice(42, 50)));
                    // Wrong, before anything: a strike out of its market's range, a premium below nothing, an
                    // ended leg (it leaves by the day's transaction), a leaving or a mark that names it (nobody
                    // exercises before the day), and the leg an entry says (an option enters by the seventh step).
                    if (strike <= 0 || strike > int(byte[8](lg.slice(76, 84))) || pu < 0 || day <= t0) { ok = 0; }
                    if (leaves == 1) {
                        if (kind == 8 || kind == 13) { ok = 0; }
                    }
                    if (kind == 10) {
                        if (i == n) { ok = 0; }
                    }
                    if (ok == 1) {
                        int cs = 1;
                        if (dir >= 5) { cs = 0 - 1; }
                        int sg = 1;
                        if (dir == 4 || dir == 6) { sg = 0 - 1; }
                        int wk = quoteAt(size, scale, strike);
                        int va = cs * (worth - wk);
                        if (va < 0) { va = 0; }
                        va = sg * va;
                        int ve = cs * (quoteAt(size, scale, int(byte[8](lg.slice(103, 111)))) - wk);
                        if (ve < 0) { ve = 0; }
                        ve = sg * ve;
                        d = va - ve;
                        // The two sums: exact; a held option whose strike is between the ends, along its line (in
                        // a step the line of nothing; else the head's bit of its place); within T of its day,
                        // each no more than nothing.
                        dl = cs * (quoteAt(size, scale, lo) - wk);
                        du = cs * (quoteAt(size, scale, up) - wk);
                        int line = 0;
                        if (sg == 1 && lo < strike && strike < up) {
                            line = 1;
                            int pw = 1;
                            if (i == 2) { pw = 2; }
                            if (i == 3) { pw = 4; }
                            if (i == 4) { pw = 8; }
                            if (i == 5) { pw = 16; }
                            if (i == 6) { pw = 32; }
                            if (kind != 9 && (int(byte[8](said.slice(hd + 24, hd + 32))) / pw) % 2 == 1) { line = 2; }
                        }
                        if (line == 1) {
                            dl = 0;
                            du = 0;
                        }
                        if (line == 0) {
                            if (dl < 0) { dl = 0; }
                            if (du < 0) { du = 0; }
                            dl = sg * dl;
                            du = sg * du;
                        }
                        dl = dl - va;
                        du = du - va;
                        mq = cs * (quoteAt(size, scale, q) - wk);
                        if (mq < 0) { mq = 0; }
                        mq = sg * mq - va;
                        if (day - t0 <= int(byte[8](said.slice(hd + 16, hd + 24)))) {
                            if (dl > 0) { dl = 0; }
                            if (du > 0) { du = 0; }
                            if (mq > 0) { mq = 0; }
                        }
                        // Its entry's part: what it is worth exercised changes by where its entry is a tolerance
                        // off for the user.
                        int en = int(byte[8](lg.slice(103, 111)));
                        int et = (en / BPS) * tol + ((en % BPS) * tol + BPS - 1) / BPS;
                        int el = en - et;
                        if (el < 0) { el = 0; }
                        el = cs * (quoteAt(size, scale, el) - wk);
                        if (el < 0) { el = 0; }
                        et = cs * (quoteAt(size, scale, en + et) - wk);
                        if (et < 0) { et = 0; }
                        be = sg * el - ve;
                        if (sg * et - ve > be) { be = sg * et - ve; }
                        if (be < 0) { be = 0; }
                        // The band's ends: what it gains to them (the line of nothing where its strike is between
                        // them); and its band where it leaves alone: its entry's part and what it loses there.
                        int lb = a - dt;
                        if (lb < 0) { lb = 0; }
                        dlb = cs * (quoteAt(size, scale, lb) - wk);
                        if (dlb < 0) { dlb = 0; }
                        dlb = sg * dlb - va;
                        dub = cs * (quoteAt(size, scale, a + dt) - wk);
                        if (dub < 0) { dub = 0; }
                        dub = sg * dub - va;
                        bd = 0 - dlb;
                        if (0 - dub > bd) { bd = 0 - dub; }
                        if (bd < 0) { bd = 0; }
                        bd = bd + be;
                        if (sg == 1 && lb < strike && strike < a + dt) {
                            dlb = 0 - va;
                            dub = 0 - va;
                        }
                        // Its premium; what its leaving pays of it (a holder's, whole; a writer's, less what it
                        // lost); a held option is not counted among the legs that stay.
                        prem = quoteAt(size, scale, pu);
                        pod = prem;
                        if (sg == 1) {
                            nsd = 0;
                        } else {
                            if (d < 0) { pod = prem + d; }
                            if (pod < 0) { pod = 0; }
                        }
                        // (An option adds nothing to the legs' worth.)
                        wo = 0;
                    }
                }
                // (The band of all the legs, the open group's two sums at the tolerance, and how many of the legs
                // that stay are not held options.)
                int ba = int(byte[8](before.slice(72, 80)));
                int tdd = int(byte[8](before.slice(168, 176)));
                int tdu = int(byte[8](before.slice(176, 184)));
                int ns = int(byte[8](before.slice(184, 192)));
                // The two sums of the group that is open and R of the groups closed: of all the legs, and of those
                // that stay. A leg of another market than the leg before's closes the group.
                int dda = int(byte[8](before.slice(88, 96)));
                int dua = int(byte[8](before.slice(96, 104)));
                int rall = int(byte[8](before.slice(104, 112)));
                int dds = int(byte[8](before.slice(112, 120)));
                int dus = int(byte[8](before.slice(120, 128)));
                int rst = int(byte[8](before.slice(128, 136)));
                if (i > 1) {
                    if (same == 0) {
                        if (dua < dda) { dda = dua; }
                        if (dda < 0) { rall = rall - dda; }
                        if (dus < dds) { dds = dus; }
                        if (dds < 0) { rst = rst - dds; }
                        if (tdu < tdd) { tdd = tdu; }
                        if (tdd < 0) { ba = ba - tdd; }
                        tdd = 0;
                        tdu = 0;
                        dda = 0;
                        dua = 0;
                        dds = 0;
                        dus = 0;
                    }
                }
                int ws = 0;
                int ls = 0;
                int gl = 0;
                // (What the row's first sum takes: what the leg gained or lost; of a mark, see below.)
                int dg = d;
                // (What the second sum takes: the leg's worth; a token leg's and an option's are not counted there.)
                int dw = wo;
                int tkd = 0;
                // (The band of a leg that leaves; what it can lose alone; whether it adds to the sums of what stays.)
                int dbl = 0;
                int drl = 0;
                int stays = 0;
                byte[32] h = byte[32](before.slice(224, 256));
                if (dir == 7) {
                    // A token leg that stays: nothing for the legs' worth, for what they gained or for what is
                    // asked; what it counts, as coins, is its worth at the price stated less its discount (in basis
                    // points, where a futures leg has its entry), rounded down, and a sompi.
                    int disc = int(byte[8](lg.slice(103, 111)));
                    dg = 0;
                    dw = 0;
                    dl = 0;
                    du = 0;
                    mq = 0;
                    bd = 0;
                    be = 0;
                    h = blake2b(before.slice(224, 256) + lg);
                    if (disc < 0 || disc > 10000) {
                        ok = 0;
                    } else {
                        tkd = (worth / 10000) * (10000 - disc) + ((worth % 10000) * (10000 - disc)) / 10000 + 1;
                    }
                    if (leaves == 1) {
                        // (The token leg named, kinds 14 and 15: it leaves the chain; its worth whole is the fifth
                        // sum; and it counts in the sixth only where it is sold, 15: a step is due by the account
                        // as it stands before the sale.)
                        h = byte[32](before.slice(224, 256));
                        gl = worth;
                        tkd = 0;
                    }
                } else if (leaves == 1) {
                    gl = d;
                    dbl = bd;
                    if (du < dl) { drl = 0 - du; } else { drl = 0 - dl; }
                    if (drl < 0) { drl = 0; }
                    if (kind == 13) {
                        // A mark: the leg stays, entered from now at the price the statement says where a take
                        // has its amount. What it gained up to there is what the shard is asked (the fifth
                        // sum); what it has beyond, unrealized at the price of its row, is the first sum, which
                        // no other leg of a mark adds to; and its worth is not among the worth of the others,
                        // so that the end has it apart.
                        int ne = int(byte[8](said.slice(0, 8)));
                        drl = 0;
                        if (ne <= 0 || ne > int(byte[8](lg.slice(76, 84)))) {
                            ok = 0;
                        } else {
                            int wne = quoteAt(size, scale, ne);
                            gl = wne - quoteAt(size, scale, int(byte[8](lg.slice(103, 111))));
                            dg = worth - wne;
                            if (dir != DIR_LONG) {
                                gl = 0 - gl;
                                dg = 0 - dg;
                            }
                            h = blake2b(before.slice(224, 256) + lg.slice(0, 103) + byte[](ne as byte[8]));
                        }
                    }
                } else {
                    ws = wo;
                    stays = 1;
                    if (d < 0) { ls = 0 - d; }
                    h = blake2b(before.slice(224, 256) + lg);
                    if (kind == 13) { dg = 0; }
                }
                dda = dda + dl;
                dua = dua + du;
                if (stays == 1) {
                    dds = dds + dl;
                    dus = dus + du;
                    ns = ns + nsd;
                }
                // (A held option that leaves is counted in the same number, by 256: an end is not shown the leg.)
                if (leaves == 1) {
                    if (dir == 3 || dir == 5) { ns = ns + 256; }
                }
                ba = ba + be;
                tdd = tdd + dlb;
                tdu = tdu + dub;
                // The row is the row before with the leg's numbers: today's six sums; then what the legs gain to
                // the step's price, the bands, the two sums and R twice, what the legs that leave can lose alone;
                // and the options' numbers as they were (docs 17.8h: nothing, before the option leg).
                if (row.slice(8, 56) != byte[]((int(byte[8](before.slice(8, 16))) + dg) as byte[8]) + byte[]((int(byte[8](before.slice(16, 24))) + dw) as byte[8]) + byte[]((int(byte[8](before.slice(24, 32))) + ws) as byte[8]) + byte[]((int(byte[8](before.slice(32, 40))) + ls) as byte[8]) + byte[]((int(byte[8](before.slice(40, 48))) + gl) as byte[8]) + byte[]((int(byte[8](before.slice(48, 56))) + tkd) as byte[8])) { ok = 0; }
                if (row.slice(64, 144) != byte[]((int(byte[8](before.slice(64, 72))) + mq) as byte[8]) + byte[](ba as byte[8]) + byte[]((int(byte[8](before.slice(80, 88))) + dbl) as byte[8]) + byte[](dda as byte[8]) + byte[](dua as byte[8]) + byte[](rall as byte[8]) + byte[](dds as byte[8]) + byte[](dus as byte[8]) + byte[](rst as byte[8]) + byte[]((int(byte[8](before.slice(136, 144))) + drl) as byte[8])) { ok = 0; }
                // (The premiums of all the option legs and of those that stay; what the option legs pay of theirs
                // where they leave, all of them: a step that names one leg may take every leg.)
                int ps = int(byte[8](before.slice(152, 160)));
                if (stays == 1) { ps = ps + prem; }
                if (row.slice(144, 168) != byte[]((int(byte[8](before.slice(144, 152))) + prem) as byte[8]) + byte[](ps as byte[8]) + byte[]((int(byte[8](before.slice(160, 168))) + pod) as byte[8])) { ok = 0; }
                if (row.slice(168, 192) != byte[](tdd as byte[8]) + byte[](tdu as byte[8]) + byte[](ns as byte[8])) { ok = 0; }
                if (h != byte[32](row.slice(224, 256))) { ok = 0; }
            }
        }
        require(ok == verdict);
        ends(j, rs, slotLen, verdict, c1, position, bond, claimer, dkey, rkey);
    }

    // The copy lets go of what gathered in it: a script of the library names it at a place, as an object is named
    // (KpfSlot.go asks no more), and answers for the rest. Only KpfTSweep's entry passes with a copy at a place it
    // names (every other entry holds what it names to the hash of an object's state), and it asks that the copy goes
    // on as it is, under the library's id, with what a copy keeps.
    entry release(int l, int k) {
        int self = this.activeInputIndex;
        require(k >= 0);
        require(k <= 2);
        // (An input that is not there has no id: the engine refuses the index.)
        require(OpInputCovenantId(l) == OpInputCovenantId(self));
        require(OpTxInputScriptSigSubstr(l, 0, 1) == byte[](0x18));
        require(OpTxInputScriptSigSubstr(l, 1 + 8 * k, 9 + 8 * k) == byte[](self as byte[8]));
    }
}
