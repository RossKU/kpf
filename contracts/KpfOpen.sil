pragma silverscript ^0.1.0;

// KpfOpen: a resting order to open one side of a KpfPair, escrowed in KAS (docs/DESIGN.md 4.2, 4.3, 4.5 T1).
//
// A long order opens at a price X <= limit with its own margin rate myRate (bl = X - myRate) and accepts a short
// whose margin rate bs - X is at least minCounterRate. A short order mirrors it (X >= limit, bs = X + myRate,
// X - bl >= minCounterRate). Rates are sompi per whole token of `scale` base units.
//
// Entries of this slice:
//   fill(pairOut, n, x, bl, bs, counterKey, counterTag, cPre, cSuf)
//          T1 open: n base units at x into the fresh KpfPair at output pairOut. Anyone, once tx.daa >= activeFrom.
//   take(partOut, n, x, e, bound, counterKey, ca, cm, ct, cPre, cSuf)
//          T2 transfer: n base units at x take a same-side listing of an existing KpfPair whose entry price is e;
//          the part at output partOut continues that pair's covenant id. Anyone, once tx.daa >= activeFrom.
//   cancel(s)   owner only, SIGHASH_ALL.
//   refund()    anyone, once tx.daa >= min(expiryDaa, UTXO DAA + 90 days).
// Liquidation by transfer (T7) is gone (DESIGN 4.5d): a finalized liquidation forfeits the loser's side to the
// winner, who sells it through an ordinary listing, which this order takes with `take` as any T2.
// Review 3 (DESIGN 4.5c): every pair output this order rebuilds carries since = 0 (a fresh evidence clock), the
// order's side is healthy at its own entry price x, and the range is wider than both maintenance bands. The
// order's activeFrom is a lower bound on tx.daa (CLTV); it shares the transaction's one lock time with the bounds
// the pair proves (the evidence rest, the hand-over limit), each of which is a lower bound too.
//
// The order enforces only its own guarantees (KOB option 2). It never reads the counterparty: it rebuilds the
// whole pair output script from its own market block, its own key, rate and covenant id, and the arguments, and
// requires the output to be exactly that script under a covenant id created in this transaction. Two orders on
// the two sides of one pair therefore accept the same output if and only if both rebuild the same bytes, and the
// tag on its side (its own covenant id) means no second order of its side can claim the same output. A part taken
// by `take` carries tag 0 on the stayer's side (no pair entry copies a tag, DESIGN 4.4), so no claimer of the
// other side can claim it either.
contract KpfOpen(
    byte[32] PAIR_TPL,
    byte[32] init_tokenCovId,
    byte[32] init_tokenTplHash,
    byte[32] init_extensionCommitment,
    int init_tplPrefixLen,
    int init_tplSuffixLen,
    int init_scale,
    int init_mmrBps,
    int init_kBps,
    int init_minRestDaa,
    int init_liqFeeBps,
    int init_keeperFeeMin,
    int init_minSize,
    int init_carrier,
    int init_idleDaa,
    int init_priceMax,
    int init_bondBps,
    int init_bondMin,
    int init_kcBps,
    int init_gBps,
    int init_challengeDaa,
    int init_minEvidenceLife,
    int init_side,
    pubkey init_ownerKey,
    int init_sizeLeft,
    int init_limit,
    int init_myRate,
    int init_minCounterRate,
    int init_minFill,
    int init_tip,
    int init_activeFrom,
    int init_expiryDaa
) {
    // Market block (state [0..261)), byte for byte the pair's.
    byte[32] tokenCovId = init_tokenCovId;
    byte[32] tokenTplHash = init_tokenTplHash;
    byte[32] extensionCommitment = init_extensionCommitment;
    int tplPrefixLen = init_tplPrefixLen;
    int tplSuffixLen = init_tplSuffixLen;
    int scale = init_scale;
    int mmrBps = init_mmrBps;
    int kBps = init_kBps;
    int minRestDaa = init_minRestDaa;
    int liqFeeBps = init_liqFeeBps;
    int keeperFeeMin = init_keeperFeeMin;
    int minSize = init_minSize;
    int carrier = init_carrier;
    int idleDaa = init_idleDaa;
    int priceMax = init_priceMax;
    int bondBps = init_bondBps;
    int bondMin = init_bondMin;
    int kcBps = init_kcBps;
    int gBps = init_gBps;
    int challengeDaa = init_challengeDaa;
    int minEvidenceLife = init_minEvidenceLife;
    // Order (state [261..375)).
    int side = init_side;                    // 1 long, 2 short
    pubkey ownerKey = init_ownerKey;         // maker (x-only)
    int sizeLeft = init_sizeLeft;            // * base units still to open
    int limit = init_limit;                  // long: X <= limit; short: X >= limit
    int myRate = init_myRate;                // own margin per whole token, > 0
    int minCounterRate = init_minCounterRate; // counterparty margin per whole token accepted, >= 0
    int minFill = init_minFill;              // smallest fill unless it takes all that is left
    int tip = init_tip;                      // per whole token, to the executor
    int activeFrom = init_activeFrom;
    int expiryDaa = init_expiryDaa;

    byte constant SIGHASH_ALL = 0x01;
    int constant SIDE_LONG = 1;
    int constant SIDE_SHORT = 2;
    int constant SCALE_MAX = 1000000000;
    int constant PRICE_CAP = 100000000000000;
    int constant INT_MAX = 9223372036854775807;
    int constant CSV_LIMIT = 4294967296;
    // The pair's evidence bounds (KpfPair: K_MAX, MMR_CAP, BPS) and the CLTV range of tx.daa.
    int constant K_MAX = 100000;
    int constant MMR_CAP = 5000;
    int constant BPS = 10000;
    int constant LOCK_TIME_THRESHOLD = 500000000000;
    // An order untouched for 90 days (10 DAA/s) becomes refundable by anyone.
    int constant MAX_IDLE = 77760000;
    // The largest bond floor (KpfPair.SOMPI_MAX).
    int constant SOMPI_MAX = 2900000000000000000;
    // The six listing fields of a new pair, all zero (unlisted), with their 0x08 push opcodes.
    byte[54] constant NO_LISTS = byte[54](0x080000000000000000080000000000000000080000000000000000080000000000000000080000000000000000080000000000000000);
    // One empty listing window.
    byte[27] constant NO_LIST = byte[27](0x080000000000000000080000000000000000080000000000000000);
    // Redeem-script offsets. The state starts at byte 1 (checked by the tests): market block [1..262), sizeLeft
    // payload [305..313).
    int constant MARKET_AT = 1;
    int constant MARKET_LEN = 261;
    int constant LEFT_AT = 305;

    // As KpfPair.quoteOf.
    function quoteOf(int n, int r, int c) : int {
        int m = n % scale;
        int q = n / scale;
        return q * r + m * (r / scale) + (m * (r % scale) + c) / scale;
    }

    // The market and order bounds a fill or take relies on: every bound the pair it creates checks on its entries
    // (DESIGN 5), including the evidence parameters its P5 and P6 need (DESIGN 4.5a, review 1 F4), so no order
    // creates a pair with a dead path.
    // DESIGN: 4.5a lists kBps, minRestDaa, mmrBps, liqFeeBps, keeperFeeMin with the pair's bounds; the pair also
    // needs minRestDaa below the lock-time threshold, since tx.daa >= exposed + minRestDaa is proven by CLTV, so
    // that bound is checked too. The token template facts (tplPrefixLen, tplSuffixLen, tokenTplHash) cannot be
    // checked without a token input and stay consented market data.
    function checkMarket() {
        require(scale > 0);
        require(scale <= SCALE_MAX);
        require(priceMax > 0);
        require(priceMax <= PRICE_CAP);
        require(carrier >= 0);
        require(minSize > 0);
        require(idleDaa >= 0);
        require(idleDaa < CSV_LIMIT);
        require(kBps > 0);
        require(kBps <= K_MAX);
        require(mmrBps >= 0);
        require(mmrBps < MMR_CAP);
        require(liqFeeBps >= 0);
        require(liqFeeBps <= BPS);
        require(keeperFeeMin >= 0);
        require(minRestDaa >= 0);
        require(minRestDaa < LOCK_TIME_THRESHOLD);
        // The hand-over limit tx.daa >= S + 4 * minRestDaa (DESIGN 4.5c) is proven by CLTV too, so 4 * minRestDaa must
        // stay below the lock-time threshold, or the pair this order creates could never be transferred or re-paired.
        // DESIGN: 4.5c adds the rate limit but no bound; this one is required so no order creates a pair with a dead
        // path (the rule of 4.5a, review 1 F4).
        require(minRestDaa * 4 < LOCK_TIME_THRESHOLD);
        // The two-step evidence parameters (DESIGN 4.5d), with the bounds KpfPair.propose checks, so every pending
        // part of the pair has a live challenge, cure and finalize.
        // DESIGN: 4.5d asks W >= R + detection and L <= 77,760,000 - R without making them rules. Both are required
        // here: with W < R a stale claim could be finalized before any counter-evidence can have rested, and with
        // L + R above the 90-day limit no evidence could ever qualify, so the pair could never be liquidated.
        require(bondBps >= 0);
        require(bondBps <= BPS);
        require(bondMin >= 0);
        require(bondMin <= SOMPI_MAX);
        require(kcBps > 0);
        require(kcBps <= K_MAX);
        require(gBps > 0);
        require(gBps < BPS);
        require(challengeDaa >= minRestDaa);
        require(challengeDaa < CSV_LIMIT);
        require(minEvidenceLife >= 0);
        require(minEvidenceLife + minRestDaa <= MAX_IDLE);
        require(myRate > 0);
        require(minCounterRate >= 0);
        require(tip >= 0);
    }

    // A 32-byte zero (no covenant id, a cleared tag), built from an 8-byte zero (OP_NUM2BIN) instead of a 33-byte
    // push at every use.
    function zero32() : byte[32] {
        byte[] z8 = byte[](0 as byte[8]);
        return byte[32](z8 + z8 + z8 + z8);
    }

    // A new pair [bl, bs] opened at x is healthy (DESIGN 4.5c): the long is not liquidatable at x
    // (x * (10^4 - mmrBps) >= bl * 10^4), the short is not (bs * 10^4 >= x * (10^4 + mmrBps)), and the range is
    // wider than both maintenance bands (bl * (10^4 + mmrBps) < bs * (10^4 - mmrBps)). Every product is at most
    // priceMax * 1.5 * 10^4 < 2^63.
    function healthy(int x, int bl, int bs) {
        require(x * (BPS - mmrBps) >= bl * BPS);
        require(bs * BPS >= x * (BPS + mmrBps));
        require(bl * (BPS + mmrBps) < bs * (BPS - mmrBps));
    }

    // This input's redeem script.
    function ownRs() : byte[] {
        int self = this.activeInputIndex;
        int len = OpTxInputScriptSigLen(self);
        return OpTxInputScriptSigSubstr(self, len - this.bytecodeSize, len);
    }

    // T1 open. n base units at price x into the pair at output pairOut with range [bl, bs]. counterKey and
    // counterTag are the other side's owner and tag; this order does not check them (the other side's order, or
    // a direct taker's own signature, does). cPre and cSuf are the KpfPair template prefix and suffix; their hash
    // must be PAIR_TPL.
    entry fill(int pairOut, int n, int x, int bl, int bs, byte[32] counterKey, byte[32] counterTag, byte[] cPre, byte[] cSuf) {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        // The single-input guard also makes the tag claim below unique (DESIGN 4.4): no other input carries this id.
        require(OpCovInputCount(selfId) == 1);
        require(tx.daa >= activeFrom);

        // Nothing checks the state when the order is created, so a fill checks what it relies on, including every
        // bound the new pair checks on each of its own entries (DESIGN 5), so the pair it creates is never stuck.
        checkMarket();

        // Amount. n >= minFill unless it takes all that is left; every pair part is >= minSize (DESIGN 4.6), so
        // what is left is 0 or itself at least one part.
        // DESIGN: 4.6 states "s - n in {0} or >= minSize" for pair splits; it is applied to the order's sizeLeft
        // too, since a rest below minSize could never open a pair and would only wait for refund.
        require(n > 0);
        require(n <= sizeLeft);
        require(n >= minSize);
        require(n >= minFill || n == sizeLeft);
        int left = sizeLeft - n;
        require(left == 0 || left >= minSize);
        require(n / scale <= (INT_MAX - carrier) / priceMax - 1);

        // Range and price.
        require(bl >= 0);
        require(bl < bs);
        require(bs <= priceMax);
        byte[32] lk = byte[32](ownerKey);
        byte[32] sk = counterKey;
        byte[32] tl = selfId;
        byte[32] ts = counterTag;
        if (side == SIDE_LONG) {
            require(x <= limit);
            require(bl == x - myRate);
            require(bs - x >= minCounterRate);
        } else {
            require(side == SIDE_SHORT);
            require(x >= limit);
            require(bs == x + myRate);
            require(x - bl >= minCounterRate);
            lk = counterKey;
            sk = byte[32](ownerKey);
            tl = counterTag;
            ts = selfId;
        }
        // Healthy at entry (DESIGN 4.5c, review 3 F4): neither side of the new pair is liquidatable at its entry
        // price x, and the range is wider than both maintenance bands (review 3 F2), so the long's trigger lies
        // below the short's.
        // DESIGN: 4.5c says KpfOpen enforces health "for the pair it creates"; both sides are checked, so a pair
        // opened against a signing taker (which no other covenant checks at T1) is healthy on both sides too.
        healthy(x, bl, bs);

        // The pair output, rebuilt byte for byte: KpfPair template, this order's market block, size n, [bl, bs],
        // entry x, both keys, both listings unlisted, both tags, since = 0 (its evidence clock starts at its own
        // UTXO, DESIGN 4.5c). Its covenant id is non-zero (an id-less pair is unspendable forever, X1) and no input
        // carries it (a fresh lineage created in this transaction).
        // DESIGN: T1 does not say what the listing windows of a new pair hold; they start unlisted (all zero), so a
        // listing always needs its owner's signed amend (P1).
        require(blake3(byte[](cPre.length as byte[8]) + cPre + byte[](cSuf.length as byte[8]) + cSuf) == PAIR_TPL);
        byte[] rs = ownRs();
        byte[] st = rs.slice(MARKET_AT, MARKET_AT + MARKET_LEN) + byte[](0x08) + byte[](n as byte[8]) + byte[](0x08)
            + byte[](bl as byte[8]) + byte[](0x08) + byte[](bs as byte[8]) + byte[](0x08) + byte[](x as byte[8])
            + byte[](0x20) + byte[](lk) + byte[](0x20) + byte[](sk) + byte[](NO_LISTS) + byte[](0x20) + byte[](tl)
            + byte[](0x20) + byte[](ts) + byte[](0x08) + byte[](0 as byte[8]);
        require(tx.outputs[pairOut].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(cPre + st + cSuf)));
        byte[32] pairId = OpOutputCovenantId(pairOut);
        require(pairId != zero32());
        require(OpCovInputCount(pairId) == 0);
        require(tx.outputs[pairOut].value >= quoteOf(n, bs - bl, 0) + carrier);

        // What this fill may take from the escrow: its margin and tip for n, rounded down, and one pair carrier.
        // DESIGN: the escrow formula of 4.2 (q(sizeLeft, myRate + tip) + C + carrier) is read as: C is the pair
        // carrier this order funds per fill, carrier the order's own UTXO carrier, which stays. Each of the two
        // orders funds one C, so a maker of k partial fills needs k carriers; the executor keeps the spare C.
        int spend = quoteOf(n, myRate + tip, 0) + carrier;
        if (left > 0) {
            // The rest continues this script with sizeLeft = left.
            require(OpCovOutputCount(selfId) == 1);
            int c = OpCovOutputIdx(selfId, 0);
            require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(
                rs.slice(0, LEFT_AT) + byte[](left as byte[8]) + rs.slice(LEFT_AT + 8, this.bytecodeSize)
            )));
            require(tx.outputs[c].value >= tx.inputs[self].value - spend);
        } else {
            // Filled out. The order ends, and what is left of the escrow goes to the owner at output i.
            require(OpCovOutputCount(selfId) == 0);
            require(tx.outputs[self].scriptPubKey == byte[](new ScriptPubKeyP2PK(ownerKey)));
            require(tx.outputs[self].value >= tx.inputs[self].value - spend);
        }
    }

    // T2 transfer: take a same-side listing. The pair's own transfer entry pays the leaver and enforces the
    // stayer's guarantees; this order checks only its own, exactly as fill does, on the part at output partOut:
    // the KpfPair template, this order's market block, size n, the pair's entry price e (kept by the pair, DESIGN
    // 4.5a), its owner as its side's key, its side's bound from its own rate (long bl = x - myRate, short
    // bs = x + myRate), its side unlisted, its tag = this order's covenant id, the stayer's tag 0, the
    // counterparty's margin rate >= minCounterRate, and the part's value. `bound` is the stayer's bound (bs for a
    // long order, bl for a short), counterKey and (ca, cm, ct) the stayer's key and listing, which the pair copies
    // and this order does not judge.
    // DESIGN: 4.5a says the entrant "sees E and accepts it by entering"; a resting order cannot see it, and an
    // unchecked e would let a pair whose two sides one attacker holds (any E it chose at T1) settle an absent
    // maker at P8 below the price it entered at. The order therefore accepts e only at or beyond its own fill price
    // in its favour (long e >= x, short e <= x), so its idle payoff is at least its own margin.
    // DESIGN: T2 says "as in T1", but the part continues the pair's existing covenant id, so T1's fresh-lineage
    // check (no input carries the id) cannot hold; only a non-zero id is required. A part whose id is fresh, or
    // whose author is not a real pair, is still a fully funded pair holding this order's terms, so it only gives.
    entry take(int partOut, int n, int x, int e, int bound, byte[32] counterKey, int ca, int cm, int ct, byte[] cPre, byte[] cSuf) {
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        require(OpCovInputCount(selfId) == 1);
        require(tx.daa >= activeFrom);
        checkMarket();

        require(n > 0);
        require(n <= sizeLeft);
        require(n >= minSize);
        require(n >= minFill || n == sizeLeft);
        int left = sizeLeft - n;
        require(left == 0 || left >= minSize);
        require(n / scale <= (INT_MAX - carrier) / priceMax - 1);

        int bl = bound;
        int bs = x + myRate;
        byte[32] lk = counterKey;
        byte[32] sk = byte[32](ownerKey);
        byte[] lists = byte[](0x08) + byte[](ca as byte[8]) + byte[](0x08) + byte[](cm as byte[8]) + byte[](0x08) + byte[](ct as byte[8]) + byte[](NO_LIST);
        byte[32] tl = zero32();
        byte[32] ts = selfId;
        if (side == SIDE_LONG) {
            require(x <= limit);
            require(e >= x);
            bl = x - myRate;
            bs = bound;
            require(bs - x >= minCounterRate);
            lk = byte[32](ownerKey);
            sk = counterKey;
            lists = byte[](NO_LIST) + byte[](0x08) + byte[](ca as byte[8]) + byte[](0x08) + byte[](cm as byte[8]) + byte[](0x08) + byte[](ct as byte[8]);
            ts = tl;
            tl = selfId;
        } else {
            require(side == SIDE_SHORT);
            require(x >= limit);
            require(e <= x);
            require(x - bl >= minCounterRate);
        }
        require(bl >= 0);
        require(bl < bs);
        require(bs <= priceMax);
        // Healthy at entry (DESIGN 4.5c, review 3 F3, F4): this order's own side is not liquidatable at its own
        // entry price x (a long: x * (10^4 - mmrBps) >= bl * 10^4, i.e. myRate * 10^4 >= mmrBps * x), and the part
        // is wider than both maintenance bands.
        // DESIGN: 4.5c states the range condition at creation; it is also required of the part an order enters,
        // because a part that violates it can never be liquidated in this order's favour (the pair's own
        // transfer, P4 and add margin keep the condition, so this binds only a part whose author is not a pair).
        if (side == SIDE_LONG) {
            require(x * (BPS - mmrBps) >= bl * BPS);
        } else {
            require(bs * BPS >= x * (BPS + mmrBps));
        }
        require(bl * (BPS + mmrBps) < bs * (BPS - mmrBps));

        require(blake3(byte[](cPre.length as byte[8]) + cPre + byte[](cSuf.length as byte[8]) + cSuf) == PAIR_TPL);
        byte[] rs = ownRs();
        byte[] st = rs.slice(MARKET_AT, MARKET_AT + MARKET_LEN) + byte[](0x08) + byte[](n as byte[8]) + byte[](0x08)
            + byte[](bl as byte[8]) + byte[](0x08) + byte[](bs as byte[8]) + byte[](0x08) + byte[](e as byte[8])
            + byte[](0x20) + byte[](lk) + byte[](0x20) + byte[](sk) + lists + byte[](0x20) + byte[](tl)
            + byte[](0x20) + byte[](ts) + byte[](0x08) + byte[](0 as byte[8]);
        require(tx.outputs[partOut].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(cPre + st + cSuf)));
        require(OpOutputCovenantId(partOut) != zero32());
        require(tx.outputs[partOut].value >= quoteOf(n, bs - bl, 0) + carrier);

        int spend = quoteOf(n, myRate + tip, 0) + carrier;
        if (left > 0) {
            require(OpCovOutputCount(selfId) == 1);
            int c = OpCovOutputIdx(selfId, 0);
            require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(
                rs.slice(0, LEFT_AT) + byte[](left as byte[8]) + rs.slice(LEFT_AT + 8, this.bytecodeSize)
            )));
            require(tx.outputs[c].value >= tx.inputs[self].value - spend);
        } else {
            require(OpCovOutputCount(selfId) == 0);
            require(tx.outputs[self].scriptPubKey == byte[](new ScriptPubKeyP2PK(ownerKey)));
            require(tx.outputs[self].value >= tx.inputs[self].value - spend);
        }
    }

    // Cancel. The owner's SIGHASH_ALL signature covers every output.
    entry cancel(sig s) {
        byte[] sb = byte[](s);
        require(sb.length == 65);
        require(sb[64] == SIGHASH_ALL);
        require(checkSig(s, ownerKey));
    }

    // Refund. Due at the earliest of expiryDaa and 90 days idle. The whole escrow goes to the owner at output i,
    // and nothing stays bound to this covenant id.
    entry refund() {
        int self = this.activeInputIndex;
        int idleEnd = OpTxInputDaaScore(self) + MAX_IDLE;
        if (expiryDaa < idleEnd) { idleEnd = expiryDaa; }
        require(tx.daa >= idleEnd);
        byte[32] selfId = OpInputCovenantId(self);
        require(OpCovInputCount(selfId) == 1);
        require(OpCovOutputCount(selfId) == 0);
        require(tx.outputs[self].scriptPubKey == byte[](new ScriptPubKeyP2PK(ownerKey)));
        require(tx.outputs[self].value >= tx.inputs[self].value);
    }
}
