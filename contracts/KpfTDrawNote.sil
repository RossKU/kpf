pragma silverscript ^0.1.0;

// A draw (kind 5 of KpfTChange) is stated on a shard by its owner: 40 bytes, an amount and a price a row. It is
// within the rule when the claimer is the shard's owner, the amount is above zero, each row that has a market has a
// price above zero and within the market's limit, the shard is not called, the amount is of coins it holds, and
// its equity then (what it holds, and what its net units are worth at those prices, less what its legs were
// entered at) is at least its requirement at its upper level: the maintenance rate of the worth of every row's net
// units and the rate on the gross (half the maintenance rate less three times the tolerance) of the worth of every
// row's gross units, each counted the tolerance more. A dispute names one point:
//   point 0        the end: the rule above, and the outputs (the shard holding the amount less, the amount to its
//                  owner): KpfTShardEnd computes it over the four rows
//   point r, 1..4  the price of row r is within the tolerance of the committee's (KpfTShardPrice, one citation; a
//                  row with no market, and a point beyond the fourth, are answered right)
// And whatever was disputed or not: a note to the shard that landed before the statement and is not applied ends it
// (KpfTDrawNote): what the shard holds and what its rows say is not what it will, once the note is applied.
//
// KpfTDrawNote: anyone ends a stated draw (disputed at a point or not) by a note to its shard that landed before
// the statement and is not applied: the note stands at places 1 and 2 of `who` and goes on as it is; the shard
// again; the claimer's bond is lost, half to whoever shows the note, half in this script's copy; a disputer has its
// bond back. A note counts only where it is of an account whose side B is the shard's owner (no other is ever
// applied), and a deposit does not (it only adds). Whatever such a note there is, its owner saw it coming: a leg
// enters by the owner's own signature, and a leg's leaving and what is owed are written by a statement that waited
// its dispute period.
//   end(who, ageb, slotLen, fixed, moving, t0, arg, outs, bond, claimer, window, late, held, disputed, dkey, point,
//       kind, legs, key, amount, rkey)                                                                anyone.
// (The legs of a note that legs left are shown, one to six, and their chain is the note's: a note whose chain
// nobody opens would be applied by nothing, and would end every draw. Review 54, F87.)
contract KpfTDrawNote(int init_version) {
    int version = init_version;

    // What every operation leaves in the copy it used, for whoever the prices are from (KpfTSweep, KpfTPay).
    int constant ORACLE_FEE = 200000;
    int constant STATE_AT = 2;
    int constant CHANGE_TAG = 10;
    int constant POINT_TAG = 11;
    int constant NOTE_TAG = 12;
    // The least a note holds.
    int constant NOTE_MIN = 20000000;
    // The lateness of a statement that stands again after a point of it was answered right: it was held to its time
    // when it was disputed, and is not held to it again.
    int constant LATE_AGAIN = 499999999999;

    function p33(byte[32] h) : byte[] {
        return byte[](0x20) + byte[](h);
    }

    function i9(int c) : byte[] {
        return byte[](0x08) + byte[](c as byte[8]);
    }

    function slotOf(int j, int slotLen) : byte[] {
        require(j >= 0);
        require(j < tx.inputs.length);
        require(j != this.activeInputIndex);
        int len = OpTxInputScriptSigLen(j);
        require(slotLen > STATE_AT + 32);
        require(slotLen <= len);
        byte[] rs = OpTxInputScriptSigSubstr(j, len - slotLen, len);
        require(tx.inputs[j].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        return rs;
    }

    entry end(byte[24] who, byte[8] ageb, int slotLen, byte[32] fixed, byte[171] moving, int t0, byte[32] arg, byte[32] outs, int bond, byte[32] claimer, int window, int late, int held, int disputed, byte[32] dkey, int point, int kind, byte[] legs, byte[32] key, int amount, byte[32] rkey) {
        require(version == 1);
        require(int(ageb) >= 0);
        int j = int(byte[8](who.slice(0, 8)));
        int n = int(byte[8](who.slice(8, 16)));
        require(who.slice(16, 24) == who.slice(8, 16));
        require(n != j);
        byte[] rs = slotOf(j, slotLen);
        byte[] ns = slotOf(n, slotLen);
        byte[] mv = byte[](moving);
        byte[32] position = blake2b(p33(fixed) + mv);
        byte[32] c0 = blake2b(i9(CHANGE_TAG) + p33(position) + i9(5) + i9(t0) + p33(arg) + p33(outs) + i9(bond) + p33(claimer) + i9(window) + i9(late) + i9(held));
        require(disputed == 0 || disputed == 1);
        if (disputed == 1) {
            c0 = blake2b(i9(POINT_TAG) + p33(c0) + p33(dkey) + i9(point));
        }
        require(c0 == byte[32](rs.slice(STATE_AT, STATE_AT + 32)));
        // The note: to this shard, one that changes what it is asked or what it holds for the worse and is applied
        // (a leg's, or what a user is owed, of an account whose side B is the owner), and landed before the
        // statement.
        if (kind == 6 || kind == 7) {
            // A note that legs left a covered account (kind 6: the chain of the legs stands where a market's name
            // would, and what the shard is asked where an amount does), whatever it asks: until it is applied the
            // books have legs that are gone, and what they lost reads as the shard's. Or a note of the rest (kind
            // 7): what the shard owes and its books do not say.
            if (kind == 6) {
                int k = legs.length / 111;
                require(k >= 1);
                require(k <= 6);
                require(legs.length == 111 * k);
                byte[32] g = byte[32](byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]));
                for (i, 0, 6, 6) {
                    if (i < k) {
                        g = blake2b(byte[](g) + legs.slice(111 * i, 111 * i + 111));
                    }
                }
                require(blake2b(i9(NOTE_TAG) + mv.slice(138, 171) + i9(6) + p33(g) + p33(key) + i9(amount)) == byte[32](ns.slice(STATE_AT, STATE_AT + 32)));
            } else {
                require(legs.length == 0);
                // (A note of the rest the shard counted: one of more than it owes was never counted, is paid
                // by nothing, and ends no draw. Review 55, F96.)
                require(int(byte[8](mv.slice(76, 84))) >= amount);
                require(blake2b(i9(NOTE_TAG) + mv.slice(138, 171) + i9(7) + p33(key) + i9(amount)) == byte[32](ns.slice(STATE_AT, STATE_AT + 32)));
            }
        } else {
            // A note that a leg of a covered account was marked (kind 13: the leg as it was and its new entry, 119
            // bytes, stand where the legs do), where it is one the shard applies: it asks what the leg gained
            // between its two entries (KpfTMarkNote). Until it is applied the shard holds coins that are asked of
            // it (review 60, F108). (No other note is written to a shard.)
            require(kind == 13);
            require(legs.length == 119);
            require(amount > 0);
            byte[] mz = byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]);
            byte[] mlg = legs.slice(0, 111);
            int msc = int(byte[8](mlg.slice(67, 75)));
            int msz = int(byte[8](mlg.slice(85, 93)));
            int mdir = int(byte[8](mlg.slice(94, 102)));
            int me = int(byte[8](mlg.slice(103, 111)));
            int mne = int(byte[8](legs.slice(111, 119)));
            require(mdir == 1 || mdir == 2);
            require(msc > 0);
            require(msz > 0);
            require(me > 0);
            require(mne > 0);
            int mdlt = (msz / msc) * mne + (msz % msc) * (mne / msc) + ((msz % msc) * (mne % msc)) / msc - ((msz / msc) * me + (msz % msc) * (me / msc) + ((msz % msc) * (me % msc)) / msc);
            if (mdir != 1) { mdlt = 0 - mdlt; }
            require(amount == mdlt);
            require(blake2b(i9(NOTE_TAG) + mv.slice(138, 171) + i9(13) + p33(blake2b(mz + mlg)) + byte[](0x08) + legs.slice(111, 119) + p33(key) + i9(amount)) == byte[32](ns.slice(STATE_AT, STATE_AT + 32)));
        }
        require(OpTxInputDaaScore(n) < OpTxInputDaaScore(j));
        byte[32] id = OpInputCovenantId(j);
        require(OpInputCovenantId(n) == id);
        require(OpCovInputCount(id) == 2);
        require(OpCovOutputCount(id) == 2);
        int c = OpCovOutputIdx(id, 0);
        int c1 = OpCovOutputIdx(id, 1);
        int v = tx.inputs[j].value;
        require(bond > 0);
        require(v >= bond + disputed * bond);
        require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, STATE_AT) + byte[](position) + rs.slice(STATE_AT + 32, slotLen))));
        require(tx.outputs[c].value >= v - bond - disputed * bond);
        require(tx.outputs[c1].scriptPubKey == tx.inputs[n].scriptPubKey);
        require(tx.outputs[c1].value >= tx.inputs[n].value);
        int half = bond / 2;
        int m = tx.outputs.length - 1 - 4 * j;
        require(m - disputed >= tx.inputs.length);
        if (disputed == 1) {
            require(tx.outputs[m - 1].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(dkey))));
            require(tx.outputs[m - 1].value >= bond);
        }
        if (half > 0) {
            require(tx.outputs[m].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(rkey))));
            require(tx.outputs[m].value >= half);
        }
        int self = this.activeInputIndex;
        byte[32] lib = OpInputCovenantId(self);
        require(tx.outputs[self].scriptPubKey == tx.inputs[self].scriptPubKey);
        require(OpOutputCovenantId(self) == lib);
        require(tx.outputs[self].value >= tx.inputs[self].value + ORACLE_FEE + bond - half);
        require(OpCovOutputCount(lib) == OpCovInputCount(lib));
    }

    // The copy lets go of what gathered in it: a script of the library names it at a place, as an object is named
    // (KpfSlot.go asks no more), and answers for the rest. Only KpfTSweep's entry passes with a copy at a place it
    // names (every other entry holds what it names to the hash of an object's state), and it asks that the copy goes
    // on as it is, under the library's id, with what a copy keeps.
    entry release(int l, int k) {
        int self = this.activeInputIndex;
        require(k >= 0);
        require(k <= 2);
        // (An input that is not there has no id: the engine refuses the index.)
        require(OpInputCovenantId(l) == OpInputCovenantId(self));
        require(OpTxInputScriptSigSubstr(l, 0, 1) == byte[](0x18));
        require(OpTxInputScriptSigSubstr(l, 1 + 8 * k, 9 + 8 * k) == byte[](self as byte[8]));
    }
}
