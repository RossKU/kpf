pragma silverscript ^0.1.0;

// KpfTCure: the cure of a liquidation.
//   cure(..., fee, add, bond, lkey, state, s)   the side liquidated signs and adds `add` to its margin: the position
//       again with that margin, and the liquidator's bond back. state 0: a claim nobody disputed, once it is half a
//       dispute period old; state 2: a proved one, at any time. A disputed claim is not cured. Signed, so that a liquidator
//       cannot end its own false claim by a cure of a sompi.
//
// A liquidation in the thin family is declared, as a close is: a liquidator (anyone) states that at the prices of a
// signed price the side `side` of a position is below its maintenance, with its fee and with what a cure must add, and posts
// a bond. The side liquidated cures until the claim is settled; anyone settles it after the dispute period; a dispute asks the
// liquidator for the proof (the arithmetic of KpfCrossC's liquidation, on the price notes), and a proved claim waits
// a dispute period again before it is settled, so that no dispute takes the cure's time away. States: a claim
// `liqHash(...)`, a disputed claim `blake2b(push(claim) + push(disputer))`, a proved claim
// `blake2b(int 1 + push(claim))`.
contract KpfTCure(int init_version) {
    int version = init_version;

    // What every operation leaves in the copy it used, for whoever the prices are from (KpfTSweep, KpfTPay).
    int constant ORACLE_FEE = 200000;

    byte constant SIGHASH_ALL = 0x01;
    int constant SIDE_A = 1;
    int constant SIDE_B = 2;
    int constant BPS = 10000;
    int constant STATE_AT = 2;
    int constant LOCK_TIME_THRESHOLD = 500000000000;
    int constant MARGIN_MAX = 1152921504606846975;
    int constant AKEY_AT = 1;
    int constant BKEY_AT = 34;
    int constant AMARGIN_AT = 67;
    int constant BMARGIN_AT = 76;
    int constant LATE_AT = 94;
    int constant DISPUTE_AT = 103;
    int constant BOND_AT = 112;

    function p33(byte[32] h) : byte[] {
        return byte[](0x20) + byte[](h);
    }

    function i9(int c) : byte[] {
        return byte[](0x08) + byte[](c as byte[8]);
    }

    function iAt(byte[] b, int at) : int {
        return int(byte[8](b.slice(at, at + 8)));
    }

    function slotOf(int j, int slotLen) : byte[] {
        require(j >= 0);
        require(j < tx.inputs.length);
        require(j != this.activeInputIndex);
        int len = OpTxInputScriptSigLen(j);
        require(slotLen > STATE_AT + 32);
        require(slotLen <= len);
        byte[] rs = OpTxInputScriptSigSubstr(j, len - slotLen, len);
        require(tx.inputs[j].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        return rs;
    }

    function claimHash(byte[32] position, int side, int t0, int a1, int a2, int amount, int bond) : byte[32] {
        return blake2b(p33(position) + i9(side) + i9(t0) + i9(a1) + i9(a2) + i9(amount) + i9(bond));
    }

    // The single output of the object's id: its own script with another state's hash, holding at least v.
    function becomes(int j, byte[] rs, int slotLen, byte[32] h, int v) {
        byte[32] id = OpInputCovenantId(j);
        require(OpCovInputCount(id) == 1);
        require(OpCovOutputCount(id) == 1);
        int c = OpCovOutputIdx(id, 0);
        require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, STATE_AT) + byte[](h) + rs.slice(STATE_AT + 32, slotLen))));
        require(tx.outputs[c].value >= v);
    }

    function goesOn() {
        int self = this.activeInputIndex;
        byte[32] lib = OpInputCovenantId(self);
        require(tx.outputs[self].scriptPubKey == tx.inputs[self].scriptPubKey);
        require(OpOutputCovenantId(self) == lib);
        require(tx.outputs[self].value >= tx.inputs[self].value + ORACLE_FEE);
        require(OpCovOutputCount(lib) == OpCovInputCount(lib));
    }

    // A liquidation claim's state hash: the position, the side liquidated, the signed price and its prices, the liquidator's
    // fee, what a cure adds, the bond, and the liquidator's key.
    function liqHash(byte[32] position, int side, int t0, int a1, int a2, int fee, int add, int bond, byte[32] lkey) : byte[32] {
        return blake2b(p33(position) + i9(side) + i9(t0) + i9(a1) + i9(a2) + i9(fee) + i9(add) + i9(bond) + p33(lkey));
    }

    entry cure(byte[24] who, byte[8] ageb, int slotLen, byte[32] fixed, byte[138] moving, int side, int t0, int a1, int a2, int fee, int add, int bond, byte[32] lkey, int state, sig s) {
        require(version == 1);
        int j = int(byte[8](who.slice(0, 8)));
        // The places this script does not read name the object it does: an object named at a place nobody reads would
        // be spent under no rule.
        require(who.slice(8, 16) == who.slice(0, 8));
        require(who.slice(16, 24) == who.slice(0, 8));
        byte[] rs = slotOf(j, slotLen);
        byte[] mv = byte[](moving);
        byte[32] position = blake2b(p33(fixed) + mv);
        byte[32] st = byte[32](rs.slice(STATE_AT, STATE_AT + 32));
        byte[32] h0 = liqHash(position, side, t0, a1, a2, fee, add, bond, lkey);
        // A claim nobody disputed is cured once it has stood half a dispute period: a claim that could be cured at once could
        // be made and cured by its own side, again and again, for nothing. Standing, it is open to a dispute, and a
        // disputed claim is not cured: its liquidator proves it (and then the side cures) or loses its bond.
        if (state == 0) {
            require(h0 == st);
            require(int(ageb) >= iAt(mv, DISPUTE_AT) / 2);
        } else {
            require(state == 2);
            require(blake2b(i9(1) + p33(h0)) == st);
            require(int(ageb) >= 0);
        }
        int at = AMARGIN_AT;
        pubkey k = pubkey(byte[32](mv.slice(AKEY_AT, AKEY_AT + 32)));
        if (side != SIDE_A) {
            at = BMARGIN_AT;
            k = pubkey(byte[32](mv.slice(BKEY_AT, BKEY_AT + 32)));
        }
        byte[] sb = byte[](s);
        require(sb.length == 65);
        require(sb[64] == SIGHASH_ALL);
        require(checkSig(s, k));
        int m2 = iAt(mv, at) + add;
        require(m2 <= MARGIN_MAX);
        byte[] nv = mv.slice(0, at) + byte[](m2 as byte[8]) + mv.slice(at + 8, 138);
        int v = tx.inputs[j].value;
        require(bond >= 0);
        require(v >= bond);
        becomes(j, rs, slotLen, blake2b(p33(fixed) + nv), v - bond + add);
        // The liquidator's bond back, at this object's place from the end.
        if (bond > 0) {
            int m = tx.outputs.length - 1 - 2 * j;
            require(m >= tx.inputs.length);
            require(tx.outputs[m].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(lkey))));
            require(tx.outputs[m].value >= bond);
        }
        goesOn();
    }

    // The copy lets go of what gathered in it: a script of the library names it at a place, as an object is named
    // (KpfSlot.go asks no more), and answers for the rest. Only KpfTSweep's entry passes with a copy at a place it
    // names (every other entry holds what it names to the hash of an object's state), and it asks that the copy goes
    // on as it is, under the library's id, with what a copy keeps.
    entry release(int l, int k) {
        int self = this.activeInputIndex;
        require(k >= 0);
        require(k <= 2);
        // (An input that is not there has no id: the engine refuses the index.)
        require(OpInputCovenantId(l) == OpInputCovenantId(self));
        require(OpTxInputScriptSigSubstr(l, 0, 1) == byte[](0x18));
        require(OpTxInputScriptSigSubstr(l, 1 + 8 * k, 9 + 8 * k) == byte[](self as byte[8]));
    }
}
