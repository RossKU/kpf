pragma silverscript ^0.1.0;

// KpfCommittee: the staked committee that signs the prices of committee markets (docs/DESIGN-COMMITTEE.md 2). One
// covenant lineage (its covenant id is the committee id) holds every member's stake; its epoch tables (KpfEpochTable, one epoch's
// copy of the member table) and its exits (KpfExit, a stake on its way out) carry the same id.
//
// State (redeem bytes from 1): the parameters epochDaa, exitDaa, minMemberStake, quorumBps, spreadBps, minTotal, epoch tables,
// epochTableValue; from, the start of the current epoch; members, 15 x (x-only key 32, weight 8) in one 600-byte push. A member is empty
// iff its weight is 0. The committee's value is at least the sum of the weights, which every entry checks of what it writes.
//
// Epochs are [from + kE, from + (k + 1)E), fixed by arithmetic: a script reads no clock, only lower bounds on the
// present. A change of the table (join, topUp, leave) takes effect with the next roll, whose epoch tables copy the table as
// it stands; the epoch tables of the current epoch are not touched, so a member that left or was outbid can sign until the
// current epoch ends at from + E, and its exit is released exitDaa after that.
//
// Entries (each continues the committee as the first output of its id, every parameter kept):
//   join(i, key, amount, ePre, eSuf)   anyone: amount >= minMemberStake. Member i empty: it becomes (key, amount), value +
//                     amount. Member i taken: no member is empty, no member is lighter, and amount >= weight + weight / 20;
//                     the holder's stake leaves as a KpfExit (the second output of the id) released at from + E + U
//   topUp(i, amount)  anyone: a taken member's weight and the value grow by amount (at least 1 KAS)
//   leave(i, s, ePre, eSuf)   the member's key (SIGHASH_ALL): the member is empty, its stake a KpfExit as above
//   roll(m, tPre, tSuf)   anyone, m >= 1, tx.daa >= from + mE: from becomes from + mE; `epoch tables` KpfEpochTables of the new
//                     epoch are written (the outputs of the id after the first), each with the table as it stands, its
//                     sum, the window [from', from' + E) and the quorum, each holding at least epochTableValue; the sum is
//                     at least minTotal and at most this UTXO's value
// join, topUp and leave need this UTXO to be REST_DAA old (CSV); roll does not. So after every change of the table
// there are REST_DAA blocks in which only a roll can spend the committee: nobody keeps an epoch from starting by
// respending the committee on every block (review C1, C1-F5).
//   forfeit(i, market, t0, p1, s1, p2, s2)   anyone: member i's key signed two different prices for one time of one
//                     market (two data signatures over the two signed price digests). The member is empty; a tenth of its stake
//                     is the sender's, the rest is burned (the output at this input's mirror index M - 1 - i). A
//                     member that has a hold keeps the tenth (at least 1 KAS) under its holds instead, and the sender
//                     gets nothing
//   charge(market, t0, p, s, i, payKey, k, cPre, cSuf)   anyone, with the bond: member i's key signed that time. A
//                     KpfCharge is written at output k under a fresh covenant id, which joins the member's holds. The
//                     member goes on signing; its stake is not withdrawn while it has a hold, wherever it goes
//   slash(c, i, a, later)   the charge at input c is one of member i's holds and the judge refuted the signed price: the member
//                     loses its stake, up to the total the judge's NO side had at risk; a tenth of that and the
//                     charge's bond to the charge's payKey at output c, the rest burned at this input's mirror index
//   clear(c, i, a, later)   the charge at input c is one of member i's holds and was upheld (its bond to the charged
//                     key at output c) or lapsed (its bond burned at output c): the hold ends
// There is no vote: the table is the largest bids, and a member changes hands only to a larger stake.
// DESIGN: a member that signs a false price is judged by a stake apart from the members' (KpfStake under the committee's
// judge block): a quorum of members cannot rule on itself. A charge does not suspend the member (anyone could then
// silence a committee for a bond); it holds the stake. The holds of a member are one hash, zero for none and
// blake2b(holds || id) for each charge added, so a member can be charged for any number of signed prices at once and a charge
// nobody contests cannot shield it from another; a charge is shown to be among them, and taken out, with the value
// before it (`a`) and the ids added after it (`later`, at most eight).
// DESIGN: a member signs one price a signed price. Two signed prices for one time let a claimant choose, and they are a proof
// anyone can check on chain without a judge: both signatures, the member's key, one time. The sender's share is whoever
// lands the transaction: the proof is public once shown, so a miner can take the share; the member is slashed either way.
// A member that was slashed stays in the epoch tables of the epoch (a copy cannot be recalled) until the epoch ends.
// DESIGN: a taken member is outbid only when no member is empty and by at least a twentieth more, so a newcomer uses free
// room first and two bidders cannot pass a member back and forth for a sompi each time.
// DESIGN: the exit time is the time a false signed price can be charged in: a stake stays under the committee's id for exitDaa
// after the last signed price its member could sign, and for as long as it has a hold.
contract KpfCommittee(
    byte[32] EPOCH_TABLE_TPL,
    byte[32] EXIT_TPL,
    byte[32] CHARGE_TPL,
    int CHARGE_PRE,
    int CHARGE_SUF,
    int init_epochDaa,
    int init_exitDaa,
    int init_minMemberStake,
    int init_quorumBps,
    int init_spreadBps,
    int init_minTotal,
    int init_epochTables,
    int init_epochTableValue,
    int init_from,
    byte[600] init_members,
    byte[480] init_holds,
    byte[87] init_judge,
    int init_chargeBond,
    int init_chargeDaa
) {
    int epochDaa = init_epochDaa;        // E
    int exitDaa = init_exitDaa;          // U
    int minMemberStake = init_minMemberStake;          // the least stake of a member
    int quorumBps = init_quorumBps;      // the share of the total weight a price needs
    int spreadBps = init_spreadBps;      // how far a signed price may lie from the price it attests
    int minTotal = init_minTotal;        // no epoch table is written below this total
    int epochTables = init_epochTables;          // epoch tables per epoch
    int epochTableValue = init_epochTableValue;  // the least value of an epoch table
    int from = init_from;                // * the start of the current epoch
    byte[600] members = init_members;        // * the table
    byte[480] holds = init_holds;        // * the charges each member's stake is held for (32 bytes a member)
    byte[87] judge = init_judge;         // the judge block of this committee's charges, byte for byte a KpfStake's
    int chargeBond = init_chargeBond;    // what a charge costs its author unless the judge refutes the signed price
    int chargeDaa = init_chargeDaa;      // how long a charge waits for a contest

    byte constant SIGHASH_ALL = 0x01;
    int constant N = 15;
    int constant BPS = 10000;
    int constant CSV_LIMIT = 4294967296;
    int constant LOCK_TIME_THRESHOLD = 500000000000;
    int constant KAS = 100000000;
    int constant MEMBER_MAX = 250000000000000000;
    int constant TOTAL_MAX = 4000000000000000000;
    int constant MAX_EPOCH_TABLES = 6;
    // An output under a covenant id costs about 4 x 10^12 / value grams of storage mass (KIP-9): six epoch tables of 1 KAS
    // are 240,000 grams of a block's 500,000; four of 0.2 KAS were 800,000, a roll nobody could mine (live run 3).
    int constant EPOCH_TABLE_MIN = 100000000;
    int constant EPOCH_TABLE_MAX = 10000000000;
    int constant EPOCH_MIN = 100;
    int constant SPREAD_MAX = 1000;
    int constant REST_DAA = 20;
    // A slashed member: the sender keeps a tenth, the rest goes to the burn script (P2SH of OP_RETURN, as KpfStake).
    int constant REWARD_DIV = 10;
    int constant BURN_DUST = 2000000;
    byte[32] constant BURN = byte[32](0xd379e50f3e2203f9a92584916335bb7cd014b237ceaa8b36f1d3d80d0cc88b32);
    int constant ROLL_MAX = 1048576;
    int constant MAX_OUTPUTS = 8;
    int constant DEPTH = 8;
    // Redeem offsets (the state starts at byte 1): the payload of `from` [74..82), the push of the table [82..685)
    // with its payload from 85, the push of the holds [685..1168) with its payload from 688, the judge block and the
    // charge parameters [1168..1275), the end of the state 1275.
    int constant FROM_AT = 74;
    int constant TABLE_AT = 82;
    int constant MEMBERS_AT = 85;
    int constant TABLE_END = 685;
    int constant HOLDS_AT = 688;
    int constant JUDGE_AT = 1168;
    int constant STATE_END = 1275;
    // KpfCharge: its state length, the statuses, and offsets within its state (redeem offset - 1).
    int constant CHARGE_STATE_LEN = 284;
    int constant CHARGE_NO_AT = 10;
    int constant CHARGE_ATSTAKE_AT = 169;
    int constant CHARGE_PENDING = 1;
    int constant CHARGE_UPHELD = 3;
    int constant CHARGE_REFUTED = 4;
    int constant CHARGE_LAPSED = 5;
    int constant CHARGE_STAKEKEY_AT = 52;
    int constant CHARGE_PAYKEY_AT = 85;

    function ownRs() : byte[] {
        int self = this.activeInputIndex;
        int len = OpTxInputScriptSigLen(self);
        return OpTxInputScriptSigSubstr(self, len - this.bytecodeSize, len);
    }

    function i9(int c) : byte[] {
        return byte[](0x08) + byte[](c as byte[8]);
    }

    function zero32() : byte[32] {
        byte[] z8 = byte[](0 as byte[8]);
        return byte[32](z8 + z8 + z8 + z8);
    }

    function holdOf(int i) : byte[32] {
        return byte[32](holds.slice(32 * i, 32 * i + 32));
    }

    // The holds with member i's replaced.
    function withHold(int i, byte[32] h) : byte[] {
        return holds.slice(0, 32 * i) + byte[](h) + holds.slice(32 * i + 32, 480);
    }

    // As KpfPair.tplState.
    function tplState(int idx, int pre, int stLen, int suf, byte[32] tpl) : byte[] {
        int sz = pre + stLen + suf;
        int base = OpTxInputScriptSigLen(idx) - sz;
        byte[] rs = OpTxInputScriptSigSubstr(idx, base, base + sz);
        require(tx.inputs[idx].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        require(blake3(byte[](pre as byte[8]) + rs.slice(0, pre) + byte[](suf as byte[8]) + rs.slice(pre + stLen, sz)) == tpl);
        return rs.slice(pre, pre + stLen);
    }

    // As KpfPairO.fresh: the output `out` starts a new lineage.
    function fresh(int out) : byte[32] {
        byte[32] id = OpOutputCovenantId(out);
        require(id != zero32());
        require(OpCovInputCount(id) == 0);
        require(tx.outputs.length <= MAX_OUTPUTS);
        for (j, 0, tx.outputs.length, MAX_OUTPUTS) {
            if (j != out) {
                require(OpOutputCovenantId(j) != id);
            }
        }
        return id;
    }

    // The holds h with the ids of `later` added in order (a zero id is none).
    function fold(byte[32] h, byte[256] later) : byte[32] {
        byte[32] x = h;
        for (j, 0, DEPTH, DEPTH) {
            byte[] id = later.slice(32 * j, 32 * j + 32);
            if (id != byte[](zero32())) {
                x = blake2b(byte[](x) + id);
            }
        }
        return x;
    }

    // The charge at input c, shown to be among member i's holds: its state, and the holds without it.
    function held(int c, int i, byte[32] a, byte[256] later) : (byte[], byte[32]) {
        require(c >= 0);
        require(c < tx.inputs.length);
        require(c != this.activeInputIndex);
        require(i >= 0);
        require(i < N);
        byte[32] cid = OpInputCovenantId(c);
        require(cid != zero32());
        byte[] st = tplState(c, CHARGE_PRE, CHARGE_STATE_LEN, CHARGE_SUF, CHARGE_TPL);
        require(fold(blake2b(byte[](a) + byte[](cid)), later) == holdOf(i));
        return (st, fold(a, later));
    }

    function weightOf(int i) : int {
        return int(byte[8](members.slice(40 * i + 32, 40 * i + 40)));
    }

    // The table with member i replaced.
    function withMember(int i, byte[32] key, int w) : byte[] {
        return members.slice(0, 40 * i) + byte[](key) + byte[](w as byte[8]) + members.slice(40 * i + 40, 600);
    }

    // The sum of a table's weights, each within [0, MEMBER_MAX].
    function sumOf(byte[] t) : int {
        int total = 0;
        for (i, 0, N, N) {
            int wi = int(byte[8](t.slice(40 * i + 32, 40 * i + 40)));
            require(wi >= 0);
            require(wi <= MEMBER_MAX);
            total = total + wi;
        }
        return total;
    }

    // The committee's continuation with the epoch start nf and the table t: the first output of the id, every parameter
    // kept, holding at least v, which backs every weight of t.
    // DESIGN: review C2 (C2-F5): only roll compared the value with the table, so a committee that did not begin empty (a
    // state a genesis can write: a member of 100 KAS over a UTXO of 1 KAS) accepted a newcomer's stake and paid it out as
    // the forged member's exit. Every entry now writes a table its value covers, so such a committee accepts nothing.
    function cont(int nf, byte[] t, byte[] hs, int v) {
        require(sumOf(t) <= v);
        require(hs.length == 480);
        int self = this.activeInputIndex;
        byte[] rs = ownRs();
        int c = OpCovOutputIdx(OpInputCovenantId(self), 0);
        require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, FROM_AT) + byte[](nf as byte[8])
            + rs.slice(FROM_AT + 8, MEMBERS_AT) + t + rs.slice(TABLE_END, HOLDS_AT) + hs + rs.slice(JUDGE_AT, this.bytecodeSize))));
        require(tx.outputs[c].value >= v);
    }

    // The stake w of `key` leaves as a KpfExit, the second output of the id, released exitDaa after this epoch ends.
    function exit(int i, int w, byte[] ePre, byte[] eSuf) {
        byte[] key = members.slice(40 * i, 40 * i + 32);
        require(blake3(byte[](ePre.length as byte[8]) + ePre + byte[](eSuf.length as byte[8]) + eSuf) == EXIT_TPL);
        int rel = from + epochDaa + exitDaa;
        require(rel >= 0);
        require(rel < LOCK_TIME_THRESHOLD);
        int e = OpCovOutputIdx(OpInputCovenantId(this.activeInputIndex), 1);
        require(tx.outputs[e].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(ePre + byte[](0x20) + key + i9(w) + i9(rel) + byte[](0x20)
            + byte[](holdOf(i)) + ownRs().slice(JUDGE_AT, STATE_END) + eSuf)));
        require(tx.outputs[e].value >= w);
    }

    function checkParams() {
        require(epochDaa >= EPOCH_MIN);
        require(epochDaa < CSV_LIMIT);
        require(exitDaa >= 0);
        require(exitDaa < CSV_LIMIT);
        require(minMemberStake >= KAS);
        require(minMemberStake <= MEMBER_MAX);
        require(quorumBps > BPS / 2);
        require(quorumBps <= BPS);
        require(spreadBps >= 0);
        require(spreadBps <= SPREAD_MAX);
        require(minTotal >= minMemberStake);
        require(minTotal <= TOTAL_MAX);
        require(epochTables >= 1);
        require(epochTables <= MAX_EPOCH_TABLES);
        require(epochTableValue >= EPOCH_TABLE_MIN);
        require(epochTableValue <= EPOCH_TABLE_MAX);
        checkCharge();
    }

    // The charge parameters, and the judge block's form (seven canonical pushes; what they say is the judge's own
    // check: a block no stake accepts gets no contest).
    function checkCharge() {
        require(chargeBond >= KAS);
        require(chargeBond <= MEMBER_MAX);
        require(chargeDaa > 0);
        require(chargeDaa < CSV_LIMIT);
        byte[] jb = byte[](judge);
        require(jb.slice(0, 1) == byte[](0x20));
        for (q, 0, 6, 6) {
            require(jb.slice(33 + 9 * q, 34 + 9 * q) == byte[](0x08));
        }
    }

    // What a refuted charge takes of a stake w (review C5, C5-F1): at most the NO total of its verdict. When less than
    // 1 KAS would be left: all of w if this is the stake's last hold, and all but 1 KAS while it has others (`rest`).
    // DESIGN: review C6 (C6-F1): a slash that took a stake whole left its other charges nothing to settle against (their
    // bonds locked for ever), and a member arranged that by charging and contesting itself with a stake of its own size.
    // 1 KAS stays under the other holds, and the last charge takes it.
    function takeOf(int w, byte[] st, byte[32] rest) : int {
        int no = int(byte[8](st.slice(CHARGE_NO_AT, CHARGE_NO_AT + 8)));
        require(no > 0);
        int s = w;
        if (no < w) {
            s = no;
        }
        if (w - s < KAS) {
            s = w;
            if (rest != zero32()) {
                s = w - KAS;
                if (s < 0) {
                    s = 0;
                }
            }
        }
        return s;
    }

    // The author's share of a slash that takes s: a tenth of the lesser of the stake as it was charged and the NO
    // total, and no more than s.
    function rewardOf(int s, byte[] st) : int {
        int no = int(byte[8](st.slice(CHARGE_NO_AT, CHARGE_NO_AT + 8)));
        int cap = int(byte[8](st.slice(CHARGE_ATSTAKE_AT, CHARGE_ATSTAKE_AT + 8)));
        require(cap > 0);
        if (no < cap) {
            cap = no;
        }
        int r = cap / REWARD_DIV;
        if (r > s) {
            r = s;
        }
        return r;
    }

    // `v` at the burn script, at this input's mirror index.
    function burnAt(int v) {
        if (v >= BURN_DUST) {
            int j = tx.outputs.length - 1 - this.activeInputIndex;
            require(j >= tx.inputs.length);
            require(tx.outputs[j].scriptPubKey == byte[](new ScriptPubKeyP2SH(BURN)));
            require(tx.outputs[j].value >= v);
        }
    }

    // What a held stake w keeps when it is shown two prices (review C5, C5-F2): a tenth, at least 1 KAS.
    function keptOf(int w) : int {
        int rem = w / REWARD_DIV;
        if (rem < KAS) {
            rem = KAS;
        }
        require(w > rem);
        return rem;
    }

    entry join(int i, byte[32] key, int amount, byte[] ePre, byte[] eSuf) {
        int self = this.activeInputIndex;
        byte[32] rid = OpInputCovenantId(self);
        require(OpCovInputCount(rid) == 1);
        require(this.ageDaa >= REST_DAA);
        require(i >= 0);
        require(i < N);
        require(amount >= minMemberStake);
        require(amount <= MEMBER_MAX);
        int w = weightOf(i);
        require(w >= 0);
        int v = tx.inputs[self].value + amount;
        if (w > 0) {
            // No member is empty and none is lighter: an empty member is used first, the least bid goes first.
            for (j, 0, N, N) {
                require(int(byte[8](members.slice(40 * j + 32, 40 * j + 40))) >= w);
            }
            require(amount >= w + w / 20);
            require(OpCovOutputCount(rid) == 2);
            exit(i, w, ePre, eSuf);
            v = v - w;
        } else {
            require(OpCovOutputCount(rid) == 1);
        }
        cont(from, withMember(i, key, amount), withHold(i, zero32()), v);
    }

    entry topUp(int i, int amount) {
        int self = this.activeInputIndex;
        byte[32] rid = OpInputCovenantId(self);
        require(OpCovInputCount(rid) == 1);
        require(OpCovOutputCount(rid) == 1);
        require(this.ageDaa >= REST_DAA);
        require(i >= 0);
        require(i < N);
        require(amount >= KAS);
        int w = weightOf(i);
        require(w > 0);
        require(amount <= MEMBER_MAX - w);
        cont(from, withMember(i, byte[32](members.slice(40 * i, 40 * i + 32)), w + amount), byte[](holds), tx.inputs[self].value + amount);
    }

    entry leave(int i, sig s, byte[] ePre, byte[] eSuf) {
        int self = this.activeInputIndex;
        byte[32] rid = OpInputCovenantId(self);
        require(OpCovInputCount(rid) == 1);
        require(OpCovOutputCount(rid) == 2);
        require(this.ageDaa >= REST_DAA);
        require(i >= 0);
        require(i < N);
        int w = weightOf(i);
        require(w > 0);
        byte[] sb = byte[](s);
        require(sb.length == 65);
        require(sb[64] == SIGHASH_ALL);
        require(checkSig(s, pubkey(members.slice(40 * i, 40 * i + 32))));
        exit(i, w, ePre, eSuf);
        cont(from, withMember(i, zero32(), 0), withHold(i, zero32()), tx.inputs[self].value - w);
    }

    // Forfeit: member i signed two prices for one time. No rest is needed and no key: the proof is the two signatures.
    entry forfeit(int i, byte[32] market, byte[8] t0b, byte[8] p1b, datasig s1, byte[8] p2b, datasig s2) {
        int self = this.activeInputIndex;
        byte[32] rid = OpInputCovenantId(self);
        require(OpCovInputCount(rid) == 1);
        require(OpCovOutputCount(rid) == 1);
        require(i >= 0);
        require(i < N);
        int w = weightOf(i);
        require(w > 0);
        require(int(p1b) != int(p2b));
        // "kpf-tick-1", the committee id, the market id, t0: what KpfEpochTable.attest checks a member's signature over.
        byte[] head = byte[](0x6b70662d7469636b2d31) + byte[](rid) + byte[](market) + byte[](t0b);
        require(checkMsgSig(s1, blake2b(head + byte[](p1b)), pubkey(members.slice(40 * i, 40 * i + 32))));
        require(checkMsgSig(s2, blake2b(head + byte[](p2b)), pubkey(members.slice(40 * i, 40 * i + 32))));
        if (holdOf(i) == zero32()) {
            cont(from, withMember(i, zero32(), 0), byte[](holds), tx.inputs[self].value - w);
            burnAt(w - w / REWARD_DIV);
        } else {
            // DESIGN: review C5 (C5-F2): a charged member forfeited itself, took the sender's tenth and left its charges
            // with nothing to settle against (their bonds locked for ever). A held member keeps a tenth under its holds,
            // nobody is paid, and the charges are settled against what is left.
            int rem = keptOf(w);
            cont(from, withMember(i, byte[32](members.slice(40 * i, 40 * i + 32)), rem), byte[](holds), tx.inputs[self].value - (w - rem));
            burnAt(w - rem);
        }
    }

    // Charge: member i's key signed the signed price (market, t0, p). No rest is needed. The charge is written under a fresh id
    // with the committee's judge block and charge parameters, and the member's holds take the id.
    entry charge(byte[32] market, byte[8] t0b, byte[8] pb, datasig s, int i, byte[32] payKey, int k, byte[] cPre, byte[] cSuf) {
        int self = this.activeInputIndex;
        byte[32] rid = OpInputCovenantId(self);
        require(OpCovInputCount(rid) == 1);
        require(OpCovOutputCount(rid) == 1);
        checkCharge();
        require(i >= 0);
        require(i < N);
        require(weightOf(i) > 0);
        require(checkMsgSig(s, blake2b(byte[](0x6b70662d7469636b2d31) + byte[](rid) + byte[](market) + byte[](t0b) + byte[](pb)),
            pubkey(members.slice(40 * i, 40 * i + 32))));
        require(k >= 0);
        byte[32] cid = fresh(k);
        require(blake3(byte[](cPre.length as byte[8]) + cPre + byte[](cSuf.length as byte[8]) + cSuf) == CHARGE_TPL);
        byte[] rs = ownRs();
        require(tx.outputs[k].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(cPre + i9(1) + i9(0) + byte[](0x20) + byte[](rid)
            + byte[](0x20) + members.slice(40 * i, 40 * i + 32) + byte[](0x20) + byte[](payKey) + byte[](0x20) + byte[](market)
            + byte[](0x08) + byte[](t0b) + byte[](0x08) + byte[](pb) + i9(weightOf(i)) + rs.slice(JUDGE_AT, STATE_END) + cSuf)));
        require(tx.outputs[k].value >= chargeBond);
        cont(from, byte[](members), withHold(i, blake2b(byte[](holdOf(i)) + byte[](cid))), tx.inputs[self].value);
    }

    // Slash: the judge refuted a signed price member i's key signed. The member loses what the verdict takes (takeOf); the
    // author's share and the charge's bond are the charge's payKey's (a verdict has an author; a proof has none). A
    // member that keeps stake keeps its other holds; one that is emptied leaves them behind.
    entry slash(byte[8] cb, byte[8] ib, byte[32] a, byte[256] later) {
        int self = this.activeInputIndex;
        byte[32] rid = OpInputCovenantId(self);
        require(OpCovInputCount(rid) == 1);
        require(OpCovOutputCount(rid) == 1);
        int c = int(cb);
        int i = int(ib);
        (byte[] st, byte[32] rest) = held(c, i, a, later);
        require(st.slice(0, 9) == i9(CHARGE_REFUTED));
        int w = weightOf(i);
        require(w > 0);
        int s = takeOf(w, st, rest);
        int reward = rewardOf(s, st);
        if (s == w) {
            cont(from, withMember(i, zero32(), 0), withHold(i, zero32()), tx.inputs[self].value - s);
        } else {
            cont(from, withMember(i, byte[32](members.slice(40 * i, 40 * i + 32)), w - s), withHold(i, rest), tx.inputs[self].value - s);
        }
        require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(st.slice(CHARGE_PAYKEY_AT, CHARGE_PAYKEY_AT + 32)))));
        require(tx.outputs[c].value >= tx.inputs[c].value + reward);
        burnAt(s - reward);
    }

    // Clear: the charge was upheld (the signed price was true: its bond is the charged key's), or it lapsed (nobody contested
    // it within chargeDaa, or the contest came after that: its bond is burned).
    // DESIGN: a lapsed charge's bond is burned, not paid to the charged key: a member could otherwise hold its own
    // stake for nothing and keep a real charge waiting behind eight of its own.
    entry clear(byte[8] cb, byte[8] ib, byte[32] a, byte[256] later) {
        int self = this.activeInputIndex;
        byte[32] rid = OpInputCovenantId(self);
        require(OpCovInputCount(rid) == 1);
        require(OpCovOutputCount(rid) == 1);
        int c = int(cb);
        int i = int(ib);
        (byte[] st, byte[32] rest) = held(c, i, a, later);
        if (st.slice(0, 9) == i9(CHARGE_UPHELD)) {
            require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(st.slice(CHARGE_STAKEKEY_AT, CHARGE_STAKEKEY_AT + 32)))));
        } else {
            if (st.slice(0, 9) == i9(CHARGE_PENDING)) {
                int born = OpTxInputDaaScore(c);
                require(born >= 0);
                require(chargeDaa > 0);
                require(chargeDaa < CSV_LIMIT);
                require(born + chargeDaa < LOCK_TIME_THRESHOLD);
                require(tx.daa >= born + chargeDaa);
            } else {
                require(st.slice(0, 9) == i9(CHARGE_LAPSED));
            }
            require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SH(BURN)));
        }
        require(tx.outputs[c].value >= tx.inputs[c].value);
        cont(from, byte[](members), withHold(i, rest), tx.inputs[self].value);
    }

    entry roll(int m, byte[] tPre, byte[] tSuf) {
        int self = this.activeInputIndex;
        byte[32] rid = OpInputCovenantId(self);
        require(OpCovInputCount(rid) == 1);
        checkParams();
        require(m >= 1);
        require(m <= ROLL_MAX);
        int nf = from + m * epochDaa;
        require(nf >= 0);
        require(nf + epochDaa < LOCK_TIME_THRESHOLD);
        require(tx.daa >= nf);
        int total = sumOf(byte[](members));
        require(total >= minTotal);
        require(OpCovOutputCount(rid) == epochTables + 1);
        cont(nf, byte[](members), byte[](holds), tx.inputs[self].value);
        require(blake3(byte[](tPre.length as byte[8]) + tPre + byte[](tSuf.length as byte[8]) + tSuf) == EPOCH_TABLE_TPL);
        byte[] rs = ownRs();
        byte[] spk = byte[](new ScriptPubKeyP2SHFromRedeemScript(tPre + rs.slice(TABLE_AT, TABLE_END) + i9(total) + i9(nf) + i9(nf + epochDaa)
            + i9(quorumBps) + i9(spreadBps) + tSuf));
        for (k, 1, epochTables + 1, MAX_EPOCH_TABLES) {
            int o = OpCovOutputIdx(rid, k);
            require(tx.outputs[o].scriptPubKey == spk);
            require(tx.outputs[o].value >= epochTableValue);
        }
    }
}
