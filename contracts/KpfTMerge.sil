pragma silverscript ^0.1.0;

// KpfTMerge: two positions of the same two parties, in the same market and of the same terms, become one, as a script
// under the library's id. Orders pair users one to one, a fill at a time, so two users can come to hold several
// positions with each other; one position is one close, one liquidation on the whole, one object to watch.
//   merge(who, ageb, slotLen, st, moving, n2, e2, a2, b2, aq2, bq2)
//       anyone. who: the first position and the second. The first is shown whole (st, moving); the second differs
//       from it only in its leg's size and entry, its two margins and what each party asks of the other's, which are given: the same terms, market,
//       keys in the same places, both long for their A, and no second leg. The position written, under their
//       id, has the two sizes together, the two margins of each party together, and for its entry the
//       largest price at which the whole is worth no more than the two legs were at theirs; the few sompi by which
//       that lowers A's cost are moved from A's margin to B's, so that at every price each party is owed what the two
//       positions owed it, to the rounding of a quote. Whoever sends the transaction keeps MERGE_TIP of what the two
//       held (half from each margin): it paid the fee, and nobody else is paid to tidy.
//       Nobody signs. The two positions are of one id, the library's registry: a position is there only by its two
//       parties' signatures (an opening) or from two orders their owners signed (a match, inside both limits), so
//       neither is one a party wrote alone at an entry of its choice (review T1b, F11: merged, such a position's
//       false gain was paid from the other's real margin).
contract KpfTMerge(int MERGE_TIP, int init_version) {
    int version = init_version;

    // What every operation leaves in the copy it used, for whoever the prices are from (KpfTSweep, KpfTPay).
    int constant ORACLE_FEE = 200000;

    int constant DIR_LONG = 1;
    int constant STATE_AT = 2;
    int constant LATE_AT = 94;
    int constant DISPUTE_AT = 103;
    int constant SIZE_MAX = 2000000000;
    // In the fixed part: the leg's scale and price limit, its size, side and entry as pushed ints from LEG_AT, the
    // second leg from LEG2_AT (its size an int at LEG2_SIZE_AT).
    int constant SCALE_AT = 157;
    int constant PMAX_AT = 166;
    int constant LEG_AT = 174;
    int constant LEG2_AT = 201;
    int constant LEG2_SIZE_AT = 286;
    // In the moving part: the two keys, then the two margins as pushed ints, then the four values.
    int constant KEYS_END = 66;
    int constant TAIL_AT = 84;
    int constant ASK_AT = 120;

    function p33(byte[32] h) : byte[] {
        return byte[](0x20) + byte[](h);
    }

    function i9(int c) : byte[] {
        return byte[](0x08) + byte[](c as byte[8]);
    }

    function iAt(byte[] b, int at) : int {
        return int(byte[8](b.slice(at, at + 8)));
    }

    function slotOf(int j, int slotLen) : byte[] {
        require(j >= 0);
        require(j < tx.inputs.length);
        require(j != this.activeInputIndex);
        int len = OpTxInputScriptSigLen(j);
        require(slotLen > STATE_AT + 32);
        require(slotLen <= len);
        byte[] rs = OpTxInputScriptSigSubstr(j, len - slotLen, len);
        require(tx.inputs[j].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        return rs;
    }

    function claimHash(byte[32] position, int side, int t0, int a1, int a2, int amount, int bond) : byte[32] {
        return blake2b(p33(position) + i9(side) + i9(t0) + i9(a1) + i9(a2) + i9(amount) + i9(bond));
    }

    // The single output of the object's id: its own script with another state's hash, holding at least v.
    function becomes(int j, byte[] rs, int slotLen, byte[32] h, int v) {
        byte[32] id = OpInputCovenantId(j);
        require(OpCovInputCount(id) == 1);
        require(OpCovOutputCount(id) == 1);
        int c = OpCovOutputIdx(id, 0);
        require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, STATE_AT) + byte[](h) + rs.slice(STATE_AT + 32, slotLen))));
        require(tx.outputs[c].value >= v);
    }

    function goesOn() {
        int self = this.activeInputIndex;
        byte[32] lib = OpInputCovenantId(self);
        require(tx.outputs[self].scriptPubKey == tx.inputs[self].scriptPubKey);
        require(OpOutputCovenantId(self) == lib);
        require(tx.outputs[self].value >= tx.inputs[self].value + ORACLE_FEE);
        require(OpCovOutputCount(lib) == OpCovInputCount(lib));
    }

    function quoteAt(int n, int sc, int r) : int {
        int m = n % sc;
        int q = n / sc;
        int v = q * r + m * (r / sc) + (m * (r % sc)) / sc;
        return v;
    }

    entry merge(byte[24] who, byte[8] ageb, int slotLen, byte[312] st, byte[138] moving, int n2, int e2, int a2, int b2, int aq2, int bq2) {
        require(version == 1);
        require(int(ageb) >= 0);
        int j1 = int(byte[8](who.slice(0, 8)));
        int j2 = int(byte[8](who.slice(8, 16)));
        // The third place names the second object: an object named at a place nobody reads would be spent under no rule.
        require(who.slice(16, 24) == who.slice(8, 16));
        require(j1 != j2);
        byte[] r1 = slotOf(j1, slotLen);
        byte[] r2 = slotOf(j2, slotLen);
        byte[] t = byte[](st);
        byte[] mv = byte[](moving);
        require(blake2b(p33(blake2b(t)) + mv) == byte[32](r1.slice(STATE_AT, STATE_AT + 32)));
        int n1 = int(byte[8](t.slice(LEG_AT + 1, LEG_AT + 9)));
        int e1 = int(byte[8](t.slice(LEG_AT + 19, LEG_AT + 27)));
        int scale = int(byte[8](t.slice(SCALE_AT, SCALE_AT + 8)));
        int pm = int(byte[8](t.slice(PMAX_AT, PMAX_AT + 8)));
        // Both positions are long for their A and have one leg.
        require(int(byte[8](t.slice(LEG_AT + 10, LEG_AT + 18))) == DIR_LONG);
        require(int(byte[8](t.slice(LEG2_SIZE_AT, LEG2_SIZE_AT + 8))) == 0);
        require(n2 > 0);
        require(e2 >= 0);
        require(e2 <= pm);
        require(a2 > 0);
        require(b2 > 0);
        // The second position: the first's state with its own size, entry and margins.
        byte[] t2 = t.slice(0, LEG_AT) + i9(n2) + i9(DIR_LONG) + i9(e2) + t.slice(LEG2_AT, 312);
        require(aq2 >= 0);
        require(bq2 >= 0);
        byte[] mv2 = mv.slice(0, KEYS_END) + i9(a2) + i9(b2) + mv.slice(TAIL_AT, ASK_AT) + i9(aq2) + i9(bq2);
        require(blake2b(p33(blake2b(t2)) + mv2) == byte[32](r2.slice(STATE_AT, STATE_AT + 32)));
        int n = n1 + n2;
        require(n <= SIZE_MAX);
        // What A paid for the two legs, and the entry of the whole: the largest price at which it is worth no more.
        int c = quoteAt(n1, scale, e1) + quoteAt(n2, scale, e2);
        int e = (c / n) * scale + ((c % n) * scale) / n;
        require(e <= pm);
        int delta = c - quoteAt(n, scale, e);
        require(delta >= 0);
        int half = MERGE_TIP / 2;
        int am = int(byte[8](mv.slice(KEYS_END + 1, KEYS_END + 9))) + a2 - delta - half;
        int bm = int(byte[8](mv.slice(KEYS_END + 10, KEYS_END + 18))) + b2 + delta - (MERGE_TIP - half);
        require(am > 0);
        require(bm > 0);
        byte[] nt = t.slice(0, LEG_AT) + i9(n) + i9(DIR_LONG) + i9(e) + t.slice(LEG2_AT, 312);
        // What each party asks of the other's margin: the two positions' together.
        int aq = int(byte[8](mv.slice(ASK_AT + 1, ASK_AT + 9))) + aq2;
        int bq = int(byte[8](mv.slice(ASK_AT + 10, ASK_AT + 18))) + bq2;
        byte[] nm = mv.slice(0, KEYS_END) + i9(am) + i9(bm) + mv.slice(TAIL_AT, ASK_AT) + i9(aq) + i9(bq);
        // The two are of one id, and one position goes on under it.
        byte[32] id1 = OpInputCovenantId(j1);
        require(OpInputCovenantId(j2) == id1);
        require(OpCovInputCount(id1) == 2);
        require(OpCovOutputCount(id1) == 1);
        int o = OpCovOutputIdx(id1, 0);
        require(tx.outputs[o].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(r1.slice(0, STATE_AT) + byte[](blake2b(p33(blake2b(nt)) + nm)) + r1.slice(STATE_AT + 32, slotLen))));
        require(tx.inputs[j1].value + tx.inputs[j2].value >= MERGE_TIP);
        require(tx.outputs[o].value >= tx.inputs[j1].value + tx.inputs[j2].value - MERGE_TIP);
        goesOn();
    }

    // The copy lets go of what gathered in it: a script of the library names it at a place, as an object is named
    // (KpfSlot.go asks no more), and answers for the rest. Only KpfTSweep's entry passes with a copy at a place it
    // names (every other entry holds what it names to the hash of an object's state), and it asks that the copy goes
    // on as it is, under the library's id, with what a copy keeps.
    entry release(int l, int k) {
        int self = this.activeInputIndex;
        require(k >= 0);
        require(k <= 2);
        // (An input that is not there has no id: the engine refuses the index.)
        require(OpInputCovenantId(l) == OpInputCovenantId(self));
        require(OpTxInputScriptSigSubstr(l, 0, 1) == byte[](0x18));
        require(OpTxInputScriptSigSubstr(l, 1 + 8 * k, 9 + 8 * k) == byte[](self as byte[8]));
    }
}
