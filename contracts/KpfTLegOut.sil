pragma silverscript ^0.1.0;

// The forms (docs/ARCHITECTURE-CLEARING.md, 6a). A covered account and a shard are accounts (4b) whose moving part
// is 171 bytes: the 138 of a position, then push(sid).
//   moving     push(A key) push(B key) A margin, B margin, lease, lateness, dispute period, bond rate, A's ask, B's ask
//              (each 8 bytes after 0x08), then push(sid)
//   account    fixed = blake2b(terms(90) + push(root)), root the chain of its legs (32 zero bytes: no leg);
//              side B is the clearing party, sid the shard that covers it
//   shard      fixed = blake2b(terms(90) + push(blake2b(rows))), rows four of 102 bytes: push(market)
//              push(committee) scale, price limit, net, gross; A is its owner, B's key 32 zero bytes, A's margin
//              what it holds, sid its own id
//   note       an object whose state is blake2b(push8(12) + push(sid) + push8(kind) + head(84) + push8(net) +
//              push8(gross) + push(key) + push8(amount)); head: a leg's market, committee, scale and price limit as
//              they stand in it (for kind 4: push(side B's key) and nothing more); kinds: 1 a leg entered, 2 a leg
//              left, 3 a deposit, 4 what a user is owed
// The scripts of a position are typed for 138 bytes and do not open these: a covered account is opened, changed and
// ended by scripts that write the note of what they did.
//
// KpfTLegOut: a leg leaves a covered account at once, by its two parties' signatures: what KpfTLegAdd does, the
// other way. The chain before the leg and the legs after it are shown, and the chain is hashed again without it; the
// other legs and their entries stay as they are. No price is read: what the leg is worth to either party is what
// the two sign for. What A owes for it, `payb`, moves from A's margin to B's; what B owes for it B pays A from its
// own coins, by an output of the transaction A signs: B's margin in the account does not fall here, by any amount
// (what the clearing party has in an account leaves it by its shard alone, or to the user by a statement at a
// price that is answered for: review 36, F60). A may take `take` out of its margin in the same transaction (below
// zero: it adds), and B may add `addb`. The note that the leg left is written for the
// account's shard, as a statement's settlement writes it: the row of the leg's kind and market, B's units, the size.
// This is the way out that waits for nobody: the clearing party's program signs or does not, as it chooses; a user
// it does not answer leaves by its own statement (kind 4 of KpfTChange) after the dispute period, or hands its side
// over (KpfTHand). Up to six legs stand after the leg that leaves.
//   out(who, ageb, slotLen, terms, prev, leg, after, moving, payb, take, addb, sa, sb)    both sign.
//   outputs under the account's id: the account, then the note.
contract KpfTLegOut(int init_version) {
    int version = init_version;

    int constant DIR_LONG = 1;
    int constant DIR_SHORT = 2;
    int constant OPTION_TAG = 13;
    int constant FUTURES_TAG = 14;
    int constant SCALE_MAX = 1000000000;
    // What every operation leaves in the copy it used, for whoever the prices are from (KpfTSweep, KpfTPay).
    int constant ORACLE_FEE = 200000;
    int constant STATE_AT = 2;
    int constant NOTE_TAG = 12;
    // The least a note holds.
    int constant NOTE_MIN = 20000000;
    // What a shard's output holds beside what the shard holds for its users: a shard that paid everything out is
    // still an output a block takes.
    int constant SHARD_CARRIER = 100000000;
    int constant MARGIN_MAX = 1152921504606846975;
    byte constant SIGHASH_ALL = 0x01;

    function p33(byte[32] h) : byte[] {
        return byte[](0x20) + byte[](h);
    }

    function i9(int c) : byte[] {
        return byte[](0x08) + byte[](c as byte[8]);
    }

    function slotOf(int j, int slotLen) : byte[] {
        require(j >= 0);
        require(j < tx.inputs.length);
        require(j != this.activeInputIndex);
        int len = OpTxInputScriptSigLen(j);
        require(slotLen > STATE_AT + 32);
        require(slotLen <= len);
        byte[] rs = OpTxInputScriptSigSubstr(j, len - slotLen, len);
        require(tx.inputs[j].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        return rs;
    }

    function goesOn() {
        int self = this.activeInputIndex;
        byte[32] lib = OpInputCovenantId(self);
        require(tx.outputs[self].scriptPubKey == tx.inputs[self].scriptPubKey);
        require(OpOutputCovenantId(self) == lib);
        require(tx.outputs[self].value >= tx.inputs[self].value + ORACLE_FEE);
        require(OpCovOutputCount(lib) == OpCovInputCount(lib));
    }

    function signedBy(sig s, byte[] key) {
        byte[] sb = byte[](s);
        require(sb.length == 65);
        require(sb[64] == SIGHASH_ALL);
        require(checkSig(s, pubkey(byte[32](key))));
    }

    entry out(byte[24] who, byte[8] ageb, int slotLen, byte[90] terms, byte[32] prev, byte[111] leg, byte[] after, byte[171] moving, int payb, int take, int addb, sig sa, sig sb) {
        require(version == 1);
        require(int(ageb) >= 0);
        int j = int(byte[8](who.slice(0, 8)));
        require(who.slice(8, 16) == who.slice(0, 8));
        require(who.slice(16, 24) == who.slice(0, 8));
        byte[] rs = slotOf(j, slotLen);
        byte[] mv = byte[](moving);
        byte[] tb = byte[](terms);
        byte[] lg = byte[](leg);
        // The account's chain is the chain before the leg, the leg, and the legs after it; without the leg, the
        // chain before it and the legs after it.
        require(after.length % 111 == 0);
        require(after.length <= 666);
        byte[32] g = blake2b(byte[](prev) + lg);
        byte[32] h = prev;
        for (i, 0, 6, 6) {
            if (i * 111 < after.length) {
                byte[] l2 = after.slice(i * 111, i * 111 + 111);
                g = blake2b(byte[](g) + l2);
                h = blake2b(byte[](h) + l2);
            }
        }
        require(blake2b(p33(blake2b(tb + p33(g))) + mv) == byte[32](rs.slice(STATE_AT, STATE_AT + 32)));
        signedBy(sa, mv.slice(1, 33));
        signedBy(sb, mv.slice(34, 66));
        // The row the leg is counted in and B's units in it, as the leg's row of a trace reads its kind (KpfTStepRow):
        // an option where the direction's place is a number from 3 on whose last three bits are 3 to 6, counted with
        // its size; else a futures leg, the size below zero where A is long.
        int size = int(byte[8](lg.slice(85, 93)));
        int dir = int(byte[8](lg.slice(94, 102)));
        int units = size;
        int tag = FUTURES_TAG;
        int oc = 0;
        if (dir >= 3) {
            if (dir % 8 >= 3) {
                if (dir % 8 <= 6) { oc = 1; }
            }
        }
        if (oc == 1) {
            tag = OPTION_TAG;
        } else {
            if (dir == DIR_LONG) { units = 0 - size; }
        }
        byte[] head = byte[](0x20) + byte[](blake2b(i9(tag) + lg.slice(0, 33))) + lg.slice(33, 84);
        int gross = size;
        if (gross < 0) { gross = 0 - gross; }
        require(addb >= 0);
        require(payb >= 0);
        int am = int(byte[8](mv.slice(67, 75))) - payb - take;
        int bm = int(byte[8](mv.slice(76, 84))) + payb + addb;
        require(am >= 0);
        require(bm >= 0);
        require(am <= MARGIN_MAX);
        require(bm <= MARGIN_MAX);
        byte[32] next = blake2b(p33(blake2b(tb + p33(h))) + mv.slice(0, 67) + byte[](am as byte[8]) + byte[](0x08) + byte[](bm as byte[8]) + mv.slice(84, 171));
        byte[32] note = blake2b(i9(NOTE_TAG) + mv.slice(138, 171) + i9(2) + head + i9(units) + i9(gross) + mv.slice(33, 66) + i9(0));
        byte[32] id = OpInputCovenantId(j);
        require(OpCovInputCount(id) == 1);
        require(OpCovOutputCount(id) == 2);
        int o0 = OpCovOutputIdx(id, 0);
        int o1 = OpCovOutputIdx(id, 1);
        require(tx.outputs[o0].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, STATE_AT) + byte[](next) + rs.slice(STATE_AT + 32, slotLen))));
        require(tx.outputs[o0].value >= tx.inputs[j].value - take + addb);
        require(tx.outputs[o1].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, STATE_AT) + byte[](note) + rs.slice(STATE_AT + 32, slotLen))));
        require(tx.outputs[o1].value >= NOTE_MIN);
        goesOn();
    }

    // The copy lets go of what gathered in it: a script of the library names it at a place, as an object is named
    // (KpfSlot.go asks no more), and answers for the rest. Only KpfTSweep's entry passes with a copy at a place it
    // names (every other entry holds what it names to the hash of an object's state), and it asks that the copy goes
    // on as it is, under the library's id, with what a copy keeps.
    entry release(int l, int k) {
        int self = this.activeInputIndex;
        require(k >= 0);
        require(k <= 2);
        // (An input that is not there has no id: the engine refuses the index.)
        require(OpInputCovenantId(l) == OpInputCovenantId(self));
        require(OpTxInputScriptSigSubstr(l, 0, 1) == byte[](0x18));
        require(OpTxInputScriptSigSubstr(l, 1 + 8 * k, 9 + 8 * k) == byte[](self as byte[8]));
    }
}
