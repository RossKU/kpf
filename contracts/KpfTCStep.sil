pragma silverscript ^0.1.0;

// A step under a call (docs/ARCHITECTURE-CLEARING.md 14.6). A called shard's accounts are stepped by anyone, each
// in one transaction and by no statement: the transaction is shown the call (the object under the shard's id that
// a call writes: it is spent and written again as it is) and spends the account as it stands, or under a
// statement of its own kinds (7 to 9), standing or disputed, that landed at or after the call's time (by the time
// of the output in the chain): that statement is ended, and its bonds go back. A statement that landed before
// the call's time is answered and applied as any, and the account is stepped after.
// Every leg leaves at the call's price for its row (no band: one price for every account). In this order: what the
// account lost, to the shard, out of its coins as far as they go, a note's least staying; the terms' least fee of
// a keeper (no more than a note's least) to whoever steps, out of what is left; the rest to the user. The note
// that the legs left is written as a statement's end writes it (what it asks is what the legs gained, which a
// called shard counts as a claim; or, below zero, what the account paid, which the note holds). Whoever steps adds
// the note's least, and has it back where the note is applied.
// What a block takes decides the payments (an output weighs as the inverse of what it holds, and one under a
// covenant four times a plain one: the note and the call are over half a block): the fee is no output (what the
// transaction leaves is whoever steps's, who funds it); the note's least is the account's own (the one that stays
// in it while it has a leg), and whoever applies the note has it; the bond of a statement the user stated is paid
// with the user's coins, in one output; and a payment of less than a note's least is not asked (it is whoever
// steps's).
//   step(who, ageb, slotLen, terms, legs, at, moving, ctime, body, form, kind, t0, arg, outs, bond, claimer,
//        window, late, held, dkey, point)       anyone; `at`: the call's row of each leg, 8 bytes a leg; form: 0 the
//        account, 1 a statement on it, 2 a statement disputed.
contract KpfTCStep(int init_version) {
    int version = init_version;

    // What every operation leaves in the copy it used, for whoever the prices are from (KpfTSweep, KpfTPay).
    int constant ORACLE_FEE = 200000;
    int constant STATE_AT = 2;
    int constant CHANGE_TAG = 10;
    int constant POINT_TAG = 11;
    int constant NOTE_TAG = 12;
    int constant CALL = 11;
    int constant KEEPER_AT = 37;
    // What is less than this is not paid by an output of its own: beside a note and the call a block takes no smaller.
    int constant PAY_MIN = 20000000;
    int constant LEFT = 6;
    int constant REST = 7;
    // The lateness of a statement that stands again after a point of it was answered right.
    int constant LATE_AGAIN = 499999999999;
    int constant FUTURES_TAG = 14;
    int constant DIR_LONG = 1;
    int constant DIR_SHORT = 2;
    // The least a note holds.
    int constant NOTE_MIN = 20000000;
    // What a shard's output holds beside what the shard holds for its users: a shard that paid everything out is
    // still an output a block takes.
    int constant SHARD_CARRIER = 100000000;
    int constant MARGIN_MAX = 1152921504606846975;
    byte constant SIGHASH_ALL = 0x01;

    function p33(byte[32] h) : byte[] {
        return byte[](0x20) + byte[](h);
    }

    function i9(int c) : byte[] {
        return byte[](0x08) + byte[](c as byte[8]);
    }

    function slotOf(int j, int slotLen) : byte[] {
        require(j >= 0);
        require(j < tx.inputs.length);
        require(j != this.activeInputIndex);
        int len = OpTxInputScriptSigLen(j);
        require(slotLen > STATE_AT + 32);
        require(slotLen <= len);
        byte[] rs = OpTxInputScriptSigSubstr(j, len - slotLen, len);
        require(tx.inputs[j].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        return rs;
    }

    function goesOn() {
        int self = this.activeInputIndex;
        byte[32] lib = OpInputCovenantId(self);
        require(tx.outputs[self].scriptPubKey == tx.inputs[self].scriptPubKey);
        require(OpOutputCovenantId(self) == lib);
        require(tx.outputs[self].value >= tx.inputs[self].value + ORACLE_FEE);
        require(OpCovOutputCount(lib) == OpCovInputCount(lib));
    }

    entry step(byte[24] who, byte[8] ageb, int slotLen, byte[90] terms, byte[] legs, byte[] at, byte[171] moving, int ctime, byte[368] body, int form, int kind, int t0, byte[32] arg, byte[32] outs, int bond, byte[32] claimer, int window, int late, int held, byte[32] dkey, int point) {
        require(version == 1);
        require(int(ageb) >= 0);
        int j = int(byte[8](who.slice(0, 8)));
        int n = int(byte[8](who.slice(8, 16)));
        require(who.slice(16, 24) == who.slice(8, 16));
        require(n != j);
        byte[] rs = slotOf(j, slotLen);
        byte[] ns = slotOf(n, slotLen);
        byte[] mv = byte[](moving);
        byte[] tb = byte[](terms);
        byte[] cb = byte[](body);
        // The call of the account's shard.
        require(blake2b(i9(NOTE_TAG) + mv.slice(138, 171) + i9(CALL) + i9(ctime) + p33(blake2b(cb))) == byte[32](ns.slice(STATE_AT, STATE_AT + 32)));
        // The account's legs, each at the call's price for its row.
        int count = int(byte[8](mv.slice(121, 129)));
        require(count >= 1);
        require(count <= 6);
        require(legs.length == 111 * count);
        require(at.length == 8 * count);
        byte[32] g = byte[32](byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]));
        int gain = 0;
        for (i, 0, 6, 6) {
            if (i < count) {
                byte[] lg = legs.slice(111 * i, 111 * i + 111);
                g = blake2b(byte[](g) + lg);
                int r = int(byte[8](at.slice(8 * i, 8 * i + 8)));
                require(r >= 0);
                require(r <= 3);
                require(cb.slice(84 * r, 84 * r + 84) == byte[](0x20) + byte[](blake2b(i9(FUTURES_TAG) + lg.slice(0, 33))) + lg.slice(33, 84));
                int p = int(byte[8](cb.slice(336 + 8 * r, 344 + 8 * r)));
                int sc = int(byte[8](lg.slice(67, 75)));
                int size = int(byte[8](lg.slice(85, 93)));
                int dir = int(byte[8](lg.slice(94, 102)));
                int e = int(byte[8](lg.slice(103, 111)));
                require(dir == DIR_LONG || dir == DIR_SHORT);
                require(sc > 0);
                require(size > 0);
                require(e > 0);
                require(p >= 0);
                int wp = (size / sc) * p + (size % sc) * (p / sc) + ((size % sc) * (p % sc)) / sc;
                int we = (size / sc) * e + (size % sc) * (e / sc) + ((size % sc) * (e % sc)) / sc;
                if (dir == DIR_LONG) { gain = gain + wp - we; } else { gain = gain + we - wp; }
            }
        }
        byte[32] acct = blake2b(p33(blake2b(tb + p33(g))) + mv);
        byte[32] id = OpInputCovenantId(j);
        require(OpInputCovenantId(n) == id);
        require(OpCovInputCount(id) == 2);
        int v = tx.inputs[j].value;
        require(form >= 0);
        require(form <= 2);
        if (form == 0) {
            require(acct == byte[32](rs.slice(STATE_AT, STATE_AT + 32)));
        } else {
            // A statement of the account's own kinds, of the call's time or after: it is ended. Its own time is at
            // or after the call's; or it stands as it was stated, and landed at or after it. (One that stands
            // again, or is disputed, is an object no older than the answer or the dispute: it is held to its own
            // time. Review 54, F90.)
            require(kind >= 7);
            require(kind <= 9 || kind == 12);
            int after = 0;
            if (t0 >= ctime) { after = 1; }
            if (form == 1 && late < LATE_AGAIN) {
                if (OpTxInputDaaScore(j) >= ctime) { after = 1; }
            }
            require(after == 1);
            require(bond > 0);
            byte[32] c0 = blake2b(i9(CHANGE_TAG) + p33(acct) + i9(kind) + i9(t0) + p33(arg) + p33(outs) + i9(bond) + p33(claimer) + i9(window) + i9(late) + i9(held));
            if (form == 2) {
                c0 = blake2b(i9(POINT_TAG) + p33(c0) + p33(dkey) + i9(point));
            }
            require(c0 == byte[32](rs.slice(STATE_AT, STATE_AT + 32)));
            require(v >= form * bond);
            v = v - form * bond;
        }
        // What the account lost, out of its coins as far as they go, a note's least staying; the fee; the rest.
        int room = int(byte[8](mv.slice(67, 75))) - NOTE_MIN;
        if (room < 0) { room = 0; }
        int pay = 0;
        int asked = gain;
        if (gain < 0) {
            pay = 0 - gain;
            if (pay > room) { pay = room; }
            asked = 0 - pay;
        }
        // (An output that holds less than its account says pays what it holds: review 54, F89.)
        if (pay > v) {
            pay = v;
            asked = 0 - pay;
        }
        int rest = v - pay;
        // The note's least is the account's own, the one that stays in it while it has a leg: whoever steps adds
        // nothing (review 54, F93), but where the output holds less than that.
        int least = NOTE_MIN;
        if (least > rest) { least = rest; }
        rest = rest - least;
        int fee = int(byte[8](tb.slice(KEEPER_AT, KEEPER_AT + 8)));
        if (fee < 0) { fee = 0; }
        if (fee > NOTE_MIN) { fee = NOTE_MIN; }
        if (fee > rest) { fee = rest; }
        int user = rest - fee;
        // The bonds of a statement that is ended: the claimer's with the user's coins where the user stated it.
        int cbond = 0;
        int dbond = 0;
        if (form >= 1) {
            if (byte[](claimer) == mv.slice(1, 33)) { user = user + bond; } else { cbond = bond; }
        }
        if (form == 2) { dbond = bond; }
        if (user < PAY_MIN) { user = 0; }
        if (cbond < PAY_MIN) { cbond = 0; }
        if (dbond < PAY_MIN) { dbond = 0; }
        // The call again, as it is; and the note that the legs left.
        require(OpCovOutputCount(id) == 2);
        int c = OpCovOutputIdx(id, 0);
        int c1 = OpCovOutputIdx(id, 1);
        require(tx.outputs[c].scriptPubKey == tx.inputs[n].scriptPubKey);
        require(tx.outputs[c].value >= tx.inputs[n].value);
        require(tx.outputs[c1].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(ns.slice(0, STATE_AT) + byte[](blake2b(i9(NOTE_TAG) + mv.slice(138, 171) + i9(LEFT) + p33(g) + mv.slice(0, 33) + i9(asked))) + ns.slice(STATE_AT + 32, slotLen))));
        require(tx.outputs[c1].value >= NOTE_MIN + pay);
        // The payments, from the end: the user, and the bonds of a statement that is ended.
        int m = tx.outputs.length - 1 - 4 * j;
        if (user > 0) {
            require(m >= tx.inputs.length);
            require(tx.outputs[m].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(byte[32](mv.slice(1, 33))))));
            require(tx.outputs[m].value >= user);
            m = m - 1;
        }
        if (cbond > 0) {
            require(m >= tx.inputs.length);
            require(tx.outputs[m].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(claimer))));
            require(tx.outputs[m].value >= cbond);
            m = m - 1;
        }
        if (dbond > 0) {
            require(m >= tx.inputs.length);
            require(tx.outputs[m].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(dkey))));
            require(tx.outputs[m].value >= dbond);
        }
        goesOn();
    }

    // The copy lets go of what gathered in it: a script of the library names it at a place, as an object is named
    // (KpfSlot.go asks no more), and answers for the rest. Only KpfTSweep's entry passes with a copy at a place it
    // names (every other entry holds what it names to the hash of an object's state), and it asks that the copy goes
    // on as it is, under the library's id, with what a copy keeps.
    entry release(int l, int k) {
        int self = this.activeInputIndex;
        require(k >= 0);
        require(k <= 2);
        // (An input that is not there has no id: the engine refuses the index.)
        require(OpInputCovenantId(l) == OpInputCovenantId(self));
        require(OpTxInputScriptSigSubstr(l, 0, 1) == byte[](0x18));
        require(OpTxInputScriptSigSubstr(l, 1 + 8 * k, 9 + 8 * k) == byte[](self as byte[8]));
    }
}
