pragma silverscript ^0.1.0;

// An account is a position of any number of legs (docs/ARCHITECTURE-CLEARING.md, 4b). Its state is a position's, with
// another fixed part: the hash of the ten terms (90 bytes) and the root of its legs, a chain
//   g_0 = 32 zero bytes, g_i = blake2b(g_(i-1) + leg_i)      (a leg: 111 bytes, as a position's)
// so that every script that is shown a position's fixed part as its hash serves an account as it is (KpfTOpen,
// KpfTAdd, KpfTBoth, KpfTChange and what applies, disputes or ends a statement).
// A take on an account (kind 2 of KpfTChange) is stated with a trace, a row of 112 bytes a leg:
//   a_i    the price stated for leg i
//   G_i    A's gain over the legs 1..i at the prices stated
//   WA_i   the worth side A is asked the maintenance of: the futures legs', and the underlyings' of the options A wrote
//   WB_i   the same of side B
//   EA_i   what side A keeps whole beside its maintenance: what the options it holds were counted at (it cannot lose
//          more than that by them, and does not take it out before it exercises)
//   EB_i   the same of side B
//   g_i    the chain of the legs up to i                          h_i    the same chain with each entry at its a
// and what it states is the side, the amount and the leg left out (0: none), 8 bytes each, then the rows: shown
// whole when it is stated, as every statement is, so that whoever watches has the trace. A step of a
// liquidation (kind 3) is stated the same way: skip is the leg that leaves the account (the second chain passes it
// by), amount the liquidator's fee. Nobody computes the whole: a dispute
// names one point of the trace (KpfTPoint), and the answer is of that point alone:
//   point 2i - 1   row i follows from row i - 1 and the leg (KpfTStepRow)
//   point 2i       the price of row i is within the tolerance of the committee's (KpfTStepPrice, one citation)
//   point 0        the last row is the account's, and the statement keeps its kind's rule (KpfTStepEnd for a take,
//                  KpfTStepLiq for a step of a liquidation)
// A leg is a futures leg or an option on its market, said in its direction's place: 1, A is long; 3 to 6 in the last
// three bits of a number from 3 on, an option whose strike stands above those bits (3 a call A holds, 4 a call A
// wrote, 5 a put A holds, 6 a put A wrote); anything else, A is short. An option's entry is the price it was last
// counted at: its row adds to A's gain what the option is worth if exercised at the price stated less what it was
// worth at its entry (the other way where A wrote it); its underlying's worth is added to the worth of whoever wrote
// it alone, and what it is worth exercised at the price stated to what its holder keeps whole. So a take moves an
// option's gain as it moves a futures leg's, once; the maintenance of the underlying covers whoever wrote it (an
// option moves by no more than its underlying); and its holder is asked no maintenance for it.
//
// KpfTStepLiq: the answer of the point 0 of a step of a liquidation (kind 3) and of a leg that leaves by its party's
// own statement (kind 4: no fee; the claimer is the side's key; the side stands at its maintenance at any price
// within the tolerance, or the other party below its own). On a covered account the outputs carry the note that the
// leg left, and the note of what A is owed where the entries at the prices stated leave it more than the pot: less
// twice the tolerance of the legs' worth, which prices that are only near the committee's could have made.
// For kind 3: Anyone states that `side` stands below
// its maintenance at the prices stated and that the leg `skip` leaves the account, for a fee. The end is right when
// the last row's chain is the account's legs', `skip` is one of them, and, the entries standing at the prices stated
// (A's gain there moved to A's margin, neither margin below zero nor above the pot):
//   - the side's margin is below the maintenance of the worth it is asked it of, counted at the maintenance rate
//     less the tolerance g (the prices are only near the committee's: the side is below at any price within it),
//     and what the options it holds were counted at;
//   - the fee is the liquidation rate of the worth of the leg that leaves, or all the side's margin where that is less;
//   - `outs` is exactly that: the account without that leg, the other entries at the prices stated, the side's margin
//     the fee less, holding the fee less; and the fee to the claimer (where there is one).
// A step takes one leg: whoever liquidates states the next once this one is applied, while the side is still below.
//   answer(who, ageb, slotLen, terms, root, moving, t0, said, outs, bond, claimer, dkey, point,
//          rkey, verdict)                                                                             anyone.
contract KpfTStepLiq(int init_version) {
    int version = init_version;

    int constant SIDE_A = 1;
    int constant SIDE_B = 2;
    int constant BPS = 10000;
    int constant MMR_AT = 10;
    int constant G_AT = 19;
    int constant LIQFEE_AT = 28;
    // What every operation leaves in the copy it used, for whoever the prices are from (KpfTSweep, KpfTPay).
    int constant ORACLE_FEE = 200000;
    int constant STATE_AT = 2;
    int constant CHANGE_TAG = 10;
    int constant POINT_TAG = 11;
    int constant NOTE_TAG = 12;
    // The least a note holds.
    int constant NOTE_MIN = 20000000;
    // The lateness of a statement that stands again after a point of it was answered right: it was held to its time
    // when it was disputed, and is not held to it again.
    int constant LATE_AGAIN = 499999999999;

    function p33(byte[32] h) : byte[] {
        return byte[](0x20) + byte[](h);
    }

    function i9(int c) : byte[] {
        return byte[](0x08) + byte[](c as byte[8]);
    }

    function slotOf(int j, int slotLen) : byte[] {
        require(j >= 0);
        require(j < tx.inputs.length);
        require(j != this.activeInputIndex);
        int len = OpTxInputScriptSigLen(j);
        require(slotLen > STATE_AT + 32);
        require(slotLen <= len);
        byte[] rs = OpTxInputScriptSigSubstr(j, len - slotLen, len);
        require(tx.inputs[j].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        return rs;
    }

    // The answer of a point. The point is right (1), by anyone's answer: the statement stands again (its dispute
    // period begins again; another point of it may be disputed until the last time to dispute; it is not held to
    // its time again), and the disputer's bond is lost: a quarter to the claimer (the last output), a quarter to
    // whoever answered (the one before), half to this script's copy (a claimer that answers its own other key's
    // dispute loses half a bond a round: docs 14.1).
    // The point is wrong (0): the position again, the disputer's bond back (the output before the last) and half of
    // the claimer's to whoever answered (the last). The other half of the bond lost stays in this script's copy.
    function ends(int j, byte[] rs, int slotLen, int verdict, byte[32] c0, byte[32] position, int bond, byte[32] claimer, byte[32] dkey, byte[32] rkey) {
        require(verdict == 0 || verdict == 1);
        require(bond > 0);
        int v = tx.inputs[j].value;
        require(v >= bond + bond);
        int half = bond / 2;
        int kept = bond - half;
        byte[32] id = OpInputCovenantId(j);
        require(OpCovInputCount(id) == 1);
        require(OpCovOutputCount(id) == 1);
        int c = OpCovOutputIdx(id, 0);
        int m = tx.outputs.length - 1 - 4 * j;
        if (verdict == 1) {
            require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, STATE_AT) + byte[](c0) + rs.slice(STATE_AT + 32, slotLen))));
            require(tx.outputs[c].value >= v - bond);
            require(m >= tx.inputs.length);
            // (Two outputs of less than this fit in no transaction: where a quarter is no payable amount the
            // claimer has half, in one output, and nobody is paid for the answer. Review 50, F77.)
            if (bond / 4 >= 5000000) {
                require(m - 1 >= tx.inputs.length);
                half = bond / 4;
                kept = bond - half - half;
                require(tx.outputs[m - 1].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(rkey))));
                require(tx.outputs[m - 1].value >= half);
            }
            rkey = claimer;
        } else {
            require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, STATE_AT) + byte[](position) + rs.slice(STATE_AT + 32, slotLen))));
            require(tx.outputs[c].value >= v - bond - bond);
            require(m - 1 >= tx.inputs.length);
            require(tx.outputs[m - 1].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(dkey))));
            require(tx.outputs[m - 1].value >= bond);
        }
        if (half > 0) {
            require(tx.outputs[m].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(rkey))));
            require(tx.outputs[m].value >= half);
        }
        int self = this.activeInputIndex;
        byte[32] lib = OpInputCovenantId(self);
        require(tx.outputs[self].scriptPubKey == tx.inputs[self].scriptPubKey);
        require(OpOutputCovenantId(self) == lib);
        require(tx.outputs[self].value >= tx.inputs[self].value + ORACLE_FEE + kept);
        require(OpCovOutputCount(lib) == OpCovInputCount(lib));
    }

    entry answer(byte[24] who, byte[8] ageb, int slotLen, byte[90] terms, byte[32] root, byte[] moving, int kind, int t0, byte[] said, byte[32] outs, int bond, byte[32] claimer, int window, int late, int held, byte[32] dkey, int point, int at, byte[32] rkey, int verdict) {
        byte[] mv = moving;
        require(mv.length == 138 || mv.length == 171);
        byte[] tb = byte[](terms);
        byte[32] position = blake2b(p33(blake2b(tb + p33(root))) + mv);
        require(version == 1);
        require(int(ageb) >= 0);
        int j = int(byte[8](who.slice(0, 8)));
        byte[] rs = slotOf(j, slotLen);
        // What was stated, as it was shown: the side, the amount and the leg left out, 8 bytes each; that leg's market
        // (its first 84 bytes) and side B's units in it, for the note of a leg that leaves a covered account; then the
        // trace.
        require(said.length >= 116);
        int side = int(byte[8](said.slice(0, 8)));
        int amount = int(byte[8](said.slice(8, 16)));
        int skip = int(byte[8](said.slice(16, 24)));
        byte[] rows = said.slice(116, said.length);
        byte[] pre = i9(CHANGE_TAG) + p33(position) + i9(kind) + i9(t0) + p33(blake2b(said)) + p33(outs) + i9(bond) + p33(claimer) + i9(window);
        byte[32] c0 = blake2b(pre + i9(late) + i9(held));
        // (A statement that stands again keeps its lateness, beside the mark that it does: the last time to dispute
        // it is counted from its time by it.)
        int again = late;
        if (late < LATE_AGAIN) { again = LATE_AGAIN + late; }
        byte[32] c1 = blake2b(pre + i9(again) + i9(held));
        require(blake2b(i9(POINT_TAG) + p33(c0) + p33(dkey) + i9(point)) == byte[32](rs.slice(STATE_AT, STATE_AT + 32)));
        // The point answered is the one disputed; or any other, where the answer is that it is wrong (a statement
        // with a wrong point is not kept by a dispute of a point nobody can answer).
        require(at == point || verdict == 0);
        int n = rows.length / 112;
        require(rows.length == 112 * n);
        require(at == 0);
        require(who.slice(8, 16) == who.slice(0, 8));
        require(who.slice(16, 24) == who.slice(0, 8));
        byte[] row = byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]);
        if (n >= 1) {
            row = rows.slice(112 * (n - 1), 112 * n);
        }
        // The worth the side is asked the maintenance of and what it keeps whole beside it; and the other side's.
        int worth = int(byte[8](row.slice(16, 24)));
        int extra = int(byte[8](row.slice(32, 40)));
        int worth2 = int(byte[8](row.slice(24, 32)));
        int extra2 = int(byte[8](row.slice(40, 48)));
        int ok = 1;
        if (n < 1) { ok = 0; }
        if (byte[32](row.slice(48, 80)) != root) { ok = 0; }
        if (worth < 0) { ok = 0; }
        if (worth2 < 0) { ok = 0; }
        if (side != SIDE_A) {
            if (side != SIDE_B) { ok = 0; }
            worth = worth2;
            extra = extra2;
            worth2 = int(byte[8](row.slice(16, 24)));
            extra2 = int(byte[8](row.slice(32, 40)));
        }
        // The worth of the leg that leaves: what its row added to either side's worth (a futures leg adds it to
        // both, an option to whoever wrote it).
        int wk = 0;
        if (skip < 1) { ok = 0; }
        if (skip > n) { ok = 0; }
        if (ok == 1) {
            wk = int(byte[8](rows.slice(112 * (skip - 1) + 16, 112 * (skip - 1) + 24)));
            int wk2 = int(byte[8](rows.slice(112 * (skip - 1) + 24, 112 * (skip - 1) + 32)));
            if (skip > 1) {
                wk = wk - int(byte[8](rows.slice(112 * (skip - 2) + 16, 112 * (skip - 2) + 24)));
                wk2 = wk2 - int(byte[8](rows.slice(112 * (skip - 2) + 24, 112 * (skip - 2) + 32)));
            }
            if (wk < 0) { ok = 0; }
            if (wk2 < 0) { ok = 0; }
            if (wk2 > wk) { wk = wk2; }
        }
        require(kind == 3 || kind == 4);
        int pot = int(byte[8](mv.slice(67, 75))) + int(byte[8](mv.slice(76, 84)));
        int am = int(byte[8](mv.slice(67, 75))) + int(byte[8](row.slice(8, 16)));
        // What the pot cannot pay A, the entries standing at the prices stated.
        int owed = 0;
        if (am > pot) {
            owed = am - pot;
            am = pot;
        }
        // And what A's margin cannot pay B.
        int lack = 0;
        if (am < 0) {
            lack = 0 - am;
            am = 0;
        }
        int bm = pot - am;
        int mine = am;
        // What a side keeps whole is what the options it holds were counted at, less what of it the pot could not
        // pay: a side is not below its maintenance for what it was not paid.
        if (side == SIDE_A) {
            extra = extra - owed;
            extra2 = extra2 - lack;
        } else {
            mine = bm;
            extra = extra - lack;
            extra2 = extra2 - owed;
        }
        if (extra < 0) { extra = 0; }
        if (extra2 < 0) { extra2 = 0; }
        // The maintenance of the legs' worth, counted the tolerance less and the tolerance more (the prices are only
        // near the committee's).
        int rate = int(byte[8](tb.slice(MMR_AT, MMR_AT + 8))) - int(byte[8](tb.slice(G_AT, G_AT + 8)));
        if (rate < 0) { rate = 0; }
        int lo = (worth / BPS) * rate + ((worth % BPS) * rate + BPS - 1) / BPS + extra;
        int lo2 = (worth2 / BPS) * rate + ((worth2 % BPS) * rate + BPS - 1) / BPS + extra2;
        // What the shard is asked to pay is what is owed at any price within the tolerance. The prices of a
        // statement are only near the committee's, where a leg entered and here: of the legs' worth, twice the
        // tolerance can be owed to the prices alone, to whoever enters at the one end and leaves at the other
        // (review 40, F65). It is not asked of the shard. (A futures leg is in both sides' worth: counted twice.)
        int band = worth + worth2;
        int g2 = 2 * int(byte[8](tb.slice(G_AT, G_AT + 8)));
        int asked = owed - ((band / BPS) * g2 + ((band % BPS) * g2 + BPS - 1) / BPS);
        if (asked < 0) { asked = 0; }
        int fee = 0;
        if (kind == 3) {
            // A step of a liquidation: the side is below its maintenance at any price within the tolerance.
            if (mine >= lo) { ok = 0; }
            fee = (wk / BPS) * int(byte[8](tb.slice(LIQFEE_AT, LIQFEE_AT + 8))) + ((wk % BPS) * int(byte[8](tb.slice(LIQFEE_AT, LIQFEE_AT + 8)))) / BPS;
            if (fee > mine) { fee = mine; }
        } else {
            // A leg leaves by its party's own statement: the party stands at its maintenance at any price within the
            // tolerance, or the other party below its own (as a close of a position is allowed).
            rate = int(byte[8](tb.slice(MMR_AT, MMR_AT + 8))) + int(byte[8](tb.slice(G_AT, G_AT + 8)));
            byte[] key = mv.slice(1, 33);
            if (side != SIDE_A) { key = mv.slice(34, 66); }
            if (key != byte[](claimer)) { ok = 0; }
            if (mine < (worth / BPS) * rate + ((worth % BPS) * rate + BPS - 1) / BPS + extra) {
                if (pot - mine >= lo2) { ok = 0; }
            }
        }
        if (amount != fee) { ok = 0; }
        if (side == SIDE_A) {
            am = am - fee;
        } else {
            bm = bm - fee;
        }
        if (ok == 1) {
            byte[] due2 = byte[](0x00) + byte[](blake2b(p33(blake2b(tb + byte[](0x20) + row.slice(80, 112))) + mv.slice(0, 67) + byte[](am as byte[8]) + byte[](0x08) + byte[](bm as byte[8]) + mv.slice(84, mv.length))) + byte[]((held - fee) as byte[8]);
            if (fee > 0) {
                due2 = due2 + byte[](0x01) + byte[](claimer) + byte[](fee as byte[8]);
            }
            if (mv.length == 171) {
                // A covered account: the note that the leg left (its market and side B's units, as the statement
                // says them and the leg's row holds them), and the note of what A is owed beyond the pot, which
                // names who owes it (side B's key where a leg's market would stand): a shard pays it only where
                // that is its owner.
                int gross = int(byte[8](said.slice(108, 116)));
                if (gross < 0) { gross = 0 - gross; }
                due2 = due2 + byte[](0x02) + byte[](blake2b(i9(NOTE_TAG) + mv.slice(138, 171) + i9(2) + said.slice(24, 108) + byte[](0x08) + said.slice(108, 116) + i9(gross) + mv.slice(33, 66) + i9(0))) + byte[](NOTE_MIN as byte[8]);
                if (asked > 0) {
                    due2 = due2 + byte[](0x02) + byte[](blake2b(i9(NOTE_TAG) + mv.slice(138, 171) + i9(4) + mv.slice(33, 66) + byte[](0x20) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0x08) + byte[](0 as byte[8]) + byte[](0x08) + byte[](0 as byte[8]) + i9(0) + i9(0) + mv.slice(0, 33) + i9(asked))) + byte[](NOTE_MIN as byte[8]);
                }
            }
            if (blake2b(due2) != outs) { ok = 0; }
        }
        require(ok == verdict);
        ends(j, rs, slotLen, verdict, c1, position, bond, claimer, dkey, rkey);
    }

    // The copy lets go of what gathered in it: a script of the library names it at a place, as an object is named
    // (KpfSlot.go asks no more), and answers for the rest. Only KpfTSweep's entry passes with a copy at a place it
    // names (every other entry holds what it names to the hash of an object's state), and it asks that the copy goes
    // on as it is, under the library's id, with what a copy keeps.
    entry release(int l, int k) {
        int self = this.activeInputIndex;
        require(k >= 0);
        require(k <= 2);
        // (An input that is not there has no id: the engine refuses the index.)
        require(OpInputCovenantId(l) == OpInputCovenantId(self));
        require(OpTxInputScriptSigSubstr(l, 0, 1) == byte[](0x18));
        require(OpTxInputScriptSigSubstr(l, 1 + 8 * k, 9 + 8 * k) == byte[](self as byte[8]));
    }
}
