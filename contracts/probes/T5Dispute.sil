pragma silverscript ^0.1.0;

// T5Dispute (probe): the dispute of a declared claim (T4Declare) and the end of a dispute nobody answered, as a script
// under the library's id. A claim's state is blake2b(push(account) + side, t0, a1, a2, amount, bond); a disputed
// claim's is blake2b(push(that) + push(the disputer's key)).
//   dispute(who, ageb, slotLen, fixed, moving, side, t0, a1, a2, amount, bond, dkey)
//       anyone, with a bond equal to the claimer's: "prove it". Only a claim that landed within lateDaa of its tick
//       (a late one is void without anybody's bond). The claim's UTXO is written again, so its age is the dispute's.
//   lapse(who, ageb, slotLen, fixed, moving, side, t0, a1, a2, amount, bond, dkey)
//       anyone, once the disputed claim is as old as the proof window: nobody proved it. The account is restored with
//       what it held; the disputer has its bond back and half of the claimer's, and the party the claim was
//       made against has the other half.
// A claimer that holds the committee's signatures proves its claim (T5Prove) and takes the disputer's bond; one that
// does not hold them (there were none, or the claim was false) cannot, whatever it declared: fail closed.
contract T5Dispute(int init_version) {
    int version = init_version;

    int constant STATE_AT = 2;
    int constant SIDE_A = 1;
    int constant AKEY_AT = 1;
    int constant BKEY_AT = 34;
    int constant LATE_AT = 94;
    int constant WINDOW_AT = 103;

    function p33(byte[32] h) : byte[] {
        return byte[](0x20) + byte[](h);
    }

    function i9(int c) : byte[] {
        return byte[](0x08) + byte[](c as byte[8]);
    }

    function iAt(byte[] b, int at) : int {
        return int(byte[8](b.slice(at, at + 8)));
    }

    function slotOf(int j, int slotLen) : byte[] {
        require(j >= 0);
        require(j < tx.inputs.length);
        require(j != this.activeInputIndex);
        int len = OpTxInputScriptSigLen(j);
        require(slotLen > STATE_AT + 32);
        require(slotLen <= len);
        byte[] rs = OpTxInputScriptSigSubstr(j, len - slotLen, len);
        require(tx.inputs[j].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        return rs;
    }

    function claimHash(byte[32] acct, int side, int t0, int a1, int a2, int amount, int bond) : byte[32] {
        return blake2b(p33(acct) + i9(side) + i9(t0) + i9(a1) + i9(a2) + i9(amount) + i9(bond));
    }

    // The single output of the object's id: its own script with another state's hash, holding at least v.
    function becomes(int j, byte[] rs, int slotLen, byte[32] h, int v) {
        byte[32] id = OpInputCovenantId(j);
        require(OpCovInputCount(id) == 1);
        require(OpCovOutputCount(id) == 1);
        int c = OpCovOutputIdx(id, 0);
        require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, STATE_AT) + byte[](h) + rs.slice(STATE_AT + 32, slotLen))));
        require(tx.outputs[c].value >= v);
    }

    function goesOn() {
        int self = this.activeInputIndex;
        byte[32] lib = OpInputCovenantId(self);
        require(tx.outputs[self].scriptPubKey == tx.inputs[self].scriptPubKey);
        require(OpOutputCovenantId(self) == lib);
        require(tx.outputs[self].value >= tx.inputs[self].value);
        require(OpCovOutputCount(lib) == OpCovInputCount(lib));
    }

    entry dispute(byte[24] who, byte[8] ageb, int slotLen, byte[32] fixed, byte[138] moving, int side, int t0, int a1, int a2, int amount, int bond, byte[32] dkey) {
        require(version == 1);
        int j = int(byte[8](who.slice(0, 8)));
        // The places this script does not read name the object it does: an object named at a place nobody reads would
        // be spent under no rule.
        require(who.slice(8, 16) == who.slice(0, 8));
        require(who.slice(16, 24) == who.slice(0, 8));
        byte[] rs = slotOf(j, slotLen);
        byte[] mv = byte[](moving);
        byte[32] c0 = claimHash(blake2b(p33(fixed) + mv), side, t0, a1, a2, amount, bond);
        require(c0 == byte[32](rs.slice(STATE_AT, STATE_AT + 32)));
        int landed = OpTxInputDaaScore(j);
        require(landed >= 0);
        require(landed - t0 <= iAt(mv, LATE_AT));
        // A claim that landed before its own tick states a price nobody can have checked: it is ended, as a late one.
        require(landed >= t0);
        require(bond > 0);
        becomes(j, rs, slotLen, blake2b(p33(c0) + p33(dkey)), tx.inputs[j].value + bond);
        require(int(ageb) >= 0);
        goesOn();
    }

    entry lapse(byte[24] who, byte[8] ageb, int slotLen, byte[32] fixed, byte[138] moving, int side, int t0, int a1, int a2, int amount, int bond, byte[32] dkey) {
        require(version == 1);
        int j = int(byte[8](who.slice(0, 8)));
        // The places this script does not read name the object it does: an object named at a place nobody reads would
        // be spent under no rule.
        require(who.slice(8, 16) == who.slice(0, 8));
        require(who.slice(16, 24) == who.slice(0, 8));
        byte[] rs = slotOf(j, slotLen);
        byte[] mv = byte[](moving);
        byte[32] acct = blake2b(p33(fixed) + mv);
        require(blake2b(p33(claimHash(acct, side, t0, a1, a2, amount, bond)) + p33(dkey)) == byte[32](rs.slice(STATE_AT, STATE_AT + 32)));
        // The proof window has passed since the dispute (the claim proves the age this script asks of it).
        require(int(ageb) >= iAt(mv, WINDOW_AT));
        int v = tx.inputs[j].value;
        require(v >= bond + bond);
        becomes(j, rs, slotLen, acct, v - bond - bond);
        // The disputer has its bond back and half of the claimer's, at the mirror of the claim's index; the other half
        // goes to the party the claim was made against, the output before it. A claimer that disputes its own claim
        // to hold the account (no liquidation can reach a claim) therefore pays that party for the time it took.
        int half = bond / 2;
        int m = tx.outputs.length - 1 - 2 * j;
        require(m - 1 >= tx.inputs.length);
        require(tx.outputs[m].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(dkey))));
        require(tx.outputs[m].value >= bond + bond - half);
        pubkey other = pubkey(byte[32](mv.slice(AKEY_AT, AKEY_AT + 32)));
        if (side == SIDE_A) {
            other = pubkey(byte[32](mv.slice(BKEY_AT, BKEY_AT + 32)));
        }
        if (half > 0) {
            require(tx.outputs[m - 1].scriptPubKey == byte[](new ScriptPubKeyP2PK(other)));
            require(tx.outputs[m - 1].value >= half);
        }
        goesOn();
    }
}
