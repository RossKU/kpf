pragma silverscript ^0.1.0;

// T4Declare (probe): the declaration of a declared claim (see T3Claim.sil, of which this is one entry), as a script of its own
// under a library's covenant id: an object (T4Slot) accepts any script that carries the library's id, so it names one
// id and not a list of scripts, and a transaction carries the script of the one operation it performs.
contract T4Declare(int init_version) {
    int version = init_version;

    byte constant SIGHASH_ALL = 0x01;
    int constant SIDE_A = 1;
    int constant SIDE_B = 2;
    int constant BPS = 10000;
    int constant STATE_AT = 2;
    int constant LOCK_TIME_THRESHOLD = 500000000000;
    // Offsets of the values in the moving part.
    int constant AKEY_AT = 1;
    int constant BKEY_AT = 34;
    int constant AMARGIN_AT = 67;
    int constant BMARGIN_AT = 76;
    int constant LATE_AT = 94;
    int constant WINDOW_AT = 103;
    int constant BOND_AT = 112;

    function p33(byte[32] h) : byte[] {
        return byte[](0x20) + byte[](h);
    }

    function i9(int c) : byte[] {
        return byte[](0x08) + byte[](c as byte[8]);
    }

    function iAt(byte[] b, int at) : int {
        return int(byte[8](b.slice(at, at + 8)));
    }

    // The redeem script of the object at input j (its signature script's last push), checked against the input.
    function slotOf(int j, int slotLen) : byte[] {
        require(j >= 0);
        require(j < tx.inputs.length);
        require(j != this.activeInputIndex);
        int len = OpTxInputScriptSigLen(j);
        require(slotLen > STATE_AT + 32);
        require(slotLen <= len);
        byte[] rs = OpTxInputScriptSigSubstr(j, len - slotLen, len);
        require(tx.inputs[j].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        return rs;
    }

    // The claim's state hash: the account it is on and what was declared.
    function claimHash(byte[32] acct, int side, int t0, int a1, int a2, int amount, int bond) : byte[32] {
        return blake2b(p33(acct) + i9(side) + i9(t0) + i9(a1) + i9(a2) + i9(amount) + i9(bond));
    }

    // This script goes on as it is under the library's id, and the transaction writes no other output of that id than
    // the scripts it spends: the library is what its genesis made it.
    function goesOn() {
        int self = this.activeInputIndex;
        byte[32] lib = OpInputCovenantId(self);
        require(tx.outputs[self].scriptPubKey == tx.inputs[self].scriptPubKey);
        require(OpOutputCovenantId(self) == lib);
        require(tx.outputs[self].value >= tx.inputs[self].value);
        require(OpCovOutputCount(lib) == OpCovInputCount(lib));
    }

    entry declare(byte[24] who, byte[8] ageb, int slotLen, byte[32] fixed, byte[138] moving, int side, int t0, int a1, int a2, int amount, sig s) {
        require(version == 1);
        int j = int(byte[8](who.slice(0, 8)));
        // The places this script does not read name the object it does: an object named at a place nobody reads would
        // be spent under no rule.
        require(who.slice(8, 16) == who.slice(0, 8));
        require(who.slice(16, 24) == who.slice(0, 8));
        byte[] rs = slotOf(j, slotLen);
        byte[] mv = byte[](moving);
        byte[32] acct = blake2b(p33(fixed) + mv);
        require(acct == byte[32](rs.slice(STATE_AT, STATE_AT + 32)));
        int pot = iAt(mv, AMARGIN_AT) + iAt(mv, BMARGIN_AT);
        require(amount >= 0);
        require(amount <= pot);
        require(t0 >= 0);
        require(t0 < LOCK_TIME_THRESHOLD);
        require(a1 >= 0);
        require(a2 >= 0);
        pubkey k = pubkey(byte[32](mv.slice(AKEY_AT, AKEY_AT + 32)));
        if (side != SIDE_A) {
            require(side == SIDE_B);
            k = pubkey(byte[32](mv.slice(BKEY_AT, BKEY_AT + 32)));
        }
        byte[] sb = byte[](s);
        require(sb.length == 65);
        require(sb[64] == SIGHASH_ALL);
        require(checkSig(s, k));
        int bond = (pot / BPS) * iAt(mv, BOND_AT) + ((pot % BPS) * iAt(mv, BOND_AT)) / BPS;
        // A claim without a bond could not be disputed: none is made.
        require(bond > 0);
        byte[32] id = OpInputCovenantId(j);
        require(OpCovInputCount(id) == 1);
        require(OpCovOutputCount(id) == 1);
        int c = OpCovOutputIdx(id, 0);
        require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, STATE_AT) + byte[](claimHash(acct, side, t0, a1, a2, amount, bond)) + rs.slice(STATE_AT + 32, slotLen))));
        require(tx.outputs[c].value >= tx.inputs[j].value + bond);
        require(int(ageb) >= 0);
        goesOn();
    }

}
