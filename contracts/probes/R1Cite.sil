pragma silverscript ^0.1.0;

// R1Cite (a research probe, docs/RESEARCH-UNIFIED-MARGIN.md): a script that cites a transaction the chain accepted,
// without spending anything of it. It holds that a version-1 transaction whose first output is under the covenant id
// COV, with a script it is shown, was accepted by the chain block `block`, an ancestor no deeper than the finality
// depth. The proof is recomputed up to the block's sequencing commitment (KIP-21), which the engine gives
// (every H is BLAKE3 keyed with the hasher's name):
//   the transaction's id  = H_v1id(payload digest, H_rest(rest))        rest: the transaction without payload and
//                                                                        signature scripts; output 0 is read in it
//   its activity leaf     = H_leaf(id, version, merge index)
//   the lane's activity   = a Merkle root over the leaves of the lane's transactions the block accepted
//   the lane's tip        = H_tip(parent ref, lane key, activity, context)
//   the lane's leaf       = H_collapsed(lane key, H_active(tip, blue score)), under the lanes' sparse tree
//   the commitment        = H(parent commitment, H(H_activity(inactivity shortcut, lanes' root), payload and context))
// A transaction is in one lane only, so the lane is not asked: that the transaction is under some lane's tip is what
// is cited. An output under a covenant id is written only where an input of that id authorized it (consensus), so the
// output cited is that id's own word.
//   cite(block, rest, nIn, payloadDigest, mergeIdx, actPath, actBits, actLen, parentRef, laneKey, ctx, blueScore,
//        smtPath, smtBits, smtLen, inactivity, payloadCtx, parentSeq, note)
contract R1Cite(byte[32] COV, int init_version) {
    int version = init_version;

    // The first output of a version-1 transaction's rest: after the version (2 bytes), the inputs' count (8) and 52
    // bytes an input (outpoint 36, an empty signature script's length 8, sequence 8), and the outputs' count (8).
    int constant HEAD = 18;
    int constant INPUT = 52;

    entry cite(byte[32] block, byte[] rest, int nIn, byte[32] payloadDigest, int mergeIdx, byte[] actPath, int actBits, int actLen, byte[32] parentRef, byte[32] laneKey, byte[32] ctx, int blueScore, byte[] smtPath, int smtBits, int smtLen, byte[32] inactivity, byte[32] payloadCtx, byte[32] parentSeq, byte[35] note) {
        require(version == 1);
        // The transaction: version 1, nIn inputs; its first output holds anything, under COV, with the script `note`.
        require(nIn >= 1);
        require(rest.slice(0, 2) == byte[](0x0100));
        require(int(byte[8](rest.slice(2, 10))) == nIn);
        int o = HEAD + INPUT * nIn;
        require(int(byte[8](rest.slice(o - 8, o))) >= 1);
        require(rest.slice(o + 8, o + 18) == byte[](0x0000) + byte[](35 as byte[8]));
        require(rest.slice(o + 18, o + 53) == byte[](note));
        require(rest.slice(o + 53, o + 54) == byte[](0x01));
        require(rest.slice(o + 56, o + 88) == byte[](COV));
        byte[32] id = blake3WithKey(byte[](payloadDigest) + byte[](blake3WithKey(rest, byte[32](0x5472616e73616374696f6e526573740000000000000000000000000000000000))), byte[32](0x5472616e73616374696f6e563149640000000000000000000000000000000000));
        // Its leaf among the lane's transactions the block accepted, and the path to their root.
        require(mergeIdx >= 0);
        byte[32] h = blake3WithKey(byte[](id) + byte[](0x0100) + byte[](mergeIdx as byte[4]), byte[32](0x536571436f6d6d697441637469766974794c6561660000000000000000000000));
        require(actLen >= 0);
        require(actLen <= 14);
        require(actPath.length == 32 * actLen);
        byte[32] kb = byte[32](0x536571436f6d6d69746d656e744d65726b6c654272616e636848617368000000);
        int b = actBits;
        for (i, 0, actLen, 14) {
            byte[] s = actPath.slice(32 * i, 32 * i + 32);
            if (b % 2 == 1) {
                h = blake3WithKey(s + byte[](h), kb);
            } else {
                h = blake3WithKey(byte[](h) + s, kb);
            }
            b = b / 2;
        }
        // The lane's tip, its leaf, and the path to the lanes' root.
        require(blueScore >= 0);
        byte[32] tip = blake3WithKey(byte[](parentRef) + byte[](laneKey) + byte[](h) + byte[](ctx), byte[32](0x536571436f6d6d69744c616e6554697000000000000000000000000000000000));
        byte[32] n = blake3WithKey(byte[](laneKey) + byte[](blake3WithKey(byte[](tip) + byte[](blueScore as byte[8]), byte[32](0x536571436f6d6d69744163746976654c65616600000000000000000000000000))), byte[32](0x536571436f6d6d6974416374697665436f6c6c61707365644e6f646500000000));
        require(smtLen >= 0);
        require(smtLen <= 12);
        require(smtPath.length == 32 * smtLen);
        byte[32] kn = byte[32](0x536571436f6d6d69744163746976654e6f646500000000000000000000000000);
        int c = smtBits;
        for (j, 0, smtLen, 12) {
            byte[] t = smtPath.slice(32 * j, 32 * j + 32);
            if (c % 2 == 1) {
                n = blake3WithKey(t + byte[](n), kn);
            } else {
                n = blake3WithKey(byte[](n) + t, kn);
            }
            c = c / 2;
        }
        // Up to the commitment of the block.
        byte[32] st = blake3WithKey(byte[](blake3WithKey(byte[](inactivity) + byte[](n), byte[32](0x536571436f6d6d69744163746976697479526f6f740000000000000000000000))) + byte[](payloadCtx), byte[32](0x536571436f6d6d69746d656e744d65726b6c654272616e636848617368000000));
        require(blake3WithKey(byte[](parentSeq) + byte[](st), byte[32](0x536571436f6d6d69746d656e744d65726b6c654272616e636848617368000000)) == OpChainblockSeqCommit(block));
    }
}
