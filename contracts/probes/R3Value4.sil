pragma silverscript ^0.1.0;

// R3Value (a research probe, docs/RESEARCH-UNIFIED-MARGIN.md): one small script that values an account of many legs,
// for the scripts of operations to rely on by being spent beside it. It is shown the legs and a price for each, and
// holds that what it is told of them is so: A's gain over all legs since their entries, and the maintenance on their
// worth at the prices. An operation's script reads the two numbers and the legs' hash in this input's signature
// script, holds the hash to the account it moves, and does no arithmetic of its own.
//
// A leg is 33 bytes: size (8), scale (8), entry (8), price (8), direction (1: 1 long for A, 2 short). The loop is
// written out by the compiler a leg at most, and its variables are reused, so the stack does not grow with the legs:
// that is the question the probe asks, with the bytes a leg costs.
//   value(legs, n, mmr, gain, maint, legsHash)
contract R3Value4(int init_version) {
    int version = init_version;

    int constant LEG = 33;
    int constant MAX = 4;
    int constant BPS = 10000;

    entry value(byte[] legs, int n, int mmr, int gain, int maint, byte[32] legsHash) {
        require(version == 1);
        require(n >= 1);
        require(n <= MAX);
        require(legs.length == LEG * n);
        require(blake2b(legs) == legsHash);
        require(mmr >= 0);
        int g = 0;
        int w = 0;
        for (i, 0, n, 4) {
            int size = int(byte[8](legs.slice(LEG * i, LEG * i + 8)));
            int scale = int(byte[8](legs.slice(LEG * i + 8, LEG * i + 16)));
            int strike = int(byte[8](legs.slice(LEG * i + 16, LEG * i + 24)));
            int price = int(byte[8](legs.slice(LEG * i + 24, LEG * i + 32)));
            require(size > 0);
            require(scale > 0);
            require(strike >= 0);
            require(price >= 0);
            // floor(size x / scale), written so that it does not overflow: (size / scale) x + (size % scale) x / scale.
            int worthNow = (size / scale) * price + (size % scale) * (price / scale) + ((size % scale) * (price % scale)) / scale;
            int worthThen = (size / scale) * strike + (size % scale) * (strike / scale) + ((size % scale) * (strike % scale)) / scale;
            if (legs.slice(LEG * i + 32, LEG * i + 33) == byte[](0x01)) {
                g = g + worthNow - worthThen;
            } else {
                require(legs.slice(LEG * i + 32, LEG * i + 33) == byte[](0x02));
                g = g - worthNow + worthThen;
            }
            w = w + worthNow;
        }
        require(g == gain);
        require((w / BPS) * mmr + ((w % BPS) * mmr + BPS - 1) / BPS == maint);
    }
}
