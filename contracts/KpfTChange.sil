pragma silverscript ^0.1.0;

// KpfTChange: a change of a position is stated (docs/ARCHITECTURE-CLEARING.md, 4). Whoever states it says what the
// position becomes (`outs`: up to four outputs, the first the position as it goes on or a payment, the others
// payments) and why (`kind`, and `said`: what that kind states, with the prices it is stated at), and adds a bond.
// Both are shown as they are, so that whoever watches reads them; the object keeps their hashes. Nothing is computed
// here: a statement that is not the rule's is disputed and loses its bond
// (KpfTChangeDispute, then the kind's answer, KpfTTake for kind 1), one nobody disputes within the position's dispute
// period is applied (KpfTChangeSettle), and one that lands outside the position's lateness of its time ends
// (KpfTChangeLate).
//   state(who, ageb, slotLen, fixed, moving, kind, t0, said, outs, claimer, form, s)    the claimer signs.
//   form: nothing for kind 1; for kinds 2 and 3 the account's terms and the root of its legs (122 bytes).
contract KpfTChange(int init_version) {
    int version = init_version;

    // What every operation leaves in the copy it used, for whoever the prices are from (KpfTSweep, KpfTPay).
    int constant ORACLE_FEE = 200000;
    int constant STATE_AT = 2;
    int constant CHANGE_TAG = 10;

    function p33(byte[32] h) : byte[] {
        return byte[](0x20) + byte[](h);
    }

    function i9(int c) : byte[] {
        return byte[](0x08) + byte[](c as byte[8]);
    }

    // The object named at place 0 of `who` (and at the other two places): its script, shown at the end of its
    // signature script.
    function slotOf(int j, int slotLen) : byte[] {
        require(j >= 0);
        require(j < tx.inputs.length);
        require(j != this.activeInputIndex);
        int len = OpTxInputScriptSigLen(j);
        require(slotLen > STATE_AT + 32);
        require(slotLen <= len);
        byte[] rs = OpTxInputScriptSigSubstr(j, len - slotLen, len);
        require(tx.inputs[j].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        return rs;
    }

    // A stated change: the position it is of, its kind, the time its statement prices at, the hash of what the kind
    // states, the hash of what the position becomes, the bond, who stated it, and the position's dispute period and
    // lateness as they were (so that no later script is shown the position), and what the object held when it was
    // stated (an answer counts from that: what the object holds since is anybody's to add to).
    function changeHash(byte[32] position, int kind, int t0, byte[32] arg, byte[32] outs, int bond, byte[32] claimer, int window, int late, int held) : byte[32] {
        return blake2b(i9(CHANGE_TAG) + p33(position) + i9(kind) + i9(t0) + p33(arg) + p33(outs) + i9(bond) + p33(claimer) + i9(window) + i9(late) + i9(held));
    }

    // The single output of the object's id: its own script with another state's hash, holding at least v.
    function becomes(int j, byte[] rs, int slotLen, byte[32] h, int v) {
        byte[32] id = OpInputCovenantId(j);
        require(OpCovInputCount(id) == 1);
        require(OpCovOutputCount(id) == 1);
        int c = OpCovOutputIdx(id, 0);
        require(tx.outputs[c].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs.slice(0, STATE_AT) + byte[](h) + rs.slice(STATE_AT + 32, slotLen))));
        require(tx.outputs[c].value >= v);
    }

    function goesOn() {
        int self = this.activeInputIndex;
        byte[32] lib = OpInputCovenantId(self);
        require(tx.outputs[self].scriptPubKey == tx.inputs[self].scriptPubKey);
        require(OpOutputCovenantId(self) == lib);
        require(tx.outputs[self].value >= tx.inputs[self].value + ORACLE_FEE);
        require(OpCovOutputCount(lib) == OpCovInputCount(lib));
    }

    byte constant SIGHASH_ALL = 0x01;
    int constant BPS = 10000;
    int constant LOCK_TIME_THRESHOLD = 500000000000;
    int constant AMARGIN_AT = 67;
    int constant BMARGIN_AT = 76;
    int constant LATE_AT = 94;
    int constant DISPUTE_AT = 103;
    int constant BOND_AT = 112;
    // The kinds a statement can be of: each has scripts that answer its dispute. 1: a take on a position (KpfTTake).
    // 2: a take on an account of any number of legs, answered a point at a time (KpfTPoint, KpfTStepRow,
    // KpfTStepPrice, KpfTStepEnd). 3: a step of a liquidation of an account; 4: a leg that leaves an account by
    // its party's own statement (the same, and KpfTStepLiq). 5: a draw from a shard by its owner (KpfTShardEnd,
    // KpfTShardPrice, KpfTDrawNote).
    // 7 to 9: a covered account's own (a take, a leaving, a step of a liquidation: KpfTCRow, KpfTCEnd). Kind 10, a
    // leg that enters a covered account, is stated by KpfTEnterS alone; kind 6 is no kind any more.
    int constant KINDS = 9;
    // A call (kind 11) is stated on a shard by anyone: its bond is the shard's, no more than a hundred times the
    // terms' least fee of a keeper, and no less than a note's least (a shard that holds nothing is called still).
    int constant CALL_FEE_AT = 37;
    int constant CALL_BOND_MIN = 20000000;
    // A draw's bond is a KAS at the least: what a round of a draw that is not the rule's costs its owner is half
    // of it, and no age holds a draw (a third party makes a shard's output young at will). Review 56, F101.
    int constant DRAW_BOND_MIN = 100000000;

    function iAt(byte[] b, int at) : int {
        return int(byte[8](b.slice(at, at + 8)));
    }

    entry state(byte[24] who, byte[8] ageb, int slotLen, byte[32] fixed, byte[] moving, int kind, int t0, byte[] said, byte[] outs, byte[32] claimer, byte[] form, sig s) {
        require(version == 1);
        int j = int(byte[8](who.slice(0, 8)));
        require(who.slice(8, 16) == who.slice(0, 8));
        require(who.slice(16, 24) == who.slice(0, 8));
        byte[] rs = slotOf(j, slotLen);
        byte[] mv = moving;
        // A position's moving part, or a covered account's (the same, then the push of its shard's id).
        require(mv.length == 138 || mv.length == 171);
        byte[32] position = blake2b(p33(fixed) + mv);
        require(position == byte[32](rs.slice(STATE_AT, STATE_AT + 32)));
        require(kind >= 1);
        require(kind <= KINDS || kind == 11);
        // A kind is stated on the object it is of: kinds 2 and 3 on an account, shown by its terms and the root of its
        // legs (a kind nobody could answer there would lock the object for nothing). Kind 1 on an account is ended
        // by KpfTKind.
        if (kind >= 2) {
            require(form.length == 122);
            require(blake2b(form.slice(0, 90) + byte[](0x20) + form.slice(90, 122)) == fixed);
        } else {
            require(form.length == 0);
        }
        require(t0 >= 0);
        require(t0 < LOCK_TIME_THRESHOLD);
        byte[] sb = byte[](s);
        require(sb.length == 65);
        require(sb[64] == SIGHASH_ALL);
        require(checkSig(s, pubkey(claimer)));
        // (A lateness of the mark of a statement that stands again, or more, is no lateness: a statement with one
        // would be read as standing again and applied at once. Review 50, F79.)
        require(iAt(mv, LATE_AT) >= 0);
        require(iAt(mv, LATE_AT) < 499999999999);
        int pot = iAt(mv, AMARGIN_AT) + iAt(mv, BMARGIN_AT);
        int bond = (pot / BPS) * iAt(mv, BOND_AT) + ((pot % BPS) * iAt(mv, BOND_AT)) / BPS;
        if (kind == 11) {
            // (The cap where it is a number: terms of a fee beyond anything cap nothing. Review 54, F91.)
            if (iAt(form, CALL_FEE_AT) <= 92233720368547758) {
                int cap = 100 * iAt(form, CALL_FEE_AT);
                if (bond > cap) { bond = cap; }
            }
        }
        // (Where no age can be asked the bond is the price. A statement that is not the rule's, disputed and
        // answered wrong by its maker's other key, gives the object back for half a bond, and keeps it from
        // everybody meanwhile: a draw has a bond of a KAS at the least, a call and a covered account's
        // statements of a note's least. Reviews 54 and 56: F88, F100, F101. And half of such a bond is an
        // amount a transaction pays: F102.)
        if (kind == 5) {
            if (bond < DRAW_BOND_MIN) { bond = DRAW_BOND_MIN; }
        }
        if (kind == 11 || (kind >= 7 && kind <= 9)) {
            if (bond < CALL_BOND_MIN) { bond = CALL_BOND_MIN; }
        }
        require(bond > 0);
        // What is stated and what the position becomes are shown as they are and hashed here: whoever watches reads
        // them on the chain (a statement that could not be checked could only be disputed blind). What is stated has
        // its kind's length, so that the kind's answer can open it: four numbers for a take on a position (which a
        // covered account is not); three numbers, 92 bytes of the leg that leaves and rows of 112 bytes on an account.
        // A shard is the object of 171 bytes with no second key: it takes a draw, and no other kind (a take or a
        // leg's leaving stated on one would have an end and no row anybody could open).
        int shard = 0;
        if (mv.length == 171) {
            if (mv.slice(34, 66) == byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8])) { shard = 1; }
        }
        if (kind == 1) {
            require(said.length == 32);
            require(mv.length == 138);
        } else {
            if (kind == 5 || kind == 11) {
                // An amount and a price a row; a call says nothing where a draw says its amount.
                require(said.length == 40);
                require(shard == 1);
            } else {
                // (A covered account's own kinds say two numbers and a chain before their rows.)
                int at0 = 116;
                if (kind >= 6) {
                    require(kind >= 7);
                    require(mv.length == 171);
                    at0 = 48;
                }
                require(said.length >= at0);
                require((said.length - at0) % 112 == 0);
                require(shard == 0);
                // (Kinds 2 to 4 are of an account no shard covers: a covered account has its own, 7 to 9.)
                if (kind <= 4) {
                    require(mv.length == 138);
                }
                // The market of the leg that leaves is written as a market is (two pushes of 32 bytes, two of 8):
                // whoever watches reads every statement that is stated, and a tool that could not read one could
                // not answer it.
                if (kind <= 4) {
                    require(said.slice(24, 25) == byte[](0x20));
                    require(said.slice(57, 58) == byte[](0x20));
                    require(said.slice(90, 91) == byte[](0x08));
                    require(said.slice(99, 100) == byte[](0x08));
                }
            }
        }
        require(outs.length >= 41);
        require(outs.length <= 164);
        require(outs.length % 41 == 0);
        // Their flags are those the settlement knows: the first the object as it goes on (0) or a payment (1), the
        // others payments (1) or notes to a shard (2: objects under the same id). (A flag the settlement took for a payment and no reader knew was a statement nobody saw.)
        require(outs.slice(0, 1) == byte[](0x00) || outs.slice(0, 1) == byte[](0x01));
        for (i, 1, outs.length / 41, 3) {
            require(outs.slice(41 * i, 41 * i + 1) == byte[](0x01) || outs.slice(41 * i, 41 * i + 1) == byte[](0x02));
        }
        becomes(j, rs, slotLen, changeHash(position, kind, t0, blake2b(said), blake2b(outs), bond, claimer, iAt(mv, DISPUTE_AT), iAt(mv, LATE_AT), tx.inputs[j].value), tx.inputs[j].value + bond);
        require(int(ageb) >= 0);
        goesOn();
    }

    // The copy lets go of what gathered in it: a script of the library names it at a place, as an object is named
    // (KpfSlot.go asks no more), and answers for the rest. Only KpfTSweep's entry passes with a copy at a place it
    // names (every other entry holds what it names to the hash of an object's state), and it asks that the copy goes
    // on as it is, under the library's id, with what a copy keeps.
    entry release(int l, int k) {
        int self = this.activeInputIndex;
        require(k >= 0);
        require(k <= 2);
        // (An input that is not there has no id: the engine refuses the index.)
        require(OpInputCovenantId(l) == OpInputCovenantId(self));
        require(OpTxInputScriptSigSubstr(l, 0, 1) == byte[](0x18));
        require(OpTxInputScriptSigSubstr(l, 1 + 8 * k, 9 + 8 * k) == byte[](self as byte[8]));
    }
}
